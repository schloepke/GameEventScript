<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <AssemblyName>GameEventScript.Conformance</AssemblyName>
        <RootNamespace>GameEventScript.Conformance</RootNamespace>
        <PackageId>GameEventScript.Conformance</PackageId>
        <Version>0.1.0</Version>
        <Authors>Stephan Schlöpke</Authors>
        <Copyright>Copyright 2026 Stephan Schlöpke</Copyright>
        <Description>Portable Markdown parser, runner, and report writers for the Game Event Script conformance corpus.</Description>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/schloepke/GameEventScript</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <LangVersion>12</LangVersion>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <WarningsAsErrors>$(WarningsAsErrors);CS0419;CS1570;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1587;CS1591;CS1658;CS1711;CS1712</WarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../GameEventScript.Runtime/GameEventScript.Runtime.csproj" />
        <ProjectReference Include="../GameEventScript.Compiler/GameEventScript.Compiler.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../../../../LICENSE" Link="LICENSE" Pack="true" PackagePath="/" />
        <None Include="../../../../README.md" Link="README.md" Pack="true" PackagePath="/" />
    </ItemGroup>
</Project>
