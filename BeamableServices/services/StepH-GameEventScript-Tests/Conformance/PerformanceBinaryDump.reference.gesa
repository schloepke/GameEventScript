//
//  Disassembled at <stable>
// -------------------------------------------------------------------------------
// Script:
//
//		module PerformanceTypes
//		
//		record :sample as {
//		  _ value: :number,
//		  label: :text,
//		  doubled: :number computed by value * 2
//		}
//		
//		on Start {
//		  let rec be :sample(21, label: 'ok')
//		  let textNumber be '42' as :number
//		  emit Done(doubled: rec.doubled, label: rec.label, textNumber: textNumber, isSample: rec is :sample)
//		}
//		
//
// -------------------------------------------------------------------------------

.gesb 1
.module "PerformanceTypes"
.flags optimization


.segment text

T_sample:			.text "sample"
T_value:			.text "value"
T_number:			.text "number"
T_label:			.text "label"
T_text:				.text "text"
T_doubled:			.text "doubled"
T_Start:			.text "Start"
T_aim:				.text "aim"
T_bearing:			.text "bearing"
T_degree:			.text "degree"
T_range:			.text "range"
T_meter:			.text "meter"
T_steps:			.text "steps"
T_direction:		.text "direction"
T_vector:			.text "vector"
T_checksum:			.text "checksum"
T_rec:				.text "rec"
T_17:				.text "_"
T_ok:				.text "ok"
T_textNumber:		.text "textNumber"
T_Done:				.text "Done"
T_isSample:			.text "isSample"
T___type:			.text "__type"


.segment lists

U16_0:				.u16 []
Args_1:				.registers [r2, r3, r1, r4]
Keys_2:				.texts [T_value, T_label, T_doubled, T___type] // "value", "label", "doubled", "__type"


.segment bind

Handler_Start:		.bind MessageHandler id=0 name=T_Start args=[] entry=Start // "Start()"
Outbound_Done:		.bind OutboundMessage id=0 name=T_Done args=[T_doubled, T_label, T_textNumber, T_isSample] // "Done(doubled, label, textNumber, isSample)"
Record_sample:		.bind Record id=0 name=T_sample args=[T_17, T_label] entry=record_sample // "sample(_, label)"


.segment code

Start:				 // handler Start()
					SlotLocals #5
					StageInteger #21
					StageText T_ok // "ok"
					CreateRecord r2, Record_sample // "sample(_, label)"
					Move r0, r2
					LoadInteger r1, #42
					MemberAccess r2, T_doubled, r0 // "doubled"
					MemberAccess r3, T_label, r0 // "label"
					CheckCustomType r4, r0, T_sample // "sample"
					EmitMessage Outbound_Done, Args_1 // "Done(doubled, label, textNumber, isSample)"
					ReturnVoid

record_sample:		 // record sample(_, label)
					SlotLocals #5
					CastNumeric r0, r0
					Cast r1, r1, Text
					LoadInteger r3, #2
					Multiply r4, r0, r3
					CastNumeric r2, r4
					StageRegister r0
					StageRegister r1
					StageRegister r2
					StageTag T_sample // "sample"
					CreateMap r5, Keys_2 // "value", "label", "doubled", "__type"
					CastCustom r6, r5, T_sample // "sample"
					ReturnValue r6


