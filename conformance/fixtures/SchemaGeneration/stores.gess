// The fixture of the checked-in store code: two store handle types whose states are model roots, one of which names
// the other, and two projections of the unit, one of the other. Both stores are read from root handles of the repository
// type, which has no state.
handle @Repository with id :Text max 64 versioned by hash(#sha1)

model(store) schema :Hull as { name: :Text max 32, armor: :Number integer between 0 and 1000 }
handle @Hull of :Hull with id :Text max 64 versioned by hash(#ges)

schema :Look as { icon: :Text max 16 }

model(store) schema :Unit as {
  name: :Text max 32
  hull: @Hull~
  escorts: :List(@Unit) max 4
  speed: :Quantity(m/s) between 0m/s and 400m/s
  look: :Look optional
}
handle @Unit of :Unit with id :Text max 64 versioned by hash(#ges)

model(store) projection :UnitDisplay of :Unit as { name, hull, icon: look.icon }
model(store) projection :UnitLabel of :UnitDisplay as { name }
