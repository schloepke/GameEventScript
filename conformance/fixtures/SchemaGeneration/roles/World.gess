// The wire roots of the group world. Panel_Badge is a wire root of the group panels and a part here.
parameter worldWidth: :Quantity(m)

wire(world) schema :World as {
  tick: :Number integer between 0 and 1000000
  arena: :Vector(m) { x between 0m and worldWidth step 1m, y between 0m and worldWidth step 1m }
  bots: :List(:World_Bot) max 8
  badge: :Panel_Badge optional
}

wire(world) schema :World_Cards as {
  cards: :List(:Panel_Badge) max 4
}

schema :World_Bot as {
  id: :Number integer between 0 and 255 key
  position: :Point(m) { x between 0m and worldWidth step 1cm, y between 0m and worldWidth step 1cm }
  velocity: :Vector(m) { x between -100m and 100m step 1cm, y between -100m and 100m step 1cm, z between -100m and 100m step 1cm }
  body: :World_Body
}

// Reached from the wire root World and from the model root WorldView.
schema :World_Body as {
  mass: :Quantity(kg) between 0kg and 1000kg step 1kg
  hull: :Tag(#light, #heavy)
}
