<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <AssemblyName>StepH.GameEventScript.PackageConsumer</AssemblyName>
        <RootNamespace>StepH.GameEventScript.PackageConsumer</RootNamespace>
        <LangVersion>12</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <GesPackageVersion Condition="'$(GesPackageVersion)' == ''">0.1.0</GesPackageVersion>
        <GesPackageSource Condition="'$(GesPackageSource)' == ''">$(MSBuildProjectDirectory)/../../../../artifacts/csharp/packages</GesPackageSource>
        <GesUnityDllDirectory Condition="'$(GesUnityDllDirectory)' == ''">$(MSBuildProjectDirectory)/../../../../artifacts/csharp/dll/0.1.0/unity</GesUnityDllDirectory>
        <RestoreSources>$(GesPackageSource);https://api.nuget.org/v3/index.json</RestoreSources>
    </PropertyGroup>

    <PropertyGroup Condition="'$(GesUseUnityDlls)' == 'true'">
        <DefineConstants>$(DefineConstants);UNITY_DLL_SMOKE</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="'$(GesUseUnityDlls)' != 'true'">
        <PackageReference Include="StepH.GameEventScript" Version="$(GesPackageVersion)" />
        <PackageReference Include="StepH.GameEventScript.CSharpBridge" Version="$(GesPackageVersion)" />
        <PackageReference Include="StepH.GameEventScript.Conformance" Version="$(GesPackageVersion)" />
    </ItemGroup>

    <ItemGroup Condition="'$(GesUseUnityDlls)' == 'true'">
        <Reference Include="StepH.GameEventScript" HintPath="$(GesUnityDllDirectory)/StepH.GameEventScript.dll" Private="true" />
        <Reference Include="StepH.GameEventScript.CSharpBridge" HintPath="$(GesUnityDllDirectory)/StepH.GameEventScript.CSharpBridge.dll" Private="true" />
    </ItemGroup>
</Project>
