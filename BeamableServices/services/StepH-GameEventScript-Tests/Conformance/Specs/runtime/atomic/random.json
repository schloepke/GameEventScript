{
  "version": 1,
  "name": "RuntimeAtomicRandom",
  "level": "atomic",
  "tests": [
    {
      "kind": "scriptApi",
      "name": "random take integer and float opcode paths",
      "script": "module AtomicRandomTakeOpcodes\non Start {\n  let integerValue be :random from 1 to 6\n  let floatValue be :random from 0.0 to 1.0\n  let mixedValue be :random from 1 to 2.0\n  let nothingValue be :random from missing to 6\n  emit Done(integerValue: integerValue, floatValue: floatValue, mixedValue: mixedValue, nothingValue: nothingValue)\n}",
      "randomSequence": [
        "4",
        "0.25",
        "1.5"
      ],
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "floatValue": {
                  "type": ":float",
                  "value": "0.25"
                },
                "integerValue": {
                  "type": ":integer",
                  "value": "4"
                },
                "mixedValue": {
                  "type": ":float",
                  "value": "1.5"
                },
                "nothingValue": {
                  "type": ":nothing"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
