{
  "version": 1,
  "name": "RuntimePredicatesFunctions",
  "tests": [
    {
      "kind": "scriptApi",
      "name": "predicates and functions are reusable in expressions and collections",
      "script": "predicate wounded(_ unit) means unit.hp < unit.maxHp\nfunction woundedUnits(_ units) means units[:filter unit where unit is wounded]\n\non Start(unit, units) {\n  let byCall be wounded(unit)\n  let byPredicate be unit is wounded\n  let woundedList be woundedUnits(units)\n  emit Done(byCall: byCall, byPredicate: byPredicate, woundedCount: :len woundedList, first: woundedList[1].name, second: woundedList[2].name)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {
              "unit": {
                "type": ":dictionary",
                "entries": {
                  "name": { "type": ":text", "value": "Ada" },
                  "hp": { "type": ":integer", "value": "2" },
                  "maxHp": { "type": ":integer", "value": "5" }
                }
              },
              "units": {
                "type": ":list",
                "items": [
                  {
                    "type": ":dictionary",
                    "entries": {
                      "name": { "type": ":text", "value": "Ada" },
                      "hp": { "type": ":integer", "value": "2" },
                      "maxHp": { "type": ":integer", "value": "5" }
                    }
                  },
                  {
                    "type": ":dictionary",
                    "entries": {
                      "name": { "type": ":text", "value": "Bert" },
                      "hp": { "type": ":integer", "value": "4" },
                      "maxHp": { "type": ":integer", "value": "4" }
                    }
                  },
                  {
                    "type": ":dictionary",
                    "entries": {
                      "name": { "type": ":text", "value": "Cara" },
                      "hp": { "type": ":integer", "value": "1" },
                      "maxHp": { "type": ":integer", "value": "3" }
                    }
                  }
                ]
              }
            }
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "byCall": { "type": ":boolean", "value": true },
                "byPredicate": { "type": ":boolean", "value": true },
                "woundedCount": { "type": ":integer", "value": "2" },
                "first": { "type": ":text", "value": "Ada" },
                "second": { "type": ":text", "value": "Cara" }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "predicates and functions are lenient when expected keys are missing",
      "script": "predicate wounded(_ unit) means unit.hp < unit.maxHp\nfunction woundedUnits(_ units) means units[:filter unit where unit is wounded]\n\non Start(unit, units) {\n  let byCall be wounded(unit)\n  let byPredicate be unit is wounded\n  let woundedList be woundedUnits(units)\n  emit Done(byCall: byCall, byPredicate: byPredicate, woundedCount: :len woundedList)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {
              "unit": {
                "type": ":dictionary",
                "entries": {
                  "name": { "type": ":text", "value": "NoHp" }
                }
              },
              "units": {
                "type": ":list",
                "items": [
                  {
                    "type": ":dictionary",
                    "entries": {
                      "name": { "type": ":text", "value": "NoHp" }
                    }
                  },
                  {
                    "type": ":dictionary",
                    "entries": {
                      "name": { "type": ":text", "value": "Healthy" },
                      "hp": { "type": ":integer", "value": "5" },
                      "maxHp": { "type": ":integer", "value": "5" }
                    }
                  }
                ]
              }
            }
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "byCall": { "type": ":nothing" },
                "byPredicate": { "type": ":nothing" },
                "woundedCount": { "type": ":integer", "value": "0" }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "predicates accept typed boolean record fields",
      "script": "record :unit as {\n  alive: :boolean,\n  hidden: :boolean\n}\n\npredicate targetable(_ unit as :unit) means unit.alive and not unit.hidden\n\non Start(unit) {\n  emit Done(targetable: unit is targetable)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {
              "unit": {
                "type": ":dictionary",
                "entries": {
                  "alive": { "type": ":boolean", "value": true },
                  "hidden": { "type": ":boolean", "value": false }
                }
              }
            }
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "targetable": { "type": ":boolean", "value": true }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "predicates allow explicit boolean coercion while functions keep original value",
      "script": "predicate numeric(_ value) means value * 2 as :boolean\nfunction numericSelect(_ value) means value * 2\n\non Start {\n  let byPredicateCallTwo be numeric(2)\n  let byPredicateCallZero be numeric(0)\n  let byFunction be numericSelect(2)\n  let byPredicateOperator be 2 is numeric\n  emit Done(byPredicateCallTwo: byPredicateCallTwo, byPredicateCallZero: byPredicateCallZero, byFunction: byFunction, byPredicateOperator: byPredicateOperator)\n}",
      "steps": [
        {
          "input": { "name": "Start", "args": {} },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "byPredicateCallTwo": { "type": ":boolean", "value": true },
                "byPredicateCallZero": { "type": ":boolean", "value": false },
                "byFunction": { "type": ":integer", "value": "4" },
                "byPredicateOperator": { "type": ":boolean", "value": true }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "multi argument predicates can be called directly",
      "script": "predicate higher(left, right) means left > right\n\non Start(left, right) {\n  emit Done(ok: higher(left: left, right: right), reversed: higher(left: right, right: left))\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {
              "left": { "type": ":integer", "value": "7" },
              "right": { "type": ":integer", "value": "4" }
            }
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "ok": { "type": ":boolean", "value": true },
                "reversed": { "type": ":boolean", "value": false }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "typed handler callable and record parameters coerce inputs",
      "script": "record :gauge as {\n  current: :integer\n}\n\npredicate high(value as :integer) means value > 2\nfunction boosted(_ value as :integer) means value + 1\n\non Start(value as :integer, hp as :gauge) {\n  emit Done(handlerValue: value + 1, ok: value is high, boosted: boosted(value), current: hp.current)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {
              "value": { "type": ":float", "value": "2" },
              "hp": {
                "type": ":dictionary",
                "entries": {
                  "current": { "type": ":float", "value": "4" }
                }
              }
            }
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "handlerValue": { "type": ":integer", "value": "3" },
                "ok": { "type": ":boolean", "value": false },
                "boosted": { "type": ":integer", "value": "3" },
                "current": { "type": ":integer", "value": "4" }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "multiple modules share predicate function and type definitions",
      "scripts": [
        {
          "sourceName": "shared.es",
          "text": "module Shared\nrecord :gauge as {\n  current: :float,\n  maximum: :float\n}\n\npredicate wounded(_ unit) means unit.hp < unit.maxHp\nfunction woundedUnits(_ units) means units[:filter unit where unit is wounded]"
        },
        {
          "sourceName": "runtime.es",
          "text": "module Runtime\non Start(unit, units) {\n  let hp as :gauge be [current: unit.hp, maximum: unit.maxHp]\n  let anyWounded be wounded(unit)\n  let candidates be woundedUnits(units)\n  emit Done(anyWounded: anyWounded, candidateCount: :len candidates, maximum: hp.maximum)\n}"
        }
      ],
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {
              "unit": {
                "type": ":dictionary",
                "entries": {
                  "hp": { "type": ":integer", "value": "2" },
                  "maxHp": { "type": ":integer", "value": "5" }
                }
              },
              "units": {
                "type": ":list",
                "items": [
                  {
                    "type": ":dictionary",
                    "entries": {
                      "hp": { "type": ":integer", "value": "2" },
                      "maxHp": { "type": ":integer", "value": "5" }
                    }
                  },
                  {
                    "type": ":dictionary",
                    "entries": {
                      "hp": { "type": ":integer", "value": "5" },
                      "maxHp": { "type": ":integer", "value": "5" }
                    }
                  }
                ]
              }
            }
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "anyWounded": { "type": ":boolean", "value": true },
                "candidateCount": { "type": ":integer", "value": "1" },
                "maximum": { "type": ":float", "value": "5" }
              }
            }
          ]
        }
      ]
    }
  ]
}
