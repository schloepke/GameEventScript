tNetworkSockets/GesNetworkSocketSession":{"abstract":[{"type":"text","text":"Carries one "},{"type":"codeVoice","code":"GesNetworkConnection"},{"type":"text","text":" over a TCP stream, a WebSocket or UDP. SwiftNIO event loops only move bytes: the"},{"type":"text","text":" "},{"type":"text","text":"host calls "},{"type":"codeVoice","code":"receive(now:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"transmit()"},{"type":"text","text":", or "},{"type":"codeVoice","code":"update(now:)"},{"type":"text","text":" for both, on its own task or thread, which feeds"},{"type":"text","text":" "},{"type":"text","text":"received bytes into the connection, advances it and hands its packets to the socket. The connection is touched only"},{"type":"text","text":" "},{"type":"text","text":"by the host. As a "},{"type":"codeVoice","code":"GesNetworkLink"},{"type":"text","text":" it is the transport of an end."}],"type":"topic","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"GesNetworkSocketSession"}],"kind":"symbol","url":"\/documentation\/gameeventscriptnetworksockets\/gesnetworksocketsession","title":"GesNetworkSocketSession","identifier":"doc:\/\/org.gameeventscript.GameEventScriptNetworkSockets\/documentation\/GameEventScriptNetworkSockets\/GesNetworkSocketSession","navigatorTitle":[{"kind":"identifier","text":"GesNetworkSocketSession"}]}}}