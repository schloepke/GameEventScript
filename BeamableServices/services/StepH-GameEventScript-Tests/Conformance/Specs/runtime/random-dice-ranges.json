                        "value": true
                      }
                    }
                  },
                  {
                    "type": ":dictionary",
                    "entries": {
                      "name": {
                        "type": ":text",
                        "value": "Mage"
                      },
                      "alive": {
                        "type": ":boolean",
                        "value": true
                      }
                    }
                  },
                  {
                    "type": ":dictionary",
                    "entries": {
                      "name": {
                        "type": ":text",
