{
  "version": 1,
  "name": "RuntimeMessagesHandlers",
  "tests": [
    {
      "kind": "scriptApi",
      "name": "handler binding creates message values and publishable calls",
      "binaryRoundTrip": true,
      "script": "module MessageBinding\non Start(unit, target) {\n  let shoot as :handler be Shoot(unit, target)\n  let msg as :message be shoot(unit: unit, target: target)\n  let isHandler be shoot is :handler\n  let isMessage be msg is :message\n  emit msg\n  emit shoot(unit: unit, target: target)\n  emit Shoot(unit: unit, target: target)\n  emit Done(isHandler: isHandler, isMessage: isMessage)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": [
              {
                "name": "unit",
                "value": {
                  "type": ":text",
                  "value": "u_1"
                }
              },
              {
                "name": "target",
                "value": {
                  "type": ":text",
                  "value": "t_1"
                }
              }
            ]
          },
          "expectedPublished": [
            {
              "name": "Shoot",
              "args": [
                {
                  "name": "unit",
                  "value": {
                    "type": ":text",
                    "value": "u_1"
                  }
                },
                {
                  "name": "target",
                  "value": {
                    "type": ":text",
                    "value": "t_1"
                  }
                }
              ]
            },
            {
              "name": "Shoot",
              "args": [
                {
                  "name": "unit",
                  "value": {
                    "type": ":text",
                    "value": "u_1"
                  }
                },
                {
                  "name": "target",
                  "value": {
                    "type": ":text",
                    "value": "t_1"
                  }
                }
              ]
            },
            {
              "name": "Shoot",
              "args": [
                {
                  "name": "unit",
                  "value": {
                    "type": ":text",
                    "value": "u_1"
                  }
                },
                {
                  "name": "target",
                  "value": {
                    "type": ":text",
                    "value": "t_1"
                  }
                }
              ]
            },
            {
              "name": "Done",
              "args": [
                {
                  "name": "isHandler",
                  "value": {
                    "type": ":boolean",
                    "value": true
                  }
                },
                {
                  "name": "isMessage",
                  "value": {
                    "type": ":boolean",
                    "value": true
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "direct message literal creates first class message value",
      "script": "module DirectMessageLiteral\non Start(value) {\n  let scaled be value * 2\n  let myMessageDirect be Success(message: 'world', value: scaled)\n  emit Done(isMessage: myMessageDirect is :message, name: myMessageDirect.name, signature: myMessageDirect.signature, text: myMessageDirect.arguments.message, value: myMessageDirect.arguments.value)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": [
              {
                "name": "value",
                "value": {
                  "type": ":integer",
                  "value": "21"
                }
              }
            ]
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": [
                {
                  "name": "isMessage",
                  "value": {
                    "type": ":boolean",
                    "value": true
                  }
                },
                {
                  "name": "name",
                  "value": {
                    "type": ":text",
                    "value": "Success"
                  }
                },
                {
                  "name": "signature",
                  "value": {
                    "type": ":text",
                    "value": "Success(message,value)"
                  }
                },
                {
                  "name": "text",
                  "value": {
                    "type": ":text",
                    "value": "world"
                  }
                },
                {
                  "name": "value",
                  "value": {
                    "type": ":integer",
                    "value": "42"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "empty uppercase invocation creates handler value",
      "script": "on Start {\n  let handler as :handler be Shoot()\n  emit Done(name: handler.name, parameterCount: handler.parameters[:count])\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": []
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": [
                {
                  "name": "name",
                  "value": {
                    "type": ":text",
                    "value": "Shoot"
                  }
                },
                {
                  "name": "parameterCount",
                  "value": {
                    "type": ":integer",
                    "value": "0"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "untyped handler literal and bind create first class values",
      "script": "module UntypedHandlerBinding\non Start(success) {\n  let myHandler be Success(message, value)\n  let myMessage be myHandler(message: 'hello', value: success)\n  let invalidMessage be myHandler(message: 'hello', other: success)\n  emit Done(handlerIsHandler: myHandler is :handler, handlerName: myHandler.name, handlerSignature: myHandler.signature, secondParameter: myHandler.parameters[2], messageIsMessage: myMessage is :message, messageName: myMessage.name, messageSignature: myMessage.signature, text: myMessage.arguments.message, value: myMessage.arguments.value, invalidIsNothing: invalidMessage is nothing)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": [
              {
                "name": "success",
                "value": {
                  "type": ":boolean",
                  "value": true
                }
              }
            ]
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": [
                {
                  "name": "handlerIsHandler",
                  "value": {
                    "type": ":boolean",
                    "value": true
                  }
                },
                {
                  "name": "handlerName",
                  "value": {
                    "type": ":text",
                    "value": "Success"
                  }
                },
                {
                  "name": "handlerSignature",
                  "value": {
                    "type": ":text",
                    "value": "Success(message,value)"
                  }
                },
                {
                  "name": "secondParameter",
                  "value": {
                    "type": ":text",
                    "value": "value"
                  }
                },
                {
                  "name": "messageIsMessage",
                  "value": {
                    "type": ":boolean",
                    "value": true
                  }
                },
                {
                  "name": "messageName",
                  "value": {
                    "type": ":text",
                    "value": "Success"
                  }
                },
                {
                  "name": "messageSignature",
                  "value": {
                    "type": ":text",
                    "value": "Success(message,value)"
                  }
                },
                {
                  "name": "text",
                  "value": {
                    "type": ":text",
                    "value": "hello"
                  }
                },
                {
                  "name": "value",
                  "value": {
                    "type": ":boolean",
                    "value": true
                  }
                },
                {
                  "name": "invalidIsNothing",
                  "value": {
                    "type": ":boolean",
                    "value": true
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "invalid handler binding and non message emit are lenient no ops",
      "script": "module MessageBindingNoOp\non Start(unit, hp) {\n  let shoot as :handler be Shoot(unit, target)\n  let invalid as :message be shoot(unit: unit, hp: hp)\n  emit invalid\n  emit unit\n  emit Done(isMessage: invalid is :message, isNothing: invalid is nothing)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": [
              {
                "name": "unit",
                "value": {
                  "type": ":text",
                  "value": "u_1"
                }
              },
              {
                "name": "hp",
                "value": {
                  "type": ":integer",
                  "value": "10"
                }
              }
            ]
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": [
                {
                  "name": "isMessage",
                  "value": {
                    "type": ":boolean",
                    "value": false
                  }
                },
                {
                  "name": "isNothing",
                  "value": {
                    "type": ":boolean",
                    "value": true
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "message and handler values expose members without becoming dictionaries",
      "script": "module MessageFirstClass\non Start(unit, target) {\n  let shoot as :handler be Shoot(unit, target)\n  let msg as :message be shoot(unit: unit, target: target)\n  emit Done(msgIsMessage: msg is :message, msgIsMap: msg is :map, handlerIsHandler: shoot is :handler, handlerIsMap: shoot is :map, msgName: msg.name, msgSignature: msg[#signature], handlerName: shoot.name, handlerParameterCount: shoot.parameters[:count], messageArgumentCount: msg.arguments[:count])\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": [
              {
                "name": "unit",
                "value": {
                  "type": ":text",
                  "value": "u_1"
                }
              },
              {
                "name": "target",
                "value": {
                  "type": ":text",
                  "value": "t_1"
                }
              }
            ]
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": [
                {
                  "name": "msgIsMessage",
                  "value": {
                    "type": ":boolean",
                    "value": true
                  }
                },
                {
                  "name": "msgIsMap",
                  "value": {
                    "type": ":boolean",
                    "value": false
                  }
                },
                {
                  "name": "handlerIsHandler",
                  "value": {
                    "type": ":boolean",
                    "value": true
                  }
                },
                {
                  "name": "handlerIsMap",
                  "value": {
                    "type": ":boolean",
                    "value": false
                  }
                },
                {
                  "name": "msgName",
                  "value": {
                    "type": ":text",
                    "value": "Shoot"
                  }
                },
                {
                  "name": "msgSignature",
                  "value": {
                    "type": ":text",
                    "value": "Shoot(unit,target)"
                  }
                },
                {
                  "name": "handlerName",
                  "value": {
                    "type": ":text",
                    "value": "Shoot"
                  }
                },
                {
                  "name": "handlerParameterCount",
                  "value": {
                    "type": ":integer",
                    "value": "2"
                  }
                },
                {
                  "name": "messageArgumentCount",
                  "value": {
                    "type": ":integer",
                    "value": "2"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "message values can be transported as published arguments",
      "script": "on Start(unit, target) {\n  let shoot as :handler be Shoot(unit, target)\n  let msg as :message be shoot(unit: unit, target: target)\n  emit Done(messageValue: msg)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": [
              {
                "name": "unit",
                "value": {
                  "type": ":text",
                  "value": "u_1"
                }
              },
              {
                "name": "target",
                "value": {
                  "type": ":text",
                  "value": "t_1"
                }
              }
            ]
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": [
                {
                  "name": "messageValue",
                  "value": {
                    "type": ":message",
                    "message": {
                      "name": "Shoot",
                      "args": [
                        {
                          "name": "unit",
                          "value": {
                            "type": ":text",
                            "value": "u_1"
                          }
                        },
                        {
                          "name": "target",
                          "value": {
                            "type": ":text",
                            "value": "t_1"
                          }
                        }
                      ]
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "initialization handler emits when session starts",
      "script": "module RuntimeInitialization\n\non initialization {\n  emit Ready(value: 1)\n}",
      "expectedInitializationPublished": [
        {
          "name": "Ready",
          "args": [
            {
              "name": "value",
              "value": {
                "type": ":integer",
                "value": "1"
              }
            }
          ]
        }
      ]
    }
  ]
}
