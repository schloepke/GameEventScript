{
  "version": 1,
  "name": "RuntimeAtomicControlFlow",
  "level": "atomic",
  "tests": [
    {
      "kind": "scriptApi",
      "name": "if branches use true only conditions",
      "script": "module AtomicControlIfBranches\non Start {\n  if true {\n    emit Branch(name: 'true-then')\n  } else {\n    emit Branch(name: 'true-else')\n  }\n\n  if false {\n    emit Branch(name: 'false-then')\n  } else {\n    emit Branch(name: 'false-else')\n  }\n\n  if missing {\n    emit Branch(name: 'missing-then')\n  } else {\n    emit Branch(name: 'missing-else')\n  }\n\n  emit Done\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Branch",
              "args": {
                "name": {
                  "type": ":text",
                  "value": "true-then"
                }
              }
            },
            {
              "name": "Branch",
              "args": {
                "name": {
                  "type": ":text",
                  "value": "false-else"
                }
              }
            },
            {
              "name": "Branch",
              "args": {
                "name": {
                  "type": ":text",
                  "value": "missing-else"
                }
              }
            },
            {
              "name": "Done",
              "args": {}
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "or short circuits only on true",
      "script": "module AtomicControlOrShortCircuit\non Start {\n  let trueSkips be true or :test.fail()\n  let falseEvaluates be false or :test.truth()\n  let missingResolves be missing or true\n  let missingStaysUnknown be missing or false\n  emit Done(trueSkips: trueSkips, falseEvaluates: falseEvaluates, missingResolves: missingResolves, missingStaysUnknown: missingStaysUnknown)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "falseEvaluates": {
                  "type": ":boolean",
                  "value": true
                },
                "missingResolves": {
                  "type": ":boolean",
                  "value": true
                },
                "missingStaysUnknown": {
                  "type": ":nothing"
                },
                "trueSkips": {
                  "type": ":boolean",
                  "value": true
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "and short circuits only on false",
      "script": "module AtomicControlAndShortCircuit\non Start {\n  let falseSkips be false and :test.fail()\n  let trueEvaluates be true and :test.truth()\n  let missingResolvesFalse be missing and false\n  let missingStaysUnknown be missing and true\n  emit Done(falseSkips: falseSkips, trueEvaluates: trueEvaluates, missingResolvesFalse: missingResolvesFalse, missingStaysUnknown: missingStaysUnknown)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "falseSkips": {
                  "type": ":boolean",
                  "value": false
                },
                "missingResolvesFalse": {
                  "type": ":boolean",
                  "value": false
                },
                "missingStaysUnknown": {
                  "type": ":nothing"
                },
                "trueEvaluates": {
                  "type": ":boolean",
                  "value": true
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "implication short circuits false antecedent",
      "script": "module AtomicControlImplication\non Start {\n  let falseSkips be false -> :test.fail()\n  let trueEvaluates be true -> true\n  let trueFails be true -> false\n  let missingResolvesTrue be missing -> true\n  let missingStaysUnknown be missing -> false\n  emit Done(falseSkips: falseSkips, trueEvaluates: trueEvaluates, trueFails: trueFails, missingResolvesTrue: missingResolvesTrue, missingStaysUnknown: missingStaysUnknown)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "falseSkips": {
                  "type": ":boolean",
                  "value": true
                },
                "missingResolvesTrue": {
                  "type": ":boolean",
                  "value": true
                },
                "missingStaysUnknown": {
                  "type": ":nothing"
                },
                "trueEvaluates": {
                  "type": ":boolean",
                  "value": true
                },
                "trueFails": {
                  "type": ":boolean",
                  "value": false
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "guarded choice selects first true branch",
      "script": "module AtomicControlGuardedChoice\non Start {\n  let firstTrue as :number be 10 when false, or 20 when true, or 30 when true, otherwise 40\n  let otherwiseValue as :number be 10 when false, or 20 when missing, otherwise 40\n  emit Done(firstTrue: firstTrue, otherwiseValue: otherwiseValue)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "firstTrue": {
                  "type": ":integer",
                  "value": "20"
                },
                "otherwiseValue": {
                  "type": ":integer",
                  "value": "40"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "for loops iterate lists ranges and text",
      "script": "module AtomicControlForIteration\non Start {\n  for item in [1, 2] {\n    emit Item(kind: 'list', value: item)\n  }\n\n  for item from 1 to 3 step 2 {\n    emit Item(kind: 'range', value: item)\n  }\n\n  for item in 'ab' {\n    emit Item(kind: 'text', value: item)\n  }\n\n  emit Done\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Item",
              "args": {
                "kind": {
                  "type": ":text",
                  "value": "list"
                },
                "value": {
                  "type": ":integer",
                  "value": "1"
                }
              }
            },
            {
              "name": "Item",
              "args": {
                "kind": {
                  "type": ":text",
                  "value": "list"
                },
                "value": {
                  "type": ":integer",
                  "value": "2"
                }
              }
            },
            {
              "name": "Item",
              "args": {
                "kind": {
                  "type": ":text",
                  "value": "range"
                },
                "value": {
                  "type": ":integer",
                  "value": "1"
                }
              }
            },
            {
              "name": "Item",
              "args": {
                "kind": {
                  "type": ":text",
                  "value": "range"
                },
                "value": {
                  "type": ":integer",
                  "value": "3"
                }
              }
            },
            {
              "name": "Item",
              "args": {
                "kind": {
                  "type": ":text",
                  "value": "text"
                },
                "value": {
                  "type": ":text",
                  "value": "a"
                }
              }
            },
            {
              "name": "Item",
              "args": {
                "kind": {
                  "type": ":text",
                  "value": "text"
                },
                "value": {
                  "type": ":text",
                  "value": "b"
                }
              }
            },
            {
              "name": "Done",
              "args": {}
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "for loops skip empty and non iterable sources",
      "script": "module AtomicControlForEmptySources\non Start {\n  for item in [] {\n    emit Item(kind: 'empty-list', value: item)\n  }\n\n  for item in '' {\n    emit Item(kind: 'empty-text', value: item)\n  }\n\n  for item in missing {\n    emit Item(kind: 'missing', value: item)\n  }\n\n  for item in 123 {\n    emit Item(kind: 'number', value: item)\n  }\n\n  emit Done\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {}
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "function and predicate calls return values",
      "script": "module AtomicControlReturns\nfunction addOne(_ value) means value + 1\npredicate isLarge(_ value) means value > 2\n\non Start {\n  let a be addOne(2)\n  if isLarge(a) {\n    emit Done(value: a, matched: true)\n  } else {\n    emit Done(value: a, matched: false)\n  }\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "matched": {
                  "type": ":boolean",
                  "value": true
                },
                "value": {
                  "type": ":integer",
                  "value": "3"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "seeded random statement restores outer flow",
      "script": "module AtomicControlSeededRandom\non Start(seed as :number) {\n  :random with seed {\n    let inner be :random from 1 to 6\n    emit Roll(scope: 'inner', value: inner)\n  }\n\n  emit Done(after: true)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {
              "seed": {
                "type": ":integer",
                "value": "7"
              }
            }
          },
          "expectedPublished": [
            {
              "name": "Roll",
              "args": {
                "scope": {
                  "type": ":text",
                  "value": "inner"
                },
                "value": {
                  "type": ":integer",
                  "value": "2"
                }
              }
            },
            {
              "name": "Done",
              "args": {
                "after": {
                  "type": ":boolean",
                  "value": true
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
