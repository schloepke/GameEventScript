{
  "name": "gameeventscript",
  "displayName": "Game Event Script",
  "description": "GES, GESA and GES document syntax highlighting, a .gesb viewer, snippets, and CLI commands.",
  "version": "0.5.0",
  "publisher": "schloepke",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "GES",
    "GESA",
    "GESD",
    "GameEventScript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/schloepke/GameEventScript.git",
    "directory": "tools/editors/VS Code"
  },
  "contributes": {
    "languages": [
      {
        "id": "ges",
        "aliases": [
          "Game Event Script",
          "GES"
        ],
        "extensions": [
          ".ges"
        ],
        "configuration": "./ges-language-configuration.json"
      },
      {
        "id": "gesa",
        "aliases": [
          "Game Event Script Assembler",
          "GESA"
        ],
        "extensions": [
          ".gesa"
        ],
        "configuration": "./gesa-language-configuration.json"
      },
      {
        "id": "gesd",
        "aliases": [
          "Game Event Script Document",
          "GESD"
        ],
        "extensions": [
          ".gesd"
        ],
        "configuration": "./gesd-language-configuration.json"
      },
      {
        "id": "gess",
        "aliases": [
          "Game Event Script Schema",
          "GESS"
        ],
        "extensions": [
          ".gess"
        ],
        "configuration": "./gess-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ges",
        "scopeName": "source.gameeventscript",
        "path": "./syntaxes/GameEventScript.tmLanguage.json"
      },
      {
        "language": "gesa",
        "scopeName": "source.gameeventscript.assembler",
        "path": "./syntaxes/GameEventScriptAssembler.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.gameeventscript.assembler": "ges",
          "meta.embedded.line.gameeventscript.assembler": "ges"
        }
      },
      {
        "language": "gesd",
        "scopeName": "source.gameeventscript.document",
        "path": "./syntaxes/GameEventScriptDocument.tmLanguage.json"
      },
      {
        "language": "gess",
        "scopeName": "source.gameeventscript.schema",
        "path": "./syntaxes/GameEventScriptSchema.tmLanguage.json"
      },
      {
        "scopeName": "markdown.ges.codeblock",
        "path": "./syntaxes/Markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.ges.markdown": "ges",
          "meta.embedded.block.gesa.markdown": "gesa",
          "meta.embedded.block.gesd.markdown": "gesd",
          "meta.embedded.block.gess.markdown": "gess",
          "meta.embedded.block.gameeventscript.assembler": "ges",
          "meta.embedded.line.gameeventscript.assembler": "ges"
        }
      }
    ],
    "snippets": [
      {
        "language": "ges",
        "path": "./snippets/ges.json"
      }
    ],
    "commands": [
      {
        "command": "ges.check",
        "title": "GES: Check",
        "icon": "$(check)",
        "enablement": "isWorkspaceTrusted && editorLangId == ges && resourceScheme == file"
      },
      {
        "command": "ges.run",
        "title": "GES: Run",
        "icon": "$(play)",
        "enablement": "isWorkspaceTrusted && editorLangId == ges && resourceScheme == file"
      },
      {
        "command": "ges.dump",
        "title": "GES: Dump",
        "icon": "$(file-code)",
        "enablement": "isWorkspaceTrusted && editorLangId == ges && resourceScheme == file"
      },
      {
        "command": "ges.dumpBinary",
        "title": "GES: Show Assembler Dump",
        "icon": "$(file-code)",
        "enablement": "isWorkspaceTrusted && activeCustomEditorId == gameeventscript.gesbViewer"
      },
      {
        "command": "ges.compile",
        "title": "GES: Compile",
        "icon": "$(gear)",
        "enablement": "isWorkspaceTrusted && editorLangId == ges && resourceScheme == file"
      },
      {
        "command": "ges.runWithArguments",
        "title": "GES: Run with Arguments…",
        "enablement": "isWorkspaceTrusted && editorLangId == ges && resourceScheme == file",
        "icon": "$(run-all)"
      },
      {
        "command": "ges.startInteractive",
        "title": "GES: Start Interactive Session",
        "enablement": "isWorkspaceTrusted && editorLangId == ges && resourceScheme == file",
        "icon": "$(terminal)"
      },
      {
        "command": "ges.restartInteractive",
        "title": "GES: Restart Interactive Session",
        "enablement": "isWorkspaceTrusted && editorLangId == ges && resourceScheme == file",
        "icon": "$(debug-restart)"
      }
    ],
    "customEditors": [
      {
        "viewType": "gameeventscript.gesbViewer",
        "displayName": "GES Binary Viewer",
        "selector": [
          {
            "filenamePattern": "*.gesb"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "ges.dumpBinary",
          "when": "activeCustomEditorId == gameeventscript.gesbViewer && resourceScheme == file",
          "group": "navigation@1"
        },
        {
          "command": "ges.check",
          "when": "editorLangId == ges && resourceScheme == file",
          "group": "navigation@1"
        },
        {
          "command": "ges.run",
          "when": "editorLangId == ges && resourceScheme == file",
          "group": "navigation@2"
        },
        {
          "command": "ges.dump",
          "when": "editorLangId == ges && resourceScheme == file",
          "group": "navigation@3"
        },
        {
          "command": "ges.runWithArguments",
          "when": "editorLangId == ges && resourceScheme == file",
          "group": "navigation@4"
        },
        {
          "command": "ges.startInteractive",
          "when": "editorLangId == ges && resourceScheme == file",
          "group": "navigation@5"
        },
        {
          "command": "ges.restartInteractive",
          "when": "editorLangId == ges && resourceScheme == file",
          "group": "navigation@6"
        }
      ]
    },
    "configuration": {
      "title": "Game Event Script",
      "properties": {
        "ges.cliPath": {
          "type": "string",
          "default": "ges",
          "scope": "machine-overridable",
          "description": "CLI executable name or absolute path (ges or dotnet-ges). No shell arguments."
        }
      }
    },
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./markdown-preview.css"
    ]
  },
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Highlighting and the .gesb viewer are available; CLI commands require workspace trust."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "dependencies": {
    "vscode-textmate": "9.2.0",
    "vscode-oniguruma": "2.0.1"
  }
}
