<Project>
    <Import Project="../../../../Directory.Build.props" />
    <PropertyGroup>
        <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
        <GesConsumerMode>packages</GesConsumerMode>
        <GesConsumerMode Condition="'$(GesUseUnityDlls)' == 'true'">dlls</GesConsumerMode>
        <BaseOutputPath>$(MSBuildThisFileDirectory)../../../../artifacts/csharp/package-consumer/$(GesConsumerMode)/bin/</BaseOutputPath>
        <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../../../artifacts/csharp/package-consumer/$(GesConsumerMode)/obj/</BaseIntermediateOutputPath>
    </PropertyGroup>
</Project>
