      "script": "module AtomicMessageAccess\non Start {\n  let value be Ping(amount: 7, target: 'orc')\n  emit Done(memberName: value.name, memberArg: value.arguments.amount, memberMissing: value.missing, indexName: value[:name], indexArg: value[:arguments].target, indexMissing: value[:missing], indexOut: value[1])\n}",
      "steps": [
        {
          "input": { "name": "Start", "args": {} },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "memberName": { "type": ":text", "value": "Ping" },
                "memberArg": { "type": ":integer", "value": "7" },
                "memberMissing": { "type": ":nothing" },
                "indexName": { "type": ":text", "value": "Ping" },
                "indexArg": { "type": ":text", "value": "orc" },
                "indexMissing": { "type": ":nothing" },
                "indexOut": { "type": ":nothing" }
              }
            }
          ]
        }
      ]
