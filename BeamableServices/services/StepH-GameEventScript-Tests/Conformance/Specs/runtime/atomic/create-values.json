{
  "version": 1,
  "name": "RuntimeAtomicCreateValues",
  "level": "atomic",
  "tests": [
    {
      "kind": "scriptApi",
      "name": "load primitive values",
      "script": "module AtomicLoadPrimitiveValues\non Start {\n  let nothingValue be nothing\n  let trueValue be true\n  let falseValue be false\n  let integerValue be 42\n  let floatValue be 12.5\n  let meterValue be 7m\n  let percentageValue be 25%\n  let textValue be 'hello'\n  let tagValue be #boss\n  emit Done(nothingValue: nothingValue, trueValue: trueValue, falseValue: falseValue, integerValue: integerValue, floatValue: floatValue, meterValue: meterValue, percentageValue: percentageValue, textValue: textValue, tagValue: tagValue)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "falseValue": {
                  "type": ":boolean",
                  "value": false
                },
                "floatValue": {
                  "type": ":float",
                  "value": "12.5"
                },
                "integerValue": {
                  "type": ":integer",
                  "value": "42"
                },
                "meterValue": {
                  "type": ":integer",
                  "unit": ":meter",
                  "value": "7"
                },
                "nothingValue": {
                  "type": ":nothing"
                },
                "percentageValue": {
                  "type": ":percentage",
                  "value": "0.25"
                },
                "tagValue": {
                  "type": ":tag",
                  "value": "boss"
                },
                "textValue": {
                  "type": ":text",
                  "value": "hello"
                },
                "trueValue": {
                  "type": ":boolean",
                  "value": true
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "create vector and point values",
      "script": "module AtomicCreateVectorPointValues\non Start {\n  let vectorValue be :vector(1, 2.5, 3)\n  let pointValue be :point(4, 5.5, 6)\n  let liftedVector be :vector(vectorValue)\n  let liftedVectorWithZ be :vector(vectorValue, 9)\n  let vectorFromPoint be :vector(pointValue)\n  let liftedPoint be :point(pointValue)\n  let liftedPointWithZ be :point(pointValue, 8)\n  let pointFromVector be :point(vectorValue)\n  let unitVector be :vector(3m, 4m)\n  let unitLiftedVector be :vector(unitVector)\n  let unitLiftedVectorWithZ be :vector(unitVector, 20m)\n  let unitPoint be :point(3m, 4m)\n  let unitLiftedPointWithZ be :point(unitPoint, 20m)\n  emit Done(vectorValue: vectorValue, pointValue: pointValue, liftedVector: liftedVector, liftedVectorWithZ: liftedVectorWithZ, vectorFromPoint: vectorFromPoint, liftedPoint: liftedPoint, liftedPointWithZ: liftedPointWithZ, pointFromVector: pointFromVector, unitVector: unitVector, unitLiftedVector: unitLiftedVector, unitLiftedVectorWithZ: unitLiftedVectorWithZ, unitPoint: unitPoint, unitLiftedPointWithZ: unitLiftedPointWithZ)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "pointValue": {
                  "type": ":point",
                  "x": "4",
                  "y": "5.5",
                  "z": "6"
                },
                "liftedPoint": {
                  "type": ":point",
                  "x": "4",
                  "y": "5.5",
                  "z": "6"
                },
                "liftedPointWithZ": {
                  "type": ":point",
                  "x": "4",
                  "y": "5.5",
                  "z": "8"
                },
                "liftedVector": {
                  "type": ":vector",
                  "x": "1",
                  "y": "2.5",
                  "z": "3"
                },
                "liftedVectorWithZ": {
                  "type": ":vector",
                  "x": "1",
                  "y": "2.5",
                  "z": "9"
                },
                "pointFromVector": {
                  "type": ":point",
                  "x": "1",
                  "y": "2.5",
                  "z": "3"
                },
                "unitLiftedPointWithZ": {
                  "type": ":point",
                  "unit": ":meter",
                  "x": "3",
                  "y": "4",
                  "z": "20"
                },
                "unitLiftedVector": {
                  "type": ":vector",
                  "unit": ":meter",
                  "x": "3",
                  "y": "4",
                  "z": "0"
                },
                "unitLiftedVectorWithZ": {
                  "type": ":vector",
                  "unit": ":meter",
                  "x": "3",
                  "y": "4",
                  "z": "20"
                },
                "unitPoint": {
                  "type": ":point",
                  "unit": ":meter",
                  "x": "3",
                  "y": "4",
                  "z": "0"
                },
                "unitVector": {
                  "type": ":vector",
                  "unit": ":meter",
                  "x": "3",
                  "y": "4",
                  "z": "0"
                },
                "vectorFromPoint": {
                  "type": ":vector",
                  "x": "4",
                  "y": "5.5",
                  "z": "6"
                },
                "vectorValue": {
                  "type": ":vector",
                  "x": "1",
                  "y": "2.5",
                  "z": "3"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "create range values",
      "script": "module AtomicCreateRangeValues\non Start {\n  let ascending as :range be from 1 to 3\n  let stepped as :range be from 1 to 5 step 2\n  let descending as :range be from 5 to 1 step (0 - 2)\n  emit Done(ascending: ascending, stepped: stepped, descending: descending)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "ascending": {
                  "type": ":range",
                  "from": "1",
                  "to": "3",
                  "step": "1"
                },
                "descending": {
                  "type": ":range",
                  "from": "5",
                  "to": "1",
                  "step": "-2"
                },
                "stepped": {
                  "type": ":range",
                  "from": "1",
                  "to": "5",
                  "step": "2"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "create float range values",
      "script": "module AtomicCreateFloatRangeValues\non Start {\n  let ascending as :range be from 1.5 to 3.5 step 0.5\n  let descending as :range be from 3.5 to 1.5 step (0 - 0.5)\n  emit Done(ascending: ascending, descending: descending)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "ascending": {
                  "type": ":range",
                  "from": "1.5",
                  "to": "3.5",
                  "step": "0.5"
                },
                "descending": {
                  "type": ":range",
                  "from": "3.5",
                  "to": "1.5",
                  "step": "-0.5"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "create dice values",
      "script": "module AtomicCreateDiceValues\non Start {\n  let diceValue be roll dice 6d3\n  let constructedDice be :dice([1, 2, 3])\n  emit Done(diceValue: diceValue, length: diceValue[:count], constructedDice: constructedDice, constructedLength: constructedDice[:count])\n}",
      "randomSequence": [
        "3",
        "2",
        "1",
        "3",
        "2",
        "1"
      ],
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "diceValue": {
                  "type": ":dice",
                  "rolls": [
                    3,
                    3,
                    2,
                    2,
                    1,
                    1
                  ]
                },
                "length": {
                  "type": ":integer",
                  "value": "6"
                },
                "constructedDice": {
                  "type": ":dice",
                  "rolls": [
                    3,
                    2,
                    1
                  ]
                },
                "constructedLength": {
                  "type": ":integer",
                  "value": "3"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "create list values",
      "script": "module AtomicCreateListValues\non Start {\n  let values be [1, 'two', pi, true]\n  emit Done(values: values, length: values[:count])\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "length": {
                  "type": ":integer",
                  "value": "4"
                },
                "values": {
                  "type": ":list",
                  "items": [
                    {
                      "type": ":integer",
                      "value": "1"
                    },
                    {
                      "type": ":text",
                      "value": "two"
                    },
                    {
                      "type": ":float",
                      "value": "3.141592653589793"
                    },
                    {
                      "type": ":boolean",
                      "value": true
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    {
