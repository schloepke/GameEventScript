# GameEventScript Performance Binary Dump Report

cases=5

// -------------------------------------------------------------------------------
//  Performance Case: PerformanceCore/math integer hot path
// -------------------------------------------------------------------------------

// -------------------------------------------------------------------------------
//  Module: PerformanceMath
//  Type: Game Event Script Assembler
//  Format version: 1.0
//
//  Disassembled at <stable>
// -------------------------------------------------------------------------------
// Script:
//
//		module PerformanceMath
//		
//		on Start(value) {
//		  let a be value + 5
//		  let b be a * 3
//		  let c be b - 7
//		  let d be c div 2
//		  let squared be d * d
//		  let f be squared mod 97
//		  let g be f + 10
//		  let h be g * 2
//		  let i be h - 15
//		  let j be i div 5
//		  emit Done(result: j)
//		}
//		
//
// -------------------------------------------------------------------------------

.gesb 1
.module "PerformanceMath"
.flags optimization


.segment text

T_value:			.text "value"
T_Start:			.text "Start"
T_result:			.text "result"
T_Done:				.text "Done"


.segment lists

Args_0:				.registers [r10]


.segment bind

Handler_Start:		.bind MessageHandler id=0 name=T_Start args=[T_value] entry=Start // "Start(value)"
Outbound_Done:		.bind OutboundMessage id=0 name=T_Done args=[T_result] // "Done(result)"


.segment code

Start:				 // handler Start(value)
					SlotLocals #11
					LoadInteger r11, #5
					Add r1, r0, r11
					LoadInteger r11, #3
					Multiply r2, r1, r11
					LoadInteger r11, #7
					Subtract r3, r2, r11
					LoadInteger r11, #2
					IntegerDivide r4, r3, r11
					Multiply r5, r4, r4
					LoadInteger r11, #97
					Modulo r6, r5, r11
					LoadInteger r11, #10
					Add r7, r6, r11
					LoadInteger r11, #2
					Multiply r8, r7, r11
					LoadInteger r11, #15
					Subtract r9, r8, r11
					LoadInteger r11, #5
					IntegerDivide r10, r9, r11
					EmitMessage Outbound_Done, Args_0 // "Done(result)"
					ReturnVoid


