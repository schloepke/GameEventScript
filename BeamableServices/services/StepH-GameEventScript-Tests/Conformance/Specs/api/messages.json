{
  "version": 1,
  "name": "ApiMessages",
  "tests": [
    {
      "kind": "messageApi",
      "name": "message signatures are ordered",
      "signature": {
        "name": "Start",
        "parameters": [
          "a",
          "b"
        ]
      },
      "message": {
        "name": "Start",
        "args": [
          {
            "name": "b",
            "value": {
              "type": ":integer",
              "value": "2"
            }
          },
          {
            "name": "a",
            "value": {
              "type": ":integer",
              "value": "1"
            }
          }
        ]
      },
      "expectedMessageName": "Start",
      "expectedSignatureId": "Start(a,b)",
      "expectedMessageSignatureId": "Start(b,a)",
      "expectedMatches": false,
      "expectedArgumentCount": 2
    },
    {
      "kind": "messageApi",
      "name": "signature ids trim message names preserve parameter order and include name",
      "signature": {
        "name": " Shoot ",
        "parameters": [
          "unit",
          "target"
        ]
      },
      "message": {
        "name": " Shoot ",
        "args": [
          {
            "name": "target",
            "value": {
              "type": ":integer",
              "value": "2"
            }
          },
          {
            "name": "unit",
            "value": {
              "type": ":integer",
              "value": "1"
            }
          }
        ]
      },
      "expectedMessageName": "Shoot",
      "expectedSignatureId": "Shoot(unit,target)",
      "expectedMessageSignatureId": "Shoot(target,unit)",
      "expectedMatches": false,
      "expectedArgumentCount": 2
    },
    {
      "kind": "messageApi",
      "name": "signature id includes the message name",
      "signature": {
        "name": "Run",
        "parameters": [
          "target",
          "unit"
        ]
      },
      "message": {
        "name": "Run",
        "args": [
          {
            "name": "target",
            "value": {
              "type": ":integer",
              "value": "2"
            }
          },
          {
            "name": "unit",
            "value": {
              "type": ":integer",
              "value": "1"
            }
          }
        ]
      },
      "expectedMessageName": "Run",
      "expectedSignatureId": "Run(target,unit)",
      "expectedMessageSignatureId": "Run(target,unit)",
      "expectedMatches": true,
      "expectedArgumentCount": 2
    },
    {
      "kind": "messageApi",
      "name": "empty ordered arguments produce an empty signature",
      "signature": {
        "name": "Ready",
        "parameters": []
      },
      "message": {
        "name": "Ready",
        "args": []
      },
      "expectedSignatureId": "Ready()",
      "expectedMessageSignatureId": "Ready()",
      "expectedMatches": true,
      "expectedArgumentCount": 0
    },
    {
      "kind": "messageApi",
      "name": "duplicate normalized message argument names are rejected",
      "signature": {
        "name": "Score",
        "parameters": [
          "score"
        ]
      },
      "message": {
        "name": "Score",
        "args": [
          {
            "name": "score",
            "value": {
              "type": ":integer",
              "value": "1"
            }
          },
          {
            "name": " score ",
            "value": {
              "type": ":integer",
              "value": "2"
            }
          }
        ]
      },
      "expectedMessageError": "duplicateArgumentName"
    },
    {
      "kind": "messageApi",
      "name": "message argument objects are rejected because order must be explicit",
      "signature": {
        "name": "Score",
        "parameters": [
          "score"
        ]
      },
      "message": {
        "name": "Score",
        "args": {
          "score": {
            "type": ":integer",
            "value": "1"
          }
        }
      },
      "expectedMessageError": "invalidArgumentsShape"
    },
    {
      "kind": "compileMetadata",
      "name": "compiled scripts expose message definitions",
      "script": "module MessageDefinitions\non Start(playerId) {\n  emit Done(playerId: playerId)\n}",
      "expectedMessageDefinitions": [
        {
          "name": "Start",
          "count": 1,
          "signatureIds": [
            "Start(playerId)"
          ]
        }
      ]
    }
  ]
}
