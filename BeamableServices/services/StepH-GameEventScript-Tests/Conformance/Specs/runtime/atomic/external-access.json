      "script": "module AtomicEmitPublishMessageValues\non Start {\n  let tags be [#alpha, #beta, #alpha]\n  let emitMsg be DynamicEmit(value: 3, label: 'local')\n  let publishMsg be DynamicPublish(value: 4, label: 'bus')\n  emit emitMsg\n  emit emitMsg with tags\n  publish publishMsg\n  publish publishMsg with #bus, tags\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "DynamicEmit",
              "args": {
                "label": {
                  "type": ":text",
                  "value": "local"
                },
                "value": {
                  "type": ":integer",
                  "value": "3"
                }
              }
            },
            {
              "name": "DynamicEmit",
              "tags": [
                "alpha",
                "beta"
              ],
              "args": {
                "label": {
                  "type": ":text",
                  "value": "local"
                },
                "value": {
                  "type": ":integer",
                  "value": "3"
                }
              }
            },
            {
              "name": "DynamicPublish",
              "args": {
                "label": {
                  "type": ":text",
                  "value": "bus"
                },
                "value": {
                  "type": ":integer",
                  "value": "4"
                }
              }
            },
            {
              "name": "DynamicPublish",
              "tags": [
                "bus",
                "alpha",
                "beta"
              ],
              "args": {
                "label": {
                  "type": ":text",
                  "value": "bus"
                },
                "value": {
                  "type": ":integer",
                  "value": "4"
                }
              }
            }
          ],
          "expectedOutboundPublished": [
            {
              "name": "DynamicPublish",
              "args": {
                "label": {
                  "type": ":text",
                  "value": "bus"
                },
                "value": {
                  "type": ":integer",
                  "value": "4"
                }
              }
            },
            {
              "name": "DynamicPublish",
              "tags": [
                "bus",
                "alpha",
                "beta"
              ],
              "args": {
                "label": {
                  "type": ":text",
                  "value": "bus"
                },
                "value": {
                  "type": ":integer",
                  "value": "4"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "emit dispatches locally while publish only reaches outbound hook",
      "script": "module AtomicEmitPublishDispatch\non Start {\n  emit Local(value: 1)\n  publish Remote(value: 2)\n}\n\non Local(value) {\n  emit Seen(value: value)\n}\n\non Remote(value) {\n  emit ShouldNotRun(value: value)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Local",
              "args": {
                "value": {
                  "type": ":integer",
                  "value": "1"
                }
              }
            },
            {
              "name": "Remote",
              "args": {
                "value": {
                  "type": ":integer",
                  "value": "2"
                }
              }
            },
            {
              "name": "Seen",
              "args": {
                "value": {
                  "type": ":integer",
                  "value": "1"
                }
              }
            }
          ],
          "expectedOutboundPublished": [
            {
              "name": "Remote",
              "args": {
                "value": {
                  "type": ":integer",
                  "value": "2"
                }
              }
            }
          ]
        }
      ]
    },
