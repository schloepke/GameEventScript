 or for UDP read the shared socket, validate unknown addresses and route each datagram to its","type":"text"},{"text":" ","type":"text"},{"text":"client; the host takes each ready client with ","type":"text"},{"type":"codeVoice","code":"accept(now:)"},{"text":" where it runs its sessions.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"GesNetworkSocketListener"}],"navigatorTitle":[{"kind":"identifier","text":"GesNetworkSocketListener"}],"type":"topic","kind":"symbol"},"doc://org.gameeventscript.GameEventScriptNetworkSockets/documentation/GameEventScriptNetworkSockets/GesNetworkSocketListener/accept(now:)":{"url":"\/documentation\/gameeventscriptnetworksockets\/gesnetworksocketlistener\/accept(now:)","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"accept"},{"kind":"text","text":"("},{"kind":"externalParam","text":"now"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s5Int64V","text":"Int64"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:29GameEventScriptNetworkSockets03GesD13SocketSessionC","text":"GesNetworkSocketSession"},{"kind":"text","text":"?"}],"abstract":[{"text":"Takes the next client that is ready, without waiting, and creates its server connection at ","type":"text"},{"type":"codeVoice","code":"now"},{"text":". Call","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"GesNetworkSocketSession.update(now:)"},{"text":" to run it.","type":"text"}],"type":"topic","title":"accept(now:)","identifier":"doc:\/\/org.gameeventscript.GameEventScriptNetworkSockets\/documentation\/GameEventScriptNetworkSockets\/GesNetworkSocketListener\/accept(now:)"},"doc://org.gameeventscript.GameEventScriptNetworkSockets/documentation/GameEventScriptNetworkSockets":{"kind":"symbol","role":"collection","abstract":[{"text":"Game Event Script Unreleased API, source 47afc43b2fc1.","type":"text"}],"type":"topic","identifier":"doc:\/\/org.gameeventscript.GameEventScriptNetworkSockets\/documentation\/GameEventScriptNetworkSockets","url":"\/documentation\/gameeventscriptnetworksockets","title":"GameEventScriptNetworkSockets"},"doc://org.gameeventscript.GameEventScriptNetworkSockets/documentation/GameEventScriptNetworkSockets/GesNetworkSocketSession":{"abstract":[{"type":"text","text":"Carries one "},{"type":"codeVoice","code":"GesNetworkConnection"},{"type":"text","text":" over a TCP stream, a WebSocket or UDP. SwiftNIO event loops only move bytes: the"},{"type":"text","text":" "},{"type":"text","text":"host calls "},{"type":"codeVoice","code":"receive(now:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"transmit()"},{"type":"text","text":", or "},{"type":"codeVoice","code":"update(now:)"},{"type":"text","text":" for both, on its own task or thread, which feeds"},{"type":"text","text":" "},{"type":"text","text":"received bytes into the connection, advances it and hands its packets to the socket. The connection is touched only"},{"type":"text","text":" "},{"type":"text","text":"by the host. As a "},{"type":"codeVoice","code":"GesNetworkLink"},{"type":"text","text":" it is the transport of an end."}],"type":"topic","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"GesNetworkSocketSession"}],"kind":"symbol","url":"\/documentation\/gameeventscriptnetworksockets\/gesnetworksocketsession","title":"GesNetworkSocketSession","identifier":"doc:\/\/org.gameeventscript.GameEventScriptNetworkSockets\/documentation\/GameEventScriptNetworkSockets\/GesNetworkSocketSession","navigatorTitle":[{"kind":"identifier","text":"GesNetworkSocketSession"}]}}}