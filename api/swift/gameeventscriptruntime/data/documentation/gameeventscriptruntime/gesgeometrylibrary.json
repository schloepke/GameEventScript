{"metadata":{"externalID":"s:22GameEventScriptRuntime18GesGeometryLibraryO","title":"GesGeometryLibrary","symbolKind":"enum","roleHeading":"Enumeration","navigatorTitle":[{"kind":"identifier","text":"GesGeometryLibrary"}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"GesGeometryLibrary"}],"modules":[{"name":"GameEventScriptRuntime"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gameeventscriptruntime\/gesgeometrylibrary"]}],"hierarchy":{"paths":[["doc:\/\/org.gameeventscript.GameEventScriptRuntime\/documentation\/GameEventScriptRuntime"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"GesGeometryLibrary"}]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"A host that wants it passes "},{"type":"reference","identifier":"doc:\/\/org.gameeventscript.GameEventScriptRuntime\/documentation\/GameEventScriptRuntime\/GesGeometryLibrary\/catalog(next:)","isActive":true},{"type":"text","text":" to the compiler and "},{"type":"reference","identifier":"doc:\/\/org.gameeventscript.GameEventScriptRuntime\/documentation\/GameEventScriptRuntime\/GesGeometryLibrary\/externalTypes(next:)","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/org.gameeventscript.GameEventScriptRuntime\/documentation\/GameEventScriptRuntime\/GesGeometryLibrary\/extensions(next:)","isActive":true},{"type":"text","text":" to"},{"type":"text","text":" "},{"type":"text","text":"the host, each in front of its own catalog or registry, which resolves what the library does not."},{"type":"text","text":" "},{"type":"codeVoice","code":":Box(lower: p, upper: q)"},{"type":"text","text":" takes two corners in any order, which its fields "},{"type":"codeVoice","code":"lower"},{"type":"text","text":" and "},{"type":"codeVoice","code":"upper"},{"type":"text","text":" return ordered ("},{"type":"codeVoice","code":"min"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"max"},{"type":"text","text":" are GES keywords), and "},{"type":"codeVoice","code":":Box(center: p, size: v)"},{"type":"text","text":" a centre and a size;"},{"type":"text","text":" "},{"type":"codeVoice","code":":Poly(points: [...])"},{"type":"text","text":" takes its points; "},{"type":"codeVoice","code":":Disc(center: p, radius: r)"},{"type":"text","text":" a centre and a radius and "},{"type":"codeVoice","code":":Disc(radius: r)"},{"type":"text","text":" a"},{"type":"text","text":" "},{"type":"text","text":"radius around the origin; the radius follows its declared Number type, so a Percentage is its unitless ratio. Corners, points, sizes and radii share one unit, which the value keeps; another kind or a mixed"},{"type":"text","text":" "},{"type":"text","text":"unit constructs "},{"type":"codeVoice","code":"nothing"},{"type":"text","text":". A polygon or disc need not be valid to exist, but its operations give "},{"type":"codeVoice","code":"nothing"},{"type":"text","text":" when it is not."},{"type":"text","text":" "},{"type":"text","text":"Functions: "},{"type":"codeVoice","code":"size"},{"type":"text","text":", "},{"type":"codeVoice","code":"center"},{"type":"text","text":", "},{"type":"codeVoice","code":"union"},{"type":"text","text":", "},{"type":"codeVoice","code":"inset(_, by:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"nearest"},{"type":"text","text":", the point of a shape nearest to a point ("},{"type":"codeVoice","code":"clamp"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"a GES keyword), of boxes; "},{"type":"codeVoice","code":"bounds"},{"type":"text","text":", "},{"type":"codeVoice","code":"area"},{"type":"text","text":" (signed and unitless, like "},{"type":"codeVoice","code":"dot"},{"type":"text","text":"), "},{"type":"codeVoice","code":"distance"},{"type":"text","text":" and "},{"type":"codeVoice","code":"centroid"},{"type":"text","text":" of polygons;"},{"type":"text","text":" "},{"type":"codeVoice","code":"center"},{"type":"text","text":", "},{"type":"codeVoice","code":"bounds"},{"type":"text","text":", "},{"type":"codeVoice","code":"area"},{"type":"text","text":", "},{"type":"codeVoice","code":"distance"},{"type":"text","text":", "},{"type":"codeVoice","code":"inset(_, by:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"nearest"},{"type":"text","text":" of discs; "},{"type":"codeVoice","code":"contains"},{"type":"text","text":" and "},{"type":"codeVoice","code":"intersects"},{"type":"text","text":" of all, a box"},{"type":"text","text":" "},{"type":"text","text":"with a polygon counting as its outline in the plane and a disc meeting a 2D box. Anything else, such as another unit,"},{"type":"text","text":" "},{"type":"text","text":"gives "},{"type":"codeVoice","code":"nothing"},{"type":"text","text":"."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/org.gameeventscript.GameEventScriptRuntime\/documentation\/GameEventScriptRuntime\/GesGeometryLibrary","interfaceLanguage":"swift"},"kind":"symbol","abstract":[{"type":"text","text":"The standard geometry library: the external types "},{"type":"codeVoice","code":":Box"},{"type":"text","text":", "},{"type":"codeVoice","code":":Poly"},{"type":"text","text":" and "},{"type":"codeVoice","code":":Disc"},{"type":"text","text":" over "},{"type":"reference","identifier":"doc:\/\/org.gameeventscript.GameEventScriptRuntime\/documentation\/GameEventScriptRuntime\/GesBox","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/org.gameeventscript.GameEventScriptRuntime\/documentation\/GameEventScriptRuntime\/GesPoly","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"