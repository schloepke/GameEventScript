{
  "version": 1,
  "name": "CoreCompileErrors",
  "tests": [
    {
      "kind": "compileError",
      "name": "syntax parser error",
      "script": "on Broken {\n  let x be\n  publish Done\n}",
      "expectedError": {
        "phase": "syntax",
        "kind": "Parser"
      }
    },
    {
      "kind": "compileError",
      "name": "linkage duplicate variable",
      "scripts": [
        {
          "sourceName": "duplicate-variables.es",
          "text": "module DuplicateVariables\non Start {\n  let x be 10\n  let x be 20\n}"
        }
      ],
      "expectedError": {
        "phase": "linkage",
        "kind": "DuplicateVariable",
        "symbol": "x",
        "symbolKind": "Variable",
        "moduleName": "DuplicateVariables"
      }
    }
  ]
}
