module examples.assembly

predicate positive(value) be asm {
    Greater positive, value, 0
}

function square(value) be asm {
    Multiply square, value, value, #numeric
}

// Match [:sum]: numeric values only, preserving units and exact integers.
// The first value establishes the unit; only an empty collection starts at zero.
function total(items) be asm {
    .register iterator, item
    LoadNothing total
    IteratorCreateOrJump iterator, items, done
    IteratorNext item, iterator, noItems
    Move total, item, #numeric
    next:
    IteratorNext item, iterator, close
    Add total, total, item, #numeric
    Jump next
    noItems:
    LoadInteger total, 0
    close:
    IteratorClose iterator
    done:
}

on Main(args) {
    asm {
        let first, second
        LoadInteger first, 6
        LoadInteger second, 7
    }
    let product be asm {
        Multiply product, first, second, #numeric
    }
    emit ConsoleOut(product: product, square: square(value: second), total: total(items: [10, 20, 12]), positive: positive(value: product))
}
