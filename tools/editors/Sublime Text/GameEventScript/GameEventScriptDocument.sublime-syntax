"name": "GameEventScript Document"
"file_extensions":
  - "gesd"
"scope": "source.gameeventscript.document"
"first_line_match": ""
"contexts":
  "main":
    -
      "include": "comments"
    -
      "include": "strings"
    -
      "include": "forms"
    -
      "include": "keys"
    -
      "include": "constants"
    -
      "include": "numbers"
    -
      "include": "punctuation"
  "comments":
    -
      "match": "//.*$"
      "scope": "comment.line.double-slash.gameeventscript.document"
  "strings":
    -
      "match": "'"
      "push":
        -
          "meta_scope": "string.quoted.single.gameeventscript.document"
        -
          "match": "''"
          "scope": "constant.character.escape.quote.gameeventscript.document"
        -
          "match": "'"
          "pop": true
    -
      "match": "\""
      "push":
        -
          "meta_scope": "string.quoted.double.gameeventscript.document"
        -
          "match": "\"\""
          "scope": "constant.character.escape.quote.gameeventscript.document"
        -
          "match": "\""
          "pop": true
  "forms":
    -
      "match": ":Schema\\b"
      "scope": "keyword.other.declaration.schema.gameeventscript.document"
    -
      "match": "(:(?:Message|Handler))\\s*(\\()\\s*([A-Z][A-Za-z0-9]*(?:_[A-Z][A-Za-z0-9]*)*|initialization|undeliverable)\\b"
      "captures":
        1: "support.type.primitive.gameeventscript.document"
        2: "punctuation.bracket.gameeventscript.document"
        3: "entity.name.type.class.message.gameeventscript.document"
    -
      "match": "(:Series)\\s*(\\()\\s*(fibonacci|factorial)\\b"
      "captures":
        1: "support.type.primitive.gameeventscript.document"
        2: "punctuation.bracket.gameeventscript.document"
        3: "support.function.series.gameeventscript.document"
    -
      "match": ":(?:Nothing|Number|Percentage|Boolean|Text|Tag|List|Map|Dice|Vector|Point|Range|Series|Message|Handler|Record)\\b"
      "scope": "support.type.primitive.gameeventscript.document"
    -
      "match": ":[A-Z][A-Za-z0-9]*(?:_[A-Z][A-Za-z0-9]*)*"
      "scope": "entity.name.type.record.gameeventscript.document"
  "keys":
    -
      "match": "\\b([a-z][A-Za-z0-9]*|_)[ \\t]*(?=:(?![A-Za-z]))"
      "captures":
        1: "support.type.property-name.gameeventscript.document"
  "constants":
    -
      "match": "\\b(?:true|false)\\b"
      "scope": "constant.language.boolean.gameeventscript.document"
    -
      "match": "\\bnothing\\b"
      "scope": "constant.language.nothing.gameeventscript.document"
    -
      "match": "\\bwith\\b"
      "scope": "keyword.operator.word.gameeventscript.document"
    -
      "match": "#[A-Za-z0-9_]+"
      "scope": "entity.name.tag.gameeventscript.document"
  "numbers":
    -
      "match": "[+-]?(?:Infinity|NaN)\\b"
      "scope": "constant.numeric.gameeventscript.document"
    -
      "match": "[+-]?(?:\\d[\\d_]*(?:\\.\\d[\\d_]*)?|\\.\\d[\\d_]*)(?:[eE][+-]?\\d+)?(?:%|[^\\s,\\[\\]()/]*(?:/[^\\s,\\[\\]()/]+)*)?"
      "scope": "constant.numeric.gameeventscript.document"
  "punctuation":
    -
      "match": "[\\[\\]()]"
      "scope": "punctuation.bracket.gameeventscript.document"
    -
      "match": "[,:]"
      "scope": "punctuation.separator.gameeventscript.document"
