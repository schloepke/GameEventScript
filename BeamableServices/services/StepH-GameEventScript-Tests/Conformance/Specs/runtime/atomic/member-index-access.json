                "indexTag": { "type": ":integer", "value": "10" },
                "dynamicText": { "type": ":text", "value": "Ada" },
                "indexMissing": { "type": ":nothing" },
                "indexOut": { "type": ":nothing" }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "dice member and index access",
      "script": "module AtomicDiceAccess\non Start {\n  let value be :dice 3d6\n  emit Done(member: value.missing, first: value[1], third: value[3], indexZero: value[0], indexOut: value[4])\n}",
      "randomSequence": [ "6", "4", "2" ],
      "steps": [
        {
          "input": { "name": "Start", "args": {} },
          "expectedPublished": [
            {
              "name": "Done",
