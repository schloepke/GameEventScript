    {
      "kind": "scriptApi",
      "name": "loop budget stops run after published iterations",
      "script": "on Start {\n  for item from 1 to 10 emit Tick(value: item)\n  emit Done\n}",
      "runtimeLimits": {
        "maxLoopIterations": 3
      },
      "steps": [
        {
