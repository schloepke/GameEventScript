{
  "version": 1,
  "name": "RuntimeAtomicCreateValues",
  "level": "atomic",
  "tests": [
    {
      "kind": "scriptApi",
      "name": "load primitive values",
      "script": "module AtomicLoadPrimitiveValues\non Start {\n  let nothingValue be nothing\n  let trueValue be true\n  let falseValue be false\n  let integerValue be 42\n  let floatValue be 12.5\n  let meterValue be 7m\n  let percentageValue be 25%\n  let textValue be 'hello'\n  let tagValue be :boss\n  emit Done(nothingValue: nothingValue, trueValue: trueValue, falseValue: falseValue, integerValue: integerValue, floatValue: floatValue, meterValue: meterValue, percentageValue: percentageValue, textValue: textValue, tagValue: tagValue)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "falseValue": {
                  "type": ":boolean",
                  "value": false
                },
                "floatValue": {
                  "type": ":float",
                  "value": "12.5"
                },
                "integerValue": {
                  "type": ":integer",
                  "value": "42"
                },
                "meterValue": {
                  "type": ":integer",
                  "unit": ":meter",
                  "value": "7"
                },
                "nothingValue": {
                  "type": ":nothing"
                },
                "percentageValue": {
                  "type": ":percentage",
                  "value": "0.25"
                },
                "tagValue": {
                  "type": ":tag",
                  "value": "boss"
                },
                "textValue": {
                  "type": ":text",
                  "value": "hello"
                },
                "trueValue": {
                  "type": ":boolean",
                  "value": true
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "create vector and point values",
      "script": "module AtomicCreateVectorPointValues\non Start {\n  let vectorValue be :vector(1, 2.5, 3)\n  let pointValue be :point(4, 5.5, 6)\n  let liftedVector be :vector(vectorValue)\n  let liftedVectorWithZ be :vector(vectorValue, 9)\n  let vectorFromPoint be :vector(pointValue)\n  let liftedPoint be :point(pointValue)\n  let liftedPointWithZ be :point(pointValue, 8)\n  let pointFromVector be :point(vectorValue)\n  let unitVector be :vector(3m, 4m)\n  let unitLiftedVector be :vector(unitVector)\n  let unitLiftedVectorWithZ be :vector(unitVector, 20m)\n  let unitPoint be :point(3m, 4m)\n  let unitLiftedPointWithZ be :point(unitPoint, 20m)\n  emit Done(vectorValue: vectorValue, pointValue: pointValue, liftedVector: liftedVector, liftedVectorWithZ: liftedVectorWithZ, vectorFromPoint: vectorFromPoint, liftedPoint: liftedPoint, liftedPointWithZ: liftedPointWithZ, pointFromVector: pointFromVector, unitVector: unitVector, unitLiftedVector: unitLiftedVector, unitLiftedVectorWithZ: unitLiftedVectorWithZ, unitPoint: unitPoint, unitLiftedPointWithZ: unitLiftedPointWithZ)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "pointValue": {
                  "type": ":point",
                  "x": "4",
                  "y": "5.5",
                  "z": "6"
                },
                "liftedPoint": {
                  "type": ":point",
                  "x": "4",
                  "y": "5.5",
                  "z": "6"
                },
                "liftedPointWithZ": {
                  "type": ":point",
                  "x": "4",
                  "y": "5.5",
                  "z": "8"
                },
                "liftedVector": {
                  "type": ":vector",
                  "x": "1",
                  "y": "2.5",
                  "z": "3"
                },
                "liftedVectorWithZ": {
                  "type": ":vector",
                  "x": "1",
                  "y": "2.5",
                  "z": "9"
                },
                "pointFromVector": {
                  "type": ":point",
                  "x": "1",
                  "y": "2.5",
                  "z": "3"
                },
                "unitLiftedPointWithZ": {
                  "type": ":point",
                  "unit": ":meter",
                  "x": "3",
                  "y": "4",
                  "z": "20"
                },
                "unitLiftedVector": {
                  "type": ":vector",
                  "unit": ":meter",
                  "x": "3",
                  "y": "4",
                  "z": "0"
                },
                "unitLiftedVectorWithZ": {
                  "type": ":vector",
                  "unit": ":meter",
                  "x": "3",
                  "y": "4",
                  "z": "20"
                },
                "unitPoint": {
                  "type": ":point",
                  "unit": ":meter",
                  "x": "3",
                  "y": "4",
                  "z": "0"
                },
                "unitVector": {
                  "type": ":vector",
                  "unit": ":meter",
                  "x": "3",
                  "y": "4",
                  "z": "0"
                },
                "vectorFromPoint": {
                  "type": ":vector",
                  "x": "4",
                  "y": "5.5",
                  "z": "6"
                },
                "vectorValue": {
                  "type": ":vector",
                  "x": "1",
                  "y": "2.5",
                  "z": "3"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "create range values",
      "script": "module AtomicCreateRangeValues\non Start {\n  let ascending as :range be from 1 to 3\n  let stepped as :range be from 1 to 5 step 2\n  let descending as :range be from 5 to 1 step (0 - 2)\n  emit Done(ascending: ascending, stepped: stepped, descending: descending)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "ascending": {
                  "type": ":range",
                  "from": "1",
                  "to": "3",
                  "step": "1"
                },
                "descending": {
                  "type": ":range",
                  "from": "5",
                  "to": "1",
                  "step": "-2"
                },
                "stepped": {
                  "type": ":range",
                  "from": "1",
                  "to": "5",
                  "step": "2"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "create float range values",
      "script": "module AtomicCreateFloatRangeValues\non Start {\n  let ascending as :range be from 1.5 to 3.5 step 0.5\n  let descending as :range be from 3.5 to 1.5 step (0 - 0.5)\n  emit Done(ascending: ascending, descending: descending)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "ascending": {
                  "type": ":range",
                  "from": "1.5",
                  "to": "3.5",
                  "step": "0.5"
                },
                "descending": {
                  "type": ":range",
                  "from": "3.5",
                  "to": "1.5",
                  "step": "-0.5"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "create dice values",
      "script": "module AtomicCreateDiceValues\non Start {\n  let diceValue be :dice 6d3\n  emit Done(diceValue: diceValue, length: :len diceValue)\n}",
      "randomSequence": [
        "3",
        "2",
        "1",
        "3",
        "2",
        "1"
      ],
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "diceValue": {
                  "type": ":dice",
                  "rolls": [
                    3,
                    3,
                    2,
                    2,
                    1,
                    1
                  ]
                },
                "length": {
                  "type": ":integer",
                  "value": "6"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "create list values",
      "script": "module AtomicCreateListValues\non Start {\n  let values be [1, 'two', :pi, true]\n  emit Done(values: values, length: :len values)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "length": {
                  "type": ":integer",
                  "value": "4"
                },
                "values": {
                  "type": ":list",
                  "items": [
                    {
                      "type": ":integer",
                      "value": "1"
                    },
                    {
                      "type": ":text",
                      "value": "two"
                    },
                    {
                      "type": ":tag",
                      "value": "pi"
                    },
                    {
                      "type": ":boolean",
                      "value": true
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "create map values",
      "script": "module AtomicCreateMapValues\non Start {\n  let unit be [name: 'Ada', hp: 10, alive: true, role: :boss]\n  emit Done(unit: unit, length: :len unit)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "length": {
                  "type": ":integer",
                  "value": "4"
                },
                "unit": {
                  "type": ":map",
                  "entries": {
                    "alive": {
                      "type": ":boolean",
                      "value": true
                    },
                    "hp": {
                      "type": ":integer",
                      "value": "10"
                    },
                    "name": {
                      "type": ":text",
                      "value": "Ada"
                    },
                    "role": {
                      "type": ":tag",
                      "value": "boss"
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "create nested collection values",
      "script": "module AtomicCreateNestedCollectionValues\non Start {\n  let squad be [leader: [name: 'Ada', hp: 10], inventory: ['potion', 'key'], tags: [:boss, :scout]]\n  emit Done(squad: squad, length: :len squad)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "length": {
                  "type": ":integer",
                  "value": "3"
                },
                "squad": {
                  "type": ":map",
                  "entries": {
                    "inventory": {
                      "type": ":list",
                      "items": [
                        {
                          "type": ":text",
                          "value": "potion"
                        },
                        {
                          "type": ":text",
                          "value": "key"
                        }
                      ]
                    },
                    "leader": {
                      "type": ":map",
                      "entries": {
                        "hp": {
                          "type": ":integer",
                          "value": "10"
                        },
                        "name": {
                          "type": ":text",
                          "value": "Ada"
                        }
                      }
                    },
                    "tags": {
                      "type": ":list",
                      "items": [
                        {
                          "type": ":tag",
                          "value": "boss"
                        },
                        {
                          "type": ":tag",
                          "value": "scout"
                        }
                      ]
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "stage literal value kinds",
      "script": "module AtomicStageLiteralValueKinds\non Start {\n  let stagedList be [false, true, 12, 12.5, 7m, 1.5m, 25%, 'txt', :ready]\n  let stagedMap be [falseValue: false, trueValue: true, integerValue: 12, floatValue: 12.5, meterInteger: 7m, meterFloat: 1.5m, percentageValue: 25%, textValue: 'txt', tagValue: :ready]\n  emit Done(stagedList: stagedList, stagedMap: stagedMap)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "stagedList": {
                  "type": ":list",
                  "items": [
                    { "type": ":boolean", "value": false },
                    { "type": ":boolean", "value": true },
                    { "type": ":integer", "value": "12" },
                    { "type": ":float", "value": "12.5" },
                    { "type": ":integer", "unit": ":meter", "value": "7" },
                    { "type": ":float", "unit": ":meter", "value": "1.5" },
                    { "type": ":percentage", "value": "0.25" },
                    { "type": ":text", "value": "txt" },
                    { "type": ":tag", "value": "ready" }
                  ]
                },
                "stagedMap": {
                  "type": ":map",
                  "entries": {
                    "falseValue": { "type": ":boolean", "value": false },
                    "floatValue": { "type": ":float", "value": "12.5" },
                    "integerValue": { "type": ":integer", "value": "12" },
                    "meterFloat": { "type": ":float", "unit": ":meter", "value": "1.5" },
                    "meterInteger": { "type": ":integer", "unit": ":meter", "value": "7" },
                    "percentageValue": { "type": ":percentage", "value": "0.25" },
                    "tagValue": { "type": ":tag", "value": "ready" },
                    "textValue": { "type": ":text", "value": "txt" },
                    "trueValue": { "type": ":boolean", "value": true }
                  }
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "generated list builder values",
      "script": "module AtomicGeneratedListBuilderValues\non Start {\n  let sourceList be [1, 'two', :boss, true]\n  let emptyList be []\n  let dice as :dice be [6, 4, 2]\n  let text be 'ab'\n  let map be [a: 1, b: 2]\n  let fromRange be :list[:select item from 1 to 4 => item * item]\n  let filteredRange be :list[:select item from 1 to 6 where item mod 2 = 0 => item]\n  let fromList be :list[:select item in sourceList => item]\n  let fromEmptyList be :list[:select item in emptyList => item]\n  let fromDice be :list[:select item in dice => item + 1]\n  let fromText be :list[:select item in text => item]\n  let fromMap be :list[:select item in map => item * 10]\n  let invalidSource be :list[:select item in 10 => item]\n  emit Done(fromRange: fromRange, filteredRange: filteredRange, fromList: fromList, fromEmptyList: fromEmptyList, fromDice: fromDice, fromText: fromText, fromMap: fromMap, invalidSource: invalidSource)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "fromRange": {
                  "type": ":list",
                  "items": [
                    { "type": ":integer", "value": "1" },
                    { "type": ":integer", "value": "4" },
                    { "type": ":integer", "value": "9" },
                    { "type": ":integer", "value": "16" }
                  ]
                },
                "filteredRange": {
                  "type": ":list",
                  "items": [
                    { "type": ":integer", "value": "2" },
                    { "type": ":integer", "value": "4" },
                    { "type": ":integer", "value": "6" }
                  ]
                },
                "fromList": {
                  "type": ":list",
                  "items": [
                    { "type": ":integer", "value": "1" },
                    { "type": ":text", "value": "two" },
                    { "type": ":tag", "value": "boss" },
                    { "type": ":boolean", "value": true }
                  ]
                },
                "fromEmptyList": {
                  "type": ":list",
                  "items": []
                },
                "fromDice": {
                  "type": ":list",
                  "items": [
                    { "type": ":integer", "value": "7" },
                    { "type": ":integer", "value": "5" },
                    { "type": ":integer", "value": "3" }
                  ]
                },
                "fromText": {
                  "type": ":list",
                  "items": [
                    { "type": ":text", "value": "a" },
                    { "type": ":text", "value": "b" }
                  ]
                },
                "fromMap": {
                  "type": ":list",
                  "items": [
                    { "type": ":integer", "value": "10" },
                    { "type": ":integer", "value": "20" }
                  ]
                },
                "invalidSource": {
                  "type": ":list",
                  "items": []
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "generated range iterator variants",
      "script": "module AtomicGeneratedRangeIteratorVariants\non Start {\n  let fromValue be 2\n  let toValue be 5\n  let stepValue be 2\n  let shortRange be :list[:select item from 1 to 3 => item]\n  let dynamicRange be :list[:select item from fromValue to toValue => item]\n  let dynamicSteppedRange be :list[:select item from fromValue to toValue step stepValue => item]\n  let descendingRange be :list[:select item from 5 to 1 step (0 - 2) => item]\n  let floatRange be :list[:select item from 1.5 to 2.5 step 0.5 => item]\n  let emptyRange be :list[:select item from 3 to 1 => item]\n  emit Done(shortRange: shortRange, dynamicRange: dynamicRange, dynamicSteppedRange: dynamicSteppedRange, descendingRange: descendingRange, floatRange: floatRange, emptyRange: emptyRange)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "descendingRange": {
                  "type": ":list",
                  "items": [
                    { "type": ":integer", "value": "5" },
                    { "type": ":integer", "value": "3" },
                    { "type": ":integer", "value": "1" }
                  ]
                },
                "dynamicRange": {
                  "type": ":list",
                  "items": [
                    { "type": ":integer", "value": "2" },
                    { "type": ":integer", "value": "3" },
                    { "type": ":integer", "value": "4" },
                    { "type": ":integer", "value": "5" }
                  ]
                },
                "dynamicSteppedRange": {
                  "type": ":list",
                  "items": [
                    { "type": ":integer", "value": "2" },
                    { "type": ":integer", "value": "4" }
                  ]
                },
                "emptyRange": {
                  "type": ":list",
                  "items": []
                },
                "floatRange": {
                  "type": ":list",
                  "items": [
                    { "type": ":float", "value": "1.5" },
                    { "type": ":float", "value": "2" },
                    { "type": ":float", "value": "2.5" }
                  ]
                },
                "shortRange": {
                  "type": ":list",
                  "items": [
                    { "type": ":integer", "value": "1" },
                    { "type": ":integer", "value": "2" },
                    { "type": ":integer", "value": "3" }
                  ]
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
