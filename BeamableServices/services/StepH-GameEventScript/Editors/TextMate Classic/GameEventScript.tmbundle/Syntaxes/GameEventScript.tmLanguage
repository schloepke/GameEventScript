<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>$schema</key>
	<string>https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json</string>
	<key>fileTypes</key>
	<array>
		<string>ges</string>
		<string>gescript</string>
		<string>gameeventscript</string>
		<string>es</string>
	</array>
	<key>firstLineMatch</key>
	<string>^\s*module\s+[A-Za-z_][A-Za-z0-9_]*\b</string>
	<key>name</key>
	<string>GameEventScript</string>
	<key>patterns</key>
	<array>
		<dict>
			<key>include</key>
			<string>#comments</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#strings</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#declarations</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#messages</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#selectors</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#extensions-and-types</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#constants</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#numbers</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#keywords</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#operators</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#labels</string>
		</dict>
	</array>
	<key>repository</key>
	<dict>
		<key>comments</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>//.*$</string>
					<key>name</key>
					<string>comment.line.double-slash.gameeventscript</string>
				</dict>
			</array>
		</dict>
		<key>constants</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>\b(?:true|false)\b</string>
					<key>name</key>
					<string>constant.language.boolean.gameeventscript</string>
				</dict>
				<dict>
					<key>match</key>
					<string>:(?:infinity|negativeinfinity|nan|pi|e|euler|tau|phi)\b|[∞∏ℇτφ]</string>
					<key>name</key>
					<string>constant.language.tag.numeric.gameeventscript</string>
				</dict>
			</array>
		</dict>
		<key>declarations</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>captures</key>
					<dict>
						<key>1</key>
						<dict>
							<key>name</key>
							<string>keyword.control.module.gameeventscript</string>
						</dict>
						<key>2</key>
						<dict>
							<key>name</key>
							<string>entity.name.namespace.gameeventscript</string>
						</dict>
					</dict>
					<key>match</key>
					<string>\b(module)\s+([A-Za-z_][A-Za-z0-9_]*)\b</string>
					<key>name</key>
					<string>meta.module.gameeventscript</string>
				</dict>
				<dict>
					<key>captures</key>
					<dict>
						<key>1</key>
						<dict>
							<key>name</key>
							<string>storage.type.record.gameeventscript</string>
						</dict>
						<key>2</key>
						<dict>
							<key>name</key>
							<string>entity.name.type.record.gameeventscript</string>
						</dict>
					</dict>
					<key>match</key>
					<string>\b(record)\s+([A-Za-z_][A-Za-z0-9_]*)\b</string>
					<key>name</key>
					<string>meta.record.gameeventscript</string>
				</dict>
				<dict>
					<key>captures</key>
					<dict>
						<key>1</key>
						<dict>
							<key>name</key>
							<string>storage.type.function.gameeventscript</string>
						</dict>
						<key>2</key>
						<dict>
							<key>name</key>
							<string>entity.name.function.gameeventscript</string>
						</dict>
					</dict>
					<key>match</key>
					<string>\b(function)\s+([A-Za-z_][A-Za-z0-9_]*)\b</string>
					<key>name</key>
					<string>meta.function.gameeventscript</string>
				</dict>
				<dict>
					<key>captures</key>
					<dict>
						<key>1</key>
						<dict>
							<key>name</key>
							<string>storage.type.predicate.gameeventscript</string>
						</dict>
						<key>2</key>
						<dict>
							<key>name</key>
							<string>entity.name.function.predicate.gameeventscript</string>
						</dict>
					</dict>
					<key>match</key>
					<string>\b(predicate)\s+([A-Za-z_][A-Za-z0-9_]*)\b</string>
					<key>name</key>
					<string>meta.predicate.gameeventscript</string>
				</dict>
				<dict>
					<key>captures</key>
					<dict>
						<key>1</key>
						<dict>
							<key>name</key>
							<string>keyword.control.handler.gameeventscript</string>
						</dict>
						<key>2</key>
						<dict>
							<key>name</key>
							<string>entity.name.function.handler.gameeventscript</string>
						</dict>
					</dict>
					<key>match</key>
					<string>\b(on)\s+(@?[A-Za-z_][A-Za-z0-9_]*)\b</string>
					<key>name</key>
					<string>meta.handler.gameeventscript</string>
				</dict>
				<dict>
					<key>captures</key>
					<dict>
						<key>1</key>
						<dict>
							<key>name</key>
							<string>storage.type.variable.gameeventscript</string>
						</dict>
						<key>2</key>
						<dict>
							<key>name</key>
							<string>variable.other.local.gameeventscript</string>
						</dict>
					</dict>
					<key>match</key>
					<string>\b(let)\s+([A-Za-z_][A-Za-z0-9_]*)\b</string>
					<key>name</key>
					<string>meta.variable.let.gameeventscript</string>
				</dict>
			</array>
		</dict>
		<key>extensions-and-types</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>:tag\b</string>
					<key>name</key>
					<string>entity.other.attribute-name.tag.gameeventscript</string>
				</dict>
				<dict>
					<key>match</key>
					<string>:(?:nothing|text|boolean|uuid|integer|float|number|percentage|degree|meter|second|vector|point|optional|series|range|message|handler|envelope|ref|list|map|set|dice)\b</string>
					<key>name</key>
					<string>support.type.primitive.gameeventscript</string>
				</dict>
				<dict>
					<key>match</key>
					<string>:(?:integer\.(?:floor|ceil|truncate|halfEven|halfUp|halfDown)|degree\.(?:wrap|toRadians|fromRadians)|math\.[A-Za-z_][A-Za-z0-9_]*|series\.[A-Za-z_][A-Za-z0-9_]*)\b</string>
					<key>name</key>
					<string>support.function.standard.gameeventscript</string>
				</dict>
				<dict>
					<key>match</key>
					<string>:(?:chance|abs|ln|sqrt|cbrt|random|dice)\b</string>
					<key>name</key>
					<string>support.function.prefix.gameeventscript</string>
				</dict>
				<dict>
					<key>match</key>
					<string>:[A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)?\b</string>
					<key>name</key>
					<string>entity.name.type.custom.gameeventscript</string>
				</dict>
			</array>
		</dict>
		<key>keywords</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>\b(?:if|else|for|in|from|to|when|otherwise|matching|without|with)\b</string>
					<key>name</key>
					<string>keyword.control.gameeventscript</string>
				</dict>
				<dict>
					<key>match</key>
					<string>\b(?:as|be|means|computed|by|clamped|between|of|weighted|ascending|descending|first|last|highest|lowest|pair|straight|full|house|at)\b</string>
					<key>name</key>
					<string>keyword.other.definition.gameeventscript</string>
				</dict>
				<dict>
					<key>match</key>
					<string>\b(?:or|xor|and|not|is|has|empty|starts|ends|div|mod|rem)\b</string>
					<key>name</key>
					<string>keyword.operator.word.gameeventscript</string>
				</dict>
				<dict>
					<key>match</key>
					<string>\b(?:emit|publish)\b</string>
					<key>name</key>
					<string>keyword.control.emit.gameeventscript</string>
				</dict>
			</array>
		</dict>
		<key>labels</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>\b[A-Za-z_][A-Za-z0-9_]*(?=\s*:)</string>
					<key>name</key>
					<string>variable.parameter.label.gameeventscript</string>
				</dict>
				<dict>
					<key>match</key>
					<string>\b[A-Za-z_][A-Za-z0-9_]*\b</string>
					<key>name</key>
					<string>variable.other.gameeventscript</string>
				</dict>
				<dict>
					<key>match</key>
					<string>_</string>
					<key>name</key>
					<string>variable.language.placeholder.gameeventscript</string>
				</dict>
			</array>
		</dict>
		<key>messages</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>captures</key>
					<dict>
						<key>1</key>
						<dict>
							<key>name</key>
							<string>keyword.control.emit.gameeventscript</string>
						</dict>
						<key>2</key>
						<dict>
							<key>name</key>
							<string>entity.name.type.class.message.gameeventscript</string>
						</dict>
					</dict>
					<key>match</key>
					<string>\b(emit|publish)\s+([A-Z][A-Za-z0-9_]*)\b</string>
					<key>name</key>
					<string>meta.message.dispatch.gameeventscript</string>
				</dict>
				<dict>
					<key>match</key>
					<string>\b[A-Z][A-Za-z0-9_]*\b</string>
					<key>name</key>
					<string>entity.name.type.class.message.gameeventscript</string>
				</dict>
			</array>
		</dict>
		<key>numbers</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>\b\d(?:[\d_]*\d)?d\d(?:[\d_]*\d)?\b</string>
					<key>name</key>
					<string>constant.numeric.dice.gameeventscript</string>
				</dict>
				<dict>
					<key>match</key>
					<string>\b\d(?:[\d_]*\d)?(?:\.\d(?:[\d_]*\d)?)?%</string>
					<key>name</key>
					<string>constant.numeric.percentage.gameeventscript</string>
				</dict>
				<dict>
					<key>match</key>
					<string>\b\d(?:[\d_]*\d)?(?:\.\d(?:[\d_]*\d)?)?(?:m|s|°)\b?</string>
					<key>name</key>
					<string>constant.numeric.unit.gameeventscript</string>
				</dict>
				<dict>
					<key>match</key>
					<string>\b\d(?:[\d_]*\d)?(?:\.\d(?:[\d_]*\d)?)?\b</string>
					<key>name</key>
					<string>constant.numeric.gameeventscript</string>
				</dict>
			</array>
		</dict>
		<key>operators</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>=&gt;|-&gt;|[→⇒↦]</string>
					<key>name</key>
					<string>keyword.operator.arrow.gameeventscript</string>
				</dict>
				<dict>
					<key>match</key>
					<string>=~|&lt;&gt;|&lt;=|&gt;=|=|&lt;|&gt;|[≤≥≠≈≅]</string>
					<key>name</key>
					<string>keyword.operator.comparison.gameeventscript</string>
				</dict>
				<dict>
					<key>match</key>
					<string>[!~&amp;|¬∧∨⊕∈∉]</string>
					<key>name</key>
					<string>keyword.operator.logical.gameeventscript</string>
				</dict>
				<dict>
					<key>match</key>
					<string>[+\-−*/·×÷⋅^²³]</string>
					<key>name</key>
					<string>keyword.operator.arithmetic.gameeventscript</string>
				</dict>
				<dict>
					<key>match</key>
					<string>[,;.]</string>
					<key>name</key>
					<string>punctuation.separator.gameeventscript</string>
				</dict>
				<dict>
					<key>match</key>
					<string>[(){}\[\]]</string>
					<key>name</key>
					<string>punctuation.bracket.gameeventscript</string>
				</dict>
			</array>
		</dict>
		<key>selectors</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>:(?:any|all|filter|has|take|drop|count|choose|draw|shuffle|reverse|sum|average|select|contains|sort|first|last|single|map|distinct|group|order|term)\b</string>
					<key>name</key>
					<string>support.function.selector.pipeline.gameeventscript</string>
				</dict>
			</array>
		</dict>
		<key>strings</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>begin</key>
					<string>'</string>
					<key>end</key>
					<string>'</string>
					<key>name</key>
					<string>string.quoted.single.gameeventscript</string>
					<key>patterns</key>
					<array>
						<dict>
							<key>match</key>
							<string>''</string>
							<key>name</key>
							<string>constant.character.escape.quote.gameeventscript</string>
						</dict>
					</array>
				</dict>
				<dict>
					<key>begin</key>
					<string>"</string>
					<key>end</key>
					<string>"</string>
					<key>name</key>
					<string>string.quoted.double.gameeventscript</string>
					<key>patterns</key>
					<array>
						<dict>
							<key>match</key>
							<string>""</string>
							<key>name</key>
							<string>constant.character.escape.quote.gameeventscript</string>
						</dict>
					</array>
				</dict>
			</array>
		</dict>
	</dict>
	<key>scopeName</key>
	<string>source.gameeventscript</string>
</dict>
</plist>
