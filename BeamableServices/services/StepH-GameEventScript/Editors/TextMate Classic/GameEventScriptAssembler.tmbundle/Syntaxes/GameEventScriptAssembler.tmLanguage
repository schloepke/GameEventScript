<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>$schema</key>
	<string>https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json</string>
	<key>name</key>
	<string>GameEventScript Assembler</string>
	<key>scopeName</key>
	<string>source.gameeventscript.assembler</string>
	<key>fileTypes</key>
	<array>
		<string>gesa</string>
	</array>
	<key>firstLineMatch</key>
	<string>^\s*\.gesb\b</string>
	<key>patterns</key>
	<array>
		<dict>
			<key>include</key>
			<string>#comments</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#strings</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#directives</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#opcodes</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#labels</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#operands</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#punctuation</string>
		</dict>
	</array>
	<key>repository</key>
	<dict>
		<key>comments</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>//.*$</string>
					<key>name</key>
					<string>comment.line.double-slash.gameeventscript.assembler</string>
				</dict>
			</array>
		</dict>
		<key>directives</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>captures</key>
					<dict>
						<key>1</key>
						<dict>
							<key>name</key>
							<string>keyword.control.directive.segment.gameeventscript.assembler</string>
						</dict>
						<key>2</key>
						<dict>
							<key>name</key>
							<string>support.type.bind-kind.gameeventscript.assembler</string>
						</dict>
					</dict>
					<key>match</key>
					<string>^\s*(\.segment)\s+(bind)\b</string>
					<key>name</key>
					<string>meta.directive.segment.gameeventscript.assembler</string>
				</dict>
				<dict>
					<key>captures</key>
					<dict>
						<key>1</key>
						<dict>
							<key>name</key>
							<string>keyword.control.directive.segment.gameeventscript.assembler</string>
						</dict>
						<key>2</key>
						<dict>
							<key>name</key>
							<string>entity.other.attribute-name.tag.gameeventscript</string>
						</dict>
					</dict>
					<key>match</key>
					<string>^\s*(\.segment)\s+(text|lists|code)\b</string>
					<key>name</key>
					<string>meta.directive.segment.gameeventscript.assembler</string>
				</dict>
				<dict>
					<key>match</key>
					<string>(?&lt;!\S)\.(?:gesb|module|flags|text|u16|registers|texts|bind)\b</string>
					<key>name</key>
					<string>keyword.control.directive.gameeventscript.assembler</string>
				</dict>
			</array>
		</dict>
		<key>labels</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>captures</key>
					<dict>
						<key>1</key>
						<dict>
							<key>name</key>
							<string>entity.name.label.gameeventscript.assembler</string>
						</dict>
					</dict>
					<key>match</key>
					<string>^\s*([A-Za-z_][A-Za-z0-9_]*):</string>
					<key>name</key>
					<string>meta.label.definition.gameeventscript.assembler</string>
				</dict>
				<dict>
					<key>match</key>
					<string>\b(?:L_\d+|L_none|T_[A-Za-z_][A-Za-z0-9_]*|T_\d+|U16_\d+|Args_\d+|Names_\d+|Keys_\d+|Shape_\d+|StdExt_\d+|Items_\d+|Values_\d+|Captures_\d+|Tags_\d+|Handler_[A-Za-z_][A-Za-z0-9_]*|Handler_\d+|Function_\d+|Predicate_\d+|Extension_\d+|Outbound_\d+|Record_\d+|ExternalType_\d+|Bind_\d+)\b</string>
					<key>name</key>
					<string>variable.other.label.reference.gameeventscript.assembler</string>
				</dict>
			</array>
		</dict>
		<key>opcodes</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>captures</key>
					<dict>
						<key>1</key>
						<dict>
							<key>name</key>
							<string>entity.name.label.gameeventscript.assembler</string>
						</dict>
						<key>2</key>
						<dict>
							<key>name</key>
							<string>comment.line.address.gameeventscript.assembler</string>
						</dict>
						<key>3</key>
						<dict>
							<key>name</key>
							<string>keyword.mnemonic.opcode.gameeventscript.assembler</string>
						</dict>
					</dict>
					<key>match</key>
						<string>^\s*(?:([A-Za-z_][A-Za-z0-9_]*):\s*)?(@\d{4,5}\b\s*)?(Nop|SlotLocals|Jump|JumpIfTrue|JumpIfFalse|JumpIfNotTrue|Call|CallStandard|CallExternal|ReturnVoid|ReturnValue|EmitMessage|EmitMessageWithTags|EmitMessageValue|EmitMessageValueWithTags|PublishMessage|PublishMessageWithTags|PublishMessageValue|PublishMessageValueWithTags|Cast|CastCustom|CastUnit|CastNumeric|CheckType|CheckCustomType|CheckUnit|CheckNumeric|CheckInteger|CheckFractional|MoveSlot|MemberAccess|IndexAccess|PropertyAccess|BindHandler|LoadNothing|LoadTrue|LoadFalse|LoadInteger|LoadFloat|LoadPercentage|LoadText|LoadTag|LoadHandler|LoadMessage|StageRegister|StageNothing|StageTrue|StageFalse|StageInteger|StageFloat|StageText|StageTag|StagePercentage|CreateDice|CreateVector|CreatePoint|CreateList|CreateMap|CreateRange|CreateRangeWithStep|CreateRangeIterator|CreateRangeIteratorWithStep|CreateRangeIteratorShort|CreateRecord|CreateExternalType|HasValue|IsEmpty|Default|Or|And|Xor|Implies|Not|Equal|NotEqual|Less|Greater|LessOrEqual|GreaterOrEqual|Add|Subtract|Multiply|Divide|Power|IntegerDivide|Modulo|Remainder|Min|Max|Negate|Abs|LogN|Chance|Clamp|RandomTake|RandomPush|RandomPushConstant|RandomPop|Term|TakeFirst|DropFirst|TakeLast|DropLast|Length|StartsWith|EndsWith|Contains|ContainsValue|Union|Intersect|Zip|KeysOfMap|ValuesOfMap|EntriesOfMap|StreamCreate|StreamNext|StreamClose|StreamMap|StreamFilter|StreamCount|StreamSum|StreamAverage|StreamMin|StreamMax|StreamCollectList|StreamCollectMap|StreamCollectMapValue|StreamCollectFirst|StreamCollectLast|StreamCollectSingle|PipelineHasAny|PipelineHasAll|PipelineContainsSingle|PipelineContainsAny|PipelineContainsAll|PipelineDistinct|PipelineDistinctBy|PipelineGroupBy|PipelineReverse|PipelineSortAscending|PipelineSortDescending|PipelineOrderByAscending|PipelineOrderByDescending|PipelineTakeHighest|PipelineTakeLowest|PipelineDropHighest|PipelineDropLowest|PipelineShuffle|PipelineDraw|PipelineChoose|PipelineChooseRandom|PipelineChooseWeighted|PipelineDicePatternCountAny|PipelineDicePatternCountFace|PipelineDicePatternFullHouse|PipelineDicePatternStraight|PipelineTakePatternCountAny|PipelineTakePatternCountFace|PipelineTakePatternFullHouse|PipelineTakePatternStraight|PipelineListCreateBuilder|PipelineListBuilderAdd|PipelineListBuilderFinish)\b</string>
					<key>name</key>
					<string>meta.instruction.gameeventscript.assembler</string>
				</dict>
			</array>
		</dict>
		<key>operands</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>\br\d+\b</string>
					<key>name</key>
					<string>variable.other.register.gameeventscript.assembler</string>
				</dict>
				<dict>
					<key>match</key>
					<string>#[+-]?(?:\d+(?:\.\d+)?(?:[eE][+-]?\d+)?|Infinity|-Infinity|NaN)\b</string>
					<key>name</key>
					<string>constant.numeric.immediate.gameeventscript.assembler</string>
				</dict>
				<dict>
					<key>captures</key>
					<dict>
						<key>1</key>
						<dict>
							<key>name</key>
							<string>keyword.other.unit-prefix.gameeventscript.assembler</string>
						</dict>
						<key>2</key>
						<dict>
							<key>name</key>
							<string>entity.other.attribute-name.tag.gameeventscript</string>
						</dict>
					</dict>
					<key>match</key>
					<string>\b(unit)(:(?:none|degree|meter|second))\b</string>
				</dict>
				<dict>
					<key>match</key>
					<string>\b(?:Nothing|Boolean|Integer|Float|Percentage|Tag|Text|Vector|Point|Range|Handler|Message|List|Dice|Map|ListBuilder|Stream|Series|Custom|Invalid)\b</string>
					<key>name</key>
					<string>support.type.bytecode.gameeventscript.assembler</string>
				</dict>
				<dict>
					<key>match</key>
					<string>\b(?:MessageHandler|MessageNameHandler|Function|Predicate|ExtensionCall|OutboundMessage|Record|ExternalType)\b</string>
					<key>name</key>
					<string>support.type.bind-kind.gameeventscript.assembler</string>
				</dict>
				<dict>
					<key>match</key>
					<string>\b(?:optimization|debug|none|NormalizeResultAsPredicate)\b</string>
					<key>name</key>
					<string>constant.language.flag.gameeventscript.assembler</string>
				</dict>
			</array>
		</dict>
		<key>punctuation</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>[\[\](),:]</string>
					<key>name</key>
					<string>punctuation.separator.gameeventscript.assembler</string>
				</dict>
				<dict>
					<key>match</key>
					<string>=</string>
					<key>name</key>
					<string>keyword.operator.assignment.gameeventscript.assembler</string>
				</dict>
			</array>
		</dict>
		<key>strings</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>begin</key>
					<string>"</string>
					<key>end</key>
					<string>"</string>
					<key>name</key>
					<string>string.quoted.double.gameeventscript.assembler</string>
					<key>patterns</key>
					<array>
						<dict>
							<key>match</key>
							<string>\\(?:["\\/bfnrt]|u[0-9A-Fa-f]{4})</string>
							<key>name</key>
							<string>constant.character.escape.gameeventscript.assembler</string>
						</dict>
					</array>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
