{
  "version": 1,
  "name": "RuntimePredicatesFunctions",
  "tests": [
    {
      "kind": "scriptApi",
      "name": "predicates and functions are reusable in expressions and collections",
      "script": "predicate wounded(_ unit) be unit.hp < unit.maxHp\nfunction woundedUnits(_ units) be units[:filter unit where unit is wounded]\n\non Start(unit, units) {\n  let byCall be wounded(unit)\n  let byPredicate be unit is wounded\n  let woundedList be woundedUnits(units)\n  emit Done(byCall: byCall, byPredicate: byPredicate, woundedCount: :len woundedList, first: woundedList[1].name, second: woundedList[2].name)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {
              "unit": {
                "type": ":map",
                "entries": {
                  "name": {
                    "type": ":text",
                    "value": "Ada"
                  },
                  "hp": {
                    "type": ":integer",
                    "value": "2"
                  },
                  "maxHp": {
                    "type": ":integer",
                    "value": "5"
                  }
                }
              },
              "units": {
                "type": ":list",
                "items": [
                  {
                    "type": ":map",
                    "entries": {
                      "name": {
                        "type": ":text",
                        "value": "Ada"
                      },
                      "hp": {
                        "type": ":integer",
                        "value": "2"
                      },
                      "maxHp": {
                        "type": ":integer",
                        "value": "5"
                      }
                    }
                  },
                  {
                    "type": ":map",
                    "entries": {
                      "name": {
                        "type": ":text",
                        "value": "Bert"
                      },
                      "hp": {
                        "type": ":integer",
                        "value": "4"
                      },
                      "maxHp": {
                        "type": ":integer",
                        "value": "4"
                      }
                    }
                  },
                  {
                    "type": ":map",
                    "entries": {
                      "name": {
                        "type": ":text",
                        "value": "Cara"
                      },
                      "hp": {
                        "type": ":integer",
                        "value": "1"
                      },
                      "maxHp": {
                        "type": ":integer",
                        "value": "3"
                      }
                    }
                  }
                ]
              }
            }
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "byCall": {
                  "type": ":boolean",
                  "value": true
                },
                "byPredicate": {
                  "type": ":boolean",
                  "value": true
                },
                "woundedCount": {
                  "type": ":integer",
                  "value": "2"
                },
                "first": {
                  "type": ":text",
                  "value": "Ada"
                },
                "second": {
                  "type": ":text",
                  "value": "Cara"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "predicates and functions are lenient when expected keys are missing",
      "script": "predicate wounded(_ unit) be unit.hp < unit.maxHp\nfunction woundedUnits(_ units) be units[:filter unit where unit is wounded]\n\non Start(unit, units) {\n  let byCall be wounded(unit)\n  let byPredicate be unit is wounded\n  let woundedList be woundedUnits(units)\n  emit Done(byCall: byCall, byPredicate: byPredicate, woundedCount: :len woundedList)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {
              "unit": {
                "type": ":map",
                "entries": {
                  "name": {
                    "type": ":text",
                    "value": "NoHp"
                  }
                }
              },
              "units": {
                "type": ":list",
                "items": [
                  {
                    "type": ":map",
                    "entries": {
                      "name": {
                        "type": ":text",
                        "value": "NoHp"
                      }
                    }
                  },
                  {
                    "type": ":map",
                    "entries": {
                      "name": {
                        "type": ":text",
                        "value": "Healthy"
                      },
                      "hp": {
                        "type": ":integer",
                        "value": "5"
                      },
                      "maxHp": {
                        "type": ":integer",
                        "value": "5"
                      }
                    }
                  }
                ]
              }
            }
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "byCall": {
                  "type": ":nothing"
                },
                "byPredicate": {
                  "type": ":nothing"
                },
                "woundedCount": {
                  "type": ":integer",
                  "value": "0"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "is operations support inline negation",
      "script": "predicate high(_ value) be value > 3\n\non Start(value) {\n  emit Done(byWord: value is not high, byBang: value is !high, byType: value is not :text, byEmpty: value is not empty, byCompare: value is not 3 or less)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {
              "value": {
                "type": ":integer",
                "value": "2"
              }
            }
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "byWord": {
                  "type": ":boolean",
                  "value": true
                },
                "byBang": {
                  "type": ":boolean",
                  "value": true
                },
                "byType": {
                  "type": ":boolean",
                  "value": true
                },
                "byEmpty": {
                  "type": ":boolean",
                  "value": true
                },
                "byCompare": {
                  "type": ":boolean",
                  "value": false
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "comparison phrases cover strict and inclusive bounds",
      "script": "on Start(value) {\n  emit Done(lessThan: value is less than 10, moreThan: value is more than 10, orLess: value is 9 or less, orMore: value is 9 or more, atMost: value is at most 9, atLeast: value is at least 9)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {
              "value": {
                "type": ":integer",
                "value": "9"
              }
            }
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "lessThan": {
                  "type": ":boolean",
                  "value": true
                },
                "moreThan": {
                  "type": ":boolean",
                  "value": false
                },
                "orLess": {
                  "type": ":boolean",
                  "value": true
                },
                "orMore": {
                  "type": ":boolean",
                  "value": true
                },
                "atMost": {
                  "type": ":boolean",
                  "value": true
                },
                "atLeast": {
                  "type": ":boolean",
                  "value": true
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "predicates accept typed boolean record fields",
      "script": "record :unit as {\n  alive: :boolean,\n  hidden: :boolean\n}\n\npredicate targetable(_ unit as :unit) be unit.alive and not unit.hidden\n\non Start(unit) {\n  emit Done(targetable: unit is targetable)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {
              "unit": {
                "type": ":map",
                "entries": {
                  "alive": {
                    "type": ":boolean",
                    "value": true
                  },
                  "hidden": {
                    "type": ":boolean",
                    "value": false
                  }
                }
              }
            }
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "targetable": {
                  "type": ":boolean",
                  "value": true
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "predicates allow explicit boolean coercion while functions keep original value",
      "script": "predicate numericPredicate(_ value) be value * 2 as :boolean\nfunction numericSelect(_ value) be value * 2\n\non Start {\n  let byPredicateCallTwo be numericPredicate(2)\n  let byPredicateCallZero be numericPredicate(0)\n  let byFunction be numericSelect(2)\n  let byPredicateOperator be 2 is numericPredicate\n  emit Done(byPredicateCallTwo: byPredicateCallTwo, byPredicateCallZero: byPredicateCallZero, byFunction: byFunction, byPredicateOperator: byPredicateOperator)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "byPredicateCallTwo": {
                  "type": ":boolean",
                  "value": true
                },
                "byPredicateCallZero": {
                  "type": ":boolean",
                  "value": false
                },
                "byFunction": {
                  "type": ":integer",
                  "value": "4"
                },
                "byPredicateOperator": {
                  "type": ":boolean",
                  "value": true
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "multi argument predicates can be called directly",
      "script": "predicate higher(left, right) be left > right\n\non Start(left, right) {\n  emit Done(ok: higher(left: left, right: right), reversed: higher(left: right, right: left))\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {
              "left": {
                "type": ":integer",
                "value": "7"
              },
              "right": {
                "type": ":integer",
                "value": "4"
              }
            }
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "ok": {
                  "type": ":boolean",
                  "value": true
                },
                "reversed": {
                  "type": ":boolean",
                  "value": false
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "typed handler callable and record parameters coerce inputs",
      "script": "record :gauge as {\n  current: :number\n}\n\npredicate high(value as :number) be value > 2\nfunction boosted(_ value as :number) be value + 1\n\non Start(value as :number, hp as :gauge) {\n  emit Done(handlerValue: value + 1, ok: value is high, boosted: boosted(value), current: hp.current)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {
              "value": {
                "type": ":float",
                "value": "2"
              },
              "hp": {
                "type": ":map",
                "entries": {
                  "current": {
                    "type": ":float",
                    "value": "4"
                  }
                }
              }
            }
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "handlerValue": {
                  "type": ":integer",
                  "value": "3"
                },
                "ok": {
                  "type": ":boolean",
                  "value": false
                },
                "boosted": {
                  "type": ":integer",
                  "value": "3"
                },
                "current": {
                  "type": ":integer",
                  "value": "4"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "multiple modules share predicate function and type definitions",
      "scripts": [
        {
          "sourceName": "shared.es",
          "text": "module Shared\nrecord :gauge as {\n  current: :number,\n  maximum: :number\n}\n\npredicate wounded(_ unit) be unit.hp < unit.maxHp\nfunction woundedUnits(_ units) be units[:filter unit where unit is wounded]"
        },
        {
          "sourceName": "runtime.es",
          "text": "module Runtime\non Start(unit, units) {\n  let hp as :gauge be [current: unit.hp, maximum: unit.maxHp]\n  let anyWounded be wounded(unit)\n  let candidates be woundedUnits(units)\n  emit Done(anyWounded: anyWounded, candidateCount: :len candidates, maximum: hp.maximum)\n}"
        }
      ],
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {
              "unit": {
                "type": ":map",
                "entries": {
                  "hp": {
                    "type": ":integer",
                    "value": "2"
                  },
                  "maxHp": {
                    "type": ":integer",
                    "value": "5"
                  }
                }
              },
              "units": {
                "type": ":list",
                "items": [
                  {
                    "type": ":map",
                    "entries": {
                      "hp": {
                        "type": ":integer",
                        "value": "2"
                      },
                      "maxHp": {
                        "type": ":integer",
                        "value": "5"
                      }
                    }
                  },
                  {
                    "type": ":map",
                    "entries": {
                      "hp": {
                        "type": ":integer",
                        "value": "5"
                      },
                      "maxHp": {
                        "type": ":integer",
                        "value": "5"
                      }
                    }
                  }
                ]
              }
            }
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "anyWounded": {
                  "type": ":boolean",
                  "value": true
                },
                "candidateCount": {
                  "type": ":integer",
                  "value": "1"
                },
                "maximum": {
                  "type": ":integer",
                  "value": "5"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
