{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GameEventScript Document",
  "scopeName": "source.gameeventscript.document",
  "fileTypes": [
    "gesd"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#forms"
    },
    {
      "include": "#keys"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.gameeventscript.document"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.gameeventscript.document",
          "applyEndPatternLast": true,
          "patterns": [
            {
              "match": "''",
              "name": "constant.character.escape.quote.gameeventscript.document"
            }
          ]
        },
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.gameeventscript.document",
          "applyEndPatternLast": true,
          "patterns": [
            {
              "match": "\"\"",
              "name": "constant.character.escape.quote.gameeventscript.document"
            }
          ]
        }
      ]
    },
    "forms": {
      "patterns": [
        {
          "match": ":Schema\\b",
          "name": "keyword.other.declaration.schema.gameeventscript.document"
        },
        {
          "match": "(:(?:Message|Handler))\\s*(\\()\\s*([A-Z][A-Za-z0-9]*(?:_[A-Z][A-Za-z0-9]*)*)\\b",
          "captures": {
            "1": {
              "name": "support.type.primitive.gameeventscript.document"
            },
            "2": {
              "name": "punctuation.bracket.gameeventscript.document"
            },
            "3": {
              "name": "entity.name.type.class.message.gameeventscript.document"
            }
          }
        },
        {
          "match": "(:Series)\\s*(\\()\\s*(fibonacci|factorial)\\b",
          "captures": {
            "1": {
              "name": "support.type.primitive.gameeventscript.document"
            },
            "2": {
              "name": "punctuation.bracket.gameeventscript.document"
            },
            "3": {
              "name": "support.function.series.gameeventscript.document"
            }
          }
        },
        {
          "match": "\\b(fibonacci|factorial)\\b(?!\\s*:)",
          "name": "support.function.series.gameeventscript.document"
        },
        {
          "match": ":(?:Nothing|Number|Percentage|Boolean|Text|Tag|List|Map|Dice|Bytes|Vector|Point|Range|Series|Message|Handler|Record)\\b",
          "name": "support.type.primitive.gameeventscript.document"
        },
        {
          "match": ":[A-Z][A-Za-z0-9]*(?:_[A-Z][A-Za-z0-9]*)*",
          "name": "entity.name.type.record.gameeventscript.document"
        }
      ]
    },
    "keys": {
      "patterns": [
        {
          "match": "\\b([a-z][A-Za-z0-9]*|_)[ \\t]*(?=:(?![A-Za-z]))",
          "captures": {
            "1": {
              "name": "support.type.property-name.gameeventscript.document"
            }
          }
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "match": "\\b(?:true|false)\\b",
          "name": "constant.language.boolean.gameeventscript.document"
        },
        {
          "match": "\\bnothing\\b",
          "name": "constant.language.nothing.gameeventscript.document"
        },
        {
          "match": "\\bwith\\b",
          "name": "keyword.operator.word.gameeventscript.document"
        },
        {
          "match": "#[A-Za-z0-9_]+",
          "name": "entity.name.tag.gameeventscript.document"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "[+-]?(?:Infinity|NaN)\\b",
          "name": "constant.numeric.gameeventscript.document"
        },
        {
          "match": "[+-]?(?:\\d[\\d_]*(?:\\.\\d[\\d_]*)?|\\.\\d[\\d_]*)(?:[eE][+-]?\\d+)?(?:%|[^\\s,\\[\\]()/]*(?:/[^\\s,\\[\\]()/]+)*)?",
          "name": "constant.numeric.gameeventscript.document"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": "[\\[\\]()]",
          "name": "punctuation.bracket.gameeventscript.document"
        },
        {
          "match": "[,:]",
          "name": "punctuation.separator.gameeventscript.document"
        }
      ]
    }
  }
}
