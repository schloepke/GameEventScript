                "hand_1": {
                  "type": ":integer",
                  "value": "4"
                },
                "hand_2": {
                  "type": ":integer",
                  "value": "3"
                },
                "hand_3": {
                  "type": ":integer",
                  "value": "5"
                },
                "rest_1": {
                  "type": ":integer",
                  "value": "1"
                },
                "rest_2": {
                  "type": ":integer",
                  "value": "2"
                },
                "random_1": {
                  "type": ":text",
                  "value": "Orc"
                },
                "random_2": {
                  "type": ":text",
                  "value": "Knight"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "reversed random bounds and unordered collection draws stay lenient",
      "script": "on Roll(min, max) {\n  let value be :random from min to max\n  let tags be :set['alpha', 'beta', 'gamma']\n  let shuffledTags be tags[:shuffle]\n  let drawnTag be tags[:draw 1]\n  emit Done(valuePresent: value has value, shuffledTags: shuffledTags, drawnTag: drawnTag)\n}",
      "steps": [
        {
          "input": {
            "name": "Roll",
            "args": {
              "min": {
                "type": ":integer",
                "value": "9"
              },
              "max": {
                "type": ":integer",
                "value": "2"
              }
            }
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "valuePresent": {
                  "type": ":boolean",
                  "value": true
                },
                "shuffledTags": {
                  "type": ":nothing"
                },
                "drawnTag": {
                  "type": ":nothing"
                }
              }
            }
          ]
        }
      ]
    },
    {
