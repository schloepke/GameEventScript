{
  "version": 1,
  "name": "RuntimeAtomicStreamCore",
  "level": "atomic",
  "tests": [
    {
      "kind": "scriptApi",
      "name": "stream create next close over source kinds",
      "script": "module AtomicStreamCreateNextClose\non Start {\n  let values be [1, 2, 3]\n  let dice as :dice be [6, 4, 2]\n  let text be 'abc'\n  let tags be :boss\n  let map be [a: 1, b: 2]\n  let range as :range be from 1 to 4\n  let fromRange be range[:select item => item * 2]\n  let fromList be values[:select item => item + 10]\n  let fromDice be dice[:select item => item]\n  let fromText be text[:select item => item]\n  let fromTag be tags[:select item => item]\n  let fromMap be map[:select item => item]\n  let fromEmptyList be [][:select item => item]\n  emit Done(fromRange: fromRange, fromList: fromList, fromDice: fromDice, fromText: fromText, fromTag: fromTag, fromMap: fromMap, fromEmptyList: fromEmptyList)\n}",
      "steps": [
        {
          "input": { "name": "Start", "args": {} },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "fromDice": {
                  "type": ":list",
                  "items": [
                    { "type": ":integer", "value": "6" },
                    { "type": ":integer", "value": "4" },
                    { "type": ":integer", "value": "2" }
                  ]
                },
                "fromEmptyList": {
                  "type": ":list",
                  "items": []
                },
                "fromList": {
                  "type": ":list",
                  "items": [
                    { "type": ":integer", "value": "11" },
                    { "type": ":integer", "value": "12" },
                    { "type": ":integer", "value": "13" }
                  ]
                },
                "fromMap": {
                  "type": ":list",
                  "items": [
                    { "type": ":integer", "value": "1" },
                    { "type": ":integer", "value": "2" }
                  ]
                },
                "fromRange": {
                  "type": ":list",
                  "items": [
                    { "type": ":integer", "value": "2" },
                    { "type": ":integer", "value": "4" },
                    { "type": ":integer", "value": "6" },
                    { "type": ":integer", "value": "8" }
                  ]
                },
                "fromTag": {
                  "type": ":list",
                  "items": [
                    { "type": ":text", "value": "b" },
                    { "type": ":text", "value": "o" },
                    { "type": ":text", "value": "s" },
                    { "type": ":text", "value": "s" }
                  ]
                },
                "fromText": {
                  "type": ":list",
                  "items": [
                    { "type": ":text", "value": "a" },
                    { "type": ":text", "value": "b" },
                    { "type": ":text", "value": "c" }
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "stream map filter collect list chains",
      "script": "module AtomicStreamMapFilterCollectList\non Start {\n  let values be [1, 2, 3, 4, 5]\n  let mapped be values[:select value => value * 10]\n  let filtered be values[:filter value where value mod 2 = 1]\n  let chained be values[:filter value where value >= 2][:select value => value * 2][:filter value where value > 5]\n  let capturedBase be 100\n  let captured be values[:select value => value + capturedBase]\n  emit Done(mapped: mapped, filtered: filtered, chained: chained, captured: captured)\n}",
      "steps": [
        {
          "input": { "name": "Start", "args": {} },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "captured": {
                  "type": ":list",
                  "items": [
                    { "type": ":integer", "value": "101" },
                    { "type": ":integer", "value": "102" },
                    { "type": ":integer", "value": "103" },
                    { "type": ":integer", "value": "104" },
                    { "type": ":integer", "value": "105" }
                  ]
                },
                "chained": {
                  "type": ":list",
                  "items": [
                    { "type": ":integer", "value": "6" },
                    { "type": ":integer", "value": "8" },
                    { "type": ":integer", "value": "10" }
                  ]
                },
                "filtered": {
                  "type": ":list",
                  "items": [
                    { "type": ":integer", "value": "1" },
                    { "type": ":integer", "value": "3" },
                    { "type": ":integer", "value": "5" }
                  ]
                },
                "mapped": {
                  "type": ":list",
                  "items": [
                    { "type": ":integer", "value": "10" },
                    { "type": ":integer", "value": "20" },
                    { "type": ":integer", "value": "30" },
                    { "type": ":integer", "value": "40" },
                    { "type": ":integer", "value": "50" }
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "stream take and drop direct slices",
      "script": "module AtomicStreamTakeDropDirectSlices\non Start {\n  let values be [1, 2, 3, 4, 5]\n  emit Done(takeFirst: values[:filter value where value > 1][:take first 2], dropFirst: values[:filter value where value > 1][:drop first 2], takeLast: values[:filter value where value > 1][:take last 2], dropLast: values[:filter value where value > 1][:drop last 2], takeHighest: values[:filter value where value > 1][:take highest 2], takeLowest: values[:filter value where value > 1][:take lowest 2], dropHighest: values[:filter value where value > 1][:drop highest 2], dropLowest: values[:filter value where value > 1][:drop lowest 2], mappedTakeFirst: values[:select value => value * 10][:take first 2])\n}",
      "steps": [
        {
          "input": { "name": "Start", "args": {} },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "dropFirst": {
                  "type": ":list",
                  "items": [
                    { "type": ":integer", "value": "4" },
                    { "type": ":integer", "value": "5" }
                  ]
                },
                "dropLast": {
                  "type": ":list",
                  "items": [
                    { "type": ":integer", "value": "2" },
                    { "type": ":integer", "value": "3" }
                  ]
                },
                "dropHighest": {
                  "type": ":list",
                  "items": [
                    { "type": ":integer", "value": "2" },
                    { "type": ":integer", "value": "3" }
                  ]
                },
                "dropLowest": {
                  "type": ":list",
                  "items": [
                    { "type": ":integer", "value": "4" },
                    { "type": ":integer", "value": "5" }
                  ]
                },
                "mappedTakeFirst": {
                  "type": ":list",
                  "items": [
                    { "type": ":integer", "value": "10" },
                    { "type": ":integer", "value": "20" }
                  ]
                },
                "takeFirst": {
                  "type": ":list",
                  "items": [
                    { "type": ":integer", "value": "2" },
                    { "type": ":integer", "value": "3" }
                  ]
                },
                "takeHighest": {
                  "type": ":list",
                  "items": [
                    { "type": ":integer", "value": "5" },
                    { "type": ":integer", "value": "4" }
                  ]
                },
                "takeLast": {
                  "type": ":list",
                  "items": [
                    { "type": ":integer", "value": "4" },
                    { "type": ":integer", "value": "5" }
                  ]
                },
                "takeLowest": {
                  "type": ":list",
                  "items": [
                    { "type": ":integer", "value": "2" },
                    { "type": ":integer", "value": "3" }
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "stream collect map and map value",
      "script": "module AtomicStreamCollectMap\non Start {\n  let units be [[id: :rook, hp: 10, team: :blue], [id: :mage, hp: 6, team: :red], [id: :rook, hp: 12, team: :green], [id: '', hp: 99, team: :hidden]]\n  let byId be units[:map unit by unit.id]\n  let hpById be units[:map unit by unit.id => unit.hp]\n  emit Done(byIdCount: :len byId, rookHp: byId[:rook].hp, rookTeam: byId[:rook].team, mageHp: byId[:mage].hp, hpByIdCount: :len hpById, hpRook: hpById[:rook], hpMage: hpById[:mage], missingEmpty: byId[''])\n}",
      "steps": [
        {
          "input": { "name": "Start", "args": {} },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "byIdCount": { "type": ":integer", "value": "2" },
                "hpByIdCount": { "type": ":integer", "value": "2" },
                "hpMage": { "type": ":integer", "value": "6" },
                "hpRook": { "type": ":integer", "value": "12" },
                "mageHp": { "type": ":integer", "value": "6" },
                "missingEmpty": { "type": ":nothing" },
                "rookHp": { "type": ":integer", "value": "12" },
                "rookTeam": { "type": ":tag", "value": "green" }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "first last single direct and streams",
      "script": "module AtomicFirstLastSingle\non Start {\n  let values be [1, 2, 3, 4]\n  let emptyList be []\n  let dice as :dice be [6, 4, 2]\n  let range as :range be from 1 to 3\n  let text be 'ab'\n  let map be [a: 1, b: 2]\n  emit Done(first: values[:first], firstFiltered: values[:first value where value > 2], firstEmpty: emptyList[:first], last: values[:last], lastFiltered: values[:last value where value < 4], lastEmpty: emptyList[:last], single: values[:single value where value = 3], singleNone: values[:single value where value > 9], singleMany: values[:single value where value > 1], diceFirst: dice[:first], diceLast: dice[:last], rangeFirst: range[:first], rangeLast: range[:last], textFirst: text[:first], textLast: text[:last], textSingle: 'x'[:single], mapFirst: map[:first], mapLast: map[:last], listSingle: [9][:single])\n}",
      "steps": [
        {
          "input": { "name": "Start", "args": {} },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "first": { "type": ":integer", "value": "1" },
                "diceFirst": { "type": ":integer", "value": "6" },
                "diceLast": { "type": ":integer", "value": "2" },
                "firstEmpty": { "type": ":nothing" },
                "firstFiltered": { "type": ":integer", "value": "3" },
                "last": { "type": ":integer", "value": "4" },
                "lastEmpty": { "type": ":nothing" },
                "lastFiltered": { "type": ":integer", "value": "3" },
                "listSingle": { "type": ":integer", "value": "9" },
                "mapFirst": { "type": ":integer", "value": "1" },
                "mapLast": { "type": ":integer", "value": "2" },
                "rangeFirst": { "type": ":integer", "value": "1" },
                "rangeLast": { "type": ":integer", "value": "3" },
                "single": { "type": ":integer", "value": "3" },
                "singleMany": { "type": ":nothing" },
                "singleNone": { "type": ":nothing" },
                "textFirst": { "type": ":text", "value": "a" },
                "textLast": { "type": ":text", "value": "b" },
                "textSingle": { "type": ":text", "value": "x" }
              }
            }
          ]
        }
      ]
    }
  ]
}
