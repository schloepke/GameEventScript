{
  "version": 1,
  "name": "RuntimeExtensionsSequences",
  "tests": [
    {
      "kind": "scriptApi",
      "name": "extensions support unary variadic labeled and predicate calls",
      "script": "on Start(value, heading, target) {\n  let values be of 10 and 20 and 30\n  let floored be floor value\n  let flooredCall be floor(value)\n  let floorPredicate be nothing\n  let maxed be max of 2 and 8 and 5\n  let turnA be :nav.shortestTurn from: heading to: target\n  let turnB be :nav.shortestTurn(from: heading, to: target)\n  let northA be heading is :nav.isNorth\n  let northB be :nav.isNorth heading\n  let vectorTotal be :test.vectorSum :vector(1m, 2m, 3m)\n  let asList as :list be of 10 and 20 and 30\n  emit Done(floored: floored, flooredCall: flooredCall, floorPredicate: floorPredicate, maxed: maxed, turnA: turnA, turnB: turnB, northA: northA, northB: northB, vectorTotal: vectorTotal, valuesIsList: values is :list, valuesLen: values[:count], list_2: asList[2])\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {
              "value": {
                "type": ":float",
                "value": "10.75"
              },
              "heading": {
                "type": ":float",
                "value": "350",
                "unit": ":degree"
              },
              "target": {
                "type": ":float",
                "value": "10",
                "unit": ":degree"
              }
            }
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "floored": {
                  "type": ":float",
                  "value": "10"
                },
                "flooredCall": {
                  "type": ":float",
                  "value": "10"
                },
                "floorPredicate": {
                  "type": ":nothing"
                },
                "maxed": {
                  "type": ":float",
                  "value": "8"
                },
                "turnA": {
                  "type": ":float",
                  "value": "20",
                  "unit": ":degree"
                },
                "turnB": {
                  "type": ":float",
                  "value": "20",
                  "unit": ":degree"
                },
                "northA": {
                  "type": ":boolean",
                  "value": true
                },
                "northB": {
                  "type": ":boolean",
                  "value": true
                },
                "vectorTotal": {
                  "type": ":float",
                  "value": "6",
                  "unit": ":meter"
                },
                "valuesIsList": {
                  "type": ":boolean",
                  "value": true
                },
                "valuesLen": {
                  "type": ":integer",
                  "value": "3"
                },
                "list_2": {
                  "type": ":integer",
                  "value": "20"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "built-in series support term take drop and first term coercion",
      "script": "on Start() {\n  let fib be series fibonacci\n  let fact be series factorial\n  let naturals be from 0 to 9\n  let odd be from 1 to 9 step 2\n  let dropped be fib[:drop first 5]\n  emit Done(fibIsSeries: fib is :series, droppedIsSeries: dropped is :series, noLookup: fib[1], seriesLen: fib[:count], badTerm: fib[:term 'x'], takeLast: fib[:take last 2], dropLast: fib[:drop last 1], filterNothing: fib[:filter item where true], bareFirst: fib as :number, naturalZero: naturals[1], naturalThree: naturals[4], oddFourth: odd[5], fibZero: fib[:term 0], fibOne: fib[:term 1], fibSeven: fib[:term 7], droppedZero: dropped[:term 0], factZero: fact[:term 0], factFive: fact[:term 5], firstNaturals: naturals[:take first 4], firstOdd: odd[:take first 3])\n}",
      "steps": [
        {
          "input": {
            "name": "Start"
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "fibIsSeries": {
                  "type": ":boolean",
                  "value": true
                },
                "droppedIsSeries": {
                  "type": ":boolean",
                  "value": true
                },
                "noLookup": {
                  "type": ":nothing"
                },
                "seriesLen": {
                  "type": ":nothing"
                },
                "badTerm": {
                  "type": ":nothing"
                },
                "takeLast": {
                  "type": ":nothing"
                },
                "dropLast": {
                  "type": ":nothing"
                },
                "filterNothing": {
                  "type": ":nothing"
                },
                "bareFirst": {
                  "type": ":integer",
                  "value": "0"
                },
                "naturalZero": {
                  "type": ":integer",
                  "value": "0"
                },
                "naturalThree": {
                  "type": ":integer",
                  "value": "3"
                },
                "oddFourth": {
                  "type": ":integer",
                  "value": "9"
                },
                "fibZero": {
                  "type": ":integer",
                  "value": "0"
                },
                "fibOne": {
                  "type": ":integer",
                  "value": "1"
                },
                "fibSeven": {
                  "type": ":integer",
                  "value": "13"
                },
                "droppedZero": {
                  "type": ":integer",
                  "value": "5"
                },
                "factZero": {
                  "type": ":integer",
                  "value": "1"
                },
                "factFive": {
                  "type": ":integer",
                  "value": "120"
                },
                "firstNaturals": {
                  "type": ":range",
                  "from": "0",
                  "to": "3",
                  "step": "1"
                },
                "firstOdd": {
                  "type": ":range",
                  "from": "1",
                  "to": "5",
                  "step": "2"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
