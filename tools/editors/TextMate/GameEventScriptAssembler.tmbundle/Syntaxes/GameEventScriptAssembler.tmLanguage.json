{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GameEventScript Assembler",
  "scopeName": "source.gameeventscript.assembler",
  "fileTypes": [
    "gesa"
  ],
  "firstLineMatch": "^\\s*\\.gesb\\b",
  "foldingStartMarker": "^\\s*\\.region(?:\\s|$)",
  "foldingStopMarker": "^\\s*\\.region-end(?:\\s|$)",
  "patterns": [
    {
      "include": "#embedded-source"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#opcodes"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#operands"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "embedded-source": {
      "patterns": [
        {
          "begin": "^\\s*(\\.segment)\\s+(source)\\s+(\"(?:\\\\.|[^\"\\\\])*\")\\s*$",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.segment.gameeventscript.assembler"
            },
            "2": {
              "name": "entity.other.attribute-name.tag.gameeventscript"
            },
            "3": {
              "name": "string.quoted.double.source-name.gameeventscript.assembler"
            }
          },
          "contentName": "meta.embedded.block.gameeventscript.assembler",
          "end": "^(?=\\s*\\.(?:region-end|segment)\\b)",
          "name": "meta.embedded.source.gameeventscript.assembler",
          "patterns": [
            {
              "include": "source.gameeventscript"
            }
          ]
        },
        {
          "begin": "^\\s*(\\.source-line)\\s+(\"(?:\\\\.|[^\"\\\\])*\")\\s+(\\d+)\\s+(\\|)\\s?",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.source.gameeventscript.assembler"
            },
            "2": {
              "name": "string.quoted.double.source-name.gameeventscript.assembler"
            },
            "3": {
              "name": "constant.numeric.line.gameeventscript.assembler"
            },
            "4": {
              "name": "punctuation.separator.embedded.gameeventscript.assembler"
            }
          },
          "contentName": "meta.embedded.line.gameeventscript.assembler",
          "end": "$",
          "name": "meta.embedded.source-line.gameeventscript.assembler",
          "patterns": [
            {
              "include": "source.gameeventscript"
            }
          ]
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.gameeventscript.assembler"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "match": "^\\s*\\.region\\s+\"(?:\\\\.|[^\"\\\\])*\"\\s*$",
          "name": "comment.line.region.begin.gameeventscript.assembler"
        },
        {
          "match": "^\\s*\\.region-end\\s+\"(?:\\\\.|[^\"\\\\])*\"\\s*$",
          "name": "comment.line.region.end.gameeventscript.assembler"
        },
        {
          "captures": {
            "1": {
              "name": "keyword.control.directive.gameeventscript.assembler"
            },
            "2": {
              "name": "constant.numeric.version.gameeventscript.assembler"
            }
          },
          "match": "^\\s*(\\.(?:gesb|program-version))\\s+(\\d+)\\b",
          "name": "meta.directive.version.gameeventscript.assembler"
        },
        {
          "captures": {
            "1": {
              "name": "keyword.control.directive.segment.gameeventscript.assembler"
            },
            "2": {
              "name": "entity.other.attribute-name.tag.gameeventscript"
            }
          },
          "match": "^\\s*(\\.segment)\\s+(text|lists|bind|code)\\b",
          "name": "meta.directive.segment.gameeventscript.assembler"
        },
        {
          "match": "(?<!\\S)\\.(?:gesb|module|program-version|text|u16|registers|texts|bind)\\b",
          "name": "keyword.control.directive.gameeventscript.assembler"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "captures": {
            "1": {
              "name": "entity.name.label.gameeventscript.assembler"
            }
          },
          "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*):",
          "name": "meta.label.definition.gameeventscript.assembler"
        },
        {
          "match": "\\b(?:L_\\d+|L_none|T_[A-Za-z_][A-Za-z0-9_]*|T_\\d+|U16_\\d+|Args_\\d+|Names_\\d+|Keys_\\d+|Shape_\\d+|StdExt_\\d+|Items_\\d+|Values_\\d+|Captures_\\d+|Tags_\\d+|(?:Handler|Function|Predicate|Extension|Outbound|Record|ExternalType|Bind)_(?:[A-Za-z_][A-Za-z0-9_]*|\\d+)|(?:function|predicate|record)_[A-Za-z_][A-Za-z0-9_]*|[A-Za-z_][A-Za-z0-9_]*_\\d+)\\b",
          "name": "variable.other.label.reference.gameeventscript.assembler"
        }
      ]
    },
    "opcodes": {
      "patterns": [
        {
          "captures": {
            "1": {
              "name": "entity.name.label.gameeventscript.assembler"
            },
            "2": {
              "name": "comment.line.address.gameeventscript.assembler"
            },
            "3": {
              "name": "keyword.mnemonic.opcode.gameeventscript.assembler"
            }
          },
          "match": "^\\s*(?:([A-Za-z_][A-Za-z0-9_]*):\\s*)?(@\\d{4,5}\\b\\s*)?(Nop|RegisterLocals|Jump|JumpIfTrue|JumpIfFalse|JumpIfNotTrue|JumpIfNothing|Call|CreateSeries|CallExternal|ReturnVoid|ReturnValue|EmitMessage|EmitMessageWithTags|EmitMessageValue|EmitMessageValueWithTags|PublishMessage|PublishMessageWithTags|PublishMessageValue|PublishMessageValueWithTags|Cast|CastCustom|CastUnit|CastNumeric|CheckType|CheckCustomType|CheckUnit|CheckNumeric|CheckInteger|CheckFractional|Move|MemberAccess|IndexAccess|PropertyAccess|BindHandler|LoadNothing|LoadTrue|LoadFalse|LoadInteger|LoadFloat|LoadPercentage|LoadText|LoadTag|LoadHandler|LoadMessage|StageRegister|StageNothing|StageTrue|StageFalse|StageInteger|StageFloat|StageText|StageTag|StagePercentage|CreateDice|CreateVector|CreatePoint|CreateList|CreateMap|CreateRange|CreateRangeWithStep|CreateRangeIterator|CreateRangeIteratorWithStep|CreateRangeIteratorShort|CreateRecord|CreateRecordValue|CreateExternalType|HasValue|IsEmpty|Default|Or|And|Xor|Implies|Not|Equal|NotEqual|Less|Greater|LessOrEqual|GreaterOrEqual|Add|Subtract|Multiply|Divide|Power|IntegerDivide|Modulo|Remainder|Min|Max|Negate|Abs|LogN|Chance|Clamp|RandomTake|RandomTakeFloat|RandomPush|RandomPushConstant|RandomPop|Term|Exp|Floor|Ceil|Truncate|RoundHalfEven|RoundHalfUp|RoundHalfDown|DegreeToRadians|DegreeFromRadians|WrapDegree|Sin|Cos|Tan|Asin|Acos|Atan|Atan2|Hypot2D|Hypot3D|Distance|Distance2D|Distance3D|DistanceSquared|DistanceSquared2D|DistanceSquared3D|LengthSquared|LengthSquared2D|LengthSquared3D|Normalize|Normalize2D|Normalize3D|Dot|Dot2D|Dot3D|Cross|Cross2D|Cross3D|AngleBetween|AngleBetween2D|AngleBetween3D|TakeFirst|DropFirst|TakeLast|DropLast|TakeHighest|TakeLowest|DropHighest|DropLowest|OneRandom|TakeRandom|OneWeighted|TakeWeighted|Count|StartsWith|EndsWith|Contains|ContainsAny|ContainsAll|HasAny|HasAll|ContainsValue|Union|Intersect|Zip|KeysOfMap|ValuesOfMap|EntriesOfMap|First|Last|Single|IteratorCreate|IteratorCreateOrJump|IteratorNext|IteratorClose|MapBuilderCreate|MapBuilderAdd|MapBuilderFinish|DistinctBuilderCreate|DistinctBuilderAdd|DistinctBuilderFinish|GroupBuilderCreate|GroupBuilderAdd|GroupBuilderFinish|OrderBuilderCreate|OrderBuilderAdd|OrderBuilderFinishAscending|OrderBuilderFinishDescending|Distinct|SortAscending|SortDescending|Reverse|Shuffle|ListBuilderCreate|ListBuilderAdd|ListBuilderFinish|HasPattern|TakePattern|ParseLiteral)\\b",
          "name": "meta.instruction.gameeventscript.assembler"
        }
      ]
    },
    "operands": {
      "patterns": [
        {
          "captures": {
            "1": {
              "name": "variable.other.register.gameeventscript.assembler"
            },
            "2": {
              "name": "punctuation.definition.annotation.begin.gameeventscript.assembler"
            },
            "3": {
              "name": "constant.other.symbol.gameeventscript.assembler"
            },
            "4": {
              "name": "punctuation.definition.annotation.end.gameeventscript.assembler"
            }
          },
          "match": "\\b(r\\d+)(\\()([A-Za-z_][A-Za-z0-9_]*|_)(\\))",
          "name": "meta.register.symbolic.gameeventscript.assembler"
        },
        {
          "match": "\\br\\d+\\b",
          "name": "variable.other.register.gameeventscript.assembler"
        },
        {
          "match": "#[+-]?(?:\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?|Infinity|-Infinity|NaN)\\b",
          "name": "constant.numeric.immediate.gameeventscript.assembler"
        },
        {
          "captures": {
            "1": {
              "name": "keyword.other.unit-prefix.gameeventscript.assembler"
            },
            "2": {
              "name": "entity.other.attribute-name.tag.gameeventscript"
            }
          },
          "match": "\\b(unit)(:(?:none|degree|meter|second))\\b"
        },
        {
          "match": "\\b(?:Nothing|Boolean|Integer|Float|Percentage|Tag|Text|Vector|Point|Range|Handler|Message|List|Dice|Map|ListBuilder|MapBuilder|DistinctBuilder|GroupBuilder|OrderBuilder|Iterator|Series|Custom)\\b",
          "name": "support.type.bytecode.gameeventscript.assembler"
        },
        {
          "match": "\\b(?:MessageHandler|MessageNameHandler|Function|Predicate|ExtensionCall|OutboundMessage|Record|ExternalType)\\b",
          "name": "support.type.bind-kind.gameeventscript.assembler"
        },
        {
          "match": "\\bNormalizeResultAsPredicate\\b",
          "name": "constant.language.flag.gameeventscript.assembler"
        },
        {
          "match": "\\b(?:CountAny|CountFace|FullHouse|Straight|Fibonacci|Factorial|none)\\b",
          "name": "constant.language.gameeventscript.assembler"
        },
        {
          "match": "\\b(?:id|name|args|entry|requiredTags|excludedTags|flags)\\b(?=\\s*=)",
          "name": "variable.parameter.attribute.gameeventscript.assembler"
        },
        {
          "match": "(?<![#A-Za-z0-9_])\\d+\\b",
          "name": "constant.numeric.gameeventscript.assembler"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": "[\\[\\](),:]",
          "name": "punctuation.separator.gameeventscript.assembler"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.gameeventscript.assembler"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.gameeventscript.assembler",
          "patterns": [
            {
              "match": "\\\\(?:[\"\\\\/bfnrt]|u[0-9A-Fa-f]{4})",
              "name": "constant.character.escape.gameeventscript.assembler"
            }
          ]
        }
      ]
    }
  }
}
