    {
      "kind": "scriptApi",
      "name": "static emit and publish variants",
      "script": "module AtomicEmitPublishStatic\non Start {\n  let tags be [#radio, #command, #radio]\n  emit LocalZero\n  emit LocalTagged(value: 1) with #local, #visible, #local\n  publish OutZero\n  publish OutTagged(value: 2, kind: #fire) with tags\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": []
          },
          "expectedPublished": [
            {
              "name": "LocalZero",
              "args": []
            },
            {
              "name": "LocalTagged",
              "tags": [
                "local",
                "visible"
              ],
              "args": [
                {
                  "name": "value",
                  "value": {
                    "type": ":integer",
                    "value": "1"
                  }
                }
              ]
            },
            {
              "name": "OutZero",
              "args": []
            },
            {
              "name": "OutTagged",
              "tags": [
                "radio",
                "command"
              ],
              "args": [
                {
                  "name": "value",
                  "value": {
                    "type": ":integer",
                    "value": "2"
                  }
                },
                {
                  "name": "kind",
                  "value": {
                    "type": ":tag",
                    "value": "fire"
                  }
                }
              ]
            }
          ],
          "expectedOutboundPublished": [
            {
              "name": "OutZero",
              "args": []
            },
            {
              "name": "OutTagged",
              "tags": [
                "radio",
                "command"
              ],
              "args": [
                {
                  "name": "value",
                  "value": {
                    "type": ":integer",
                    "value": "2"
                  }
                },
                {
                  "name": "kind",
                  "value": {
                    "type": ":tag",
                    "value": "fire"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
