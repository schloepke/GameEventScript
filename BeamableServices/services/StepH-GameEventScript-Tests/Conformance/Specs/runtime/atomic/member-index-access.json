    {
      "kind": "scriptApi",
      "name": "custom record member and index access",
      "script": "module AtomicCustomRecordAccess\nrecord :unit as {\n  name: :text,\n  hp: :number\n}\n\non Start {\n  let value be :unit(name: 'Ada', hp: 10)\n  emit Done(memberName: value.name, memberMissing: value.missing, indexText: value['name'], indexTag: value[:hp], indexMissing: value[:missing], indexOut: value[1], isUnit: value is :unit)\n}",
      "steps": [
        {
          "input": { "name": "Start", "args": {} },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "memberName": { "type": ":text", "value": "Ada" },
                "memberMissing": { "type": ":nothing" },
                "indexText": { "type": ":text", "value": "Ada" },
                "indexTag": { "type": ":integer", "value": "10" },
                "indexMissing": { "type": ":nothing" },
                "indexOut": { "type": ":nothing" },
                "isUnit": { "type": ":boolean", "value": true }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "dynamic property access selectors",
      "script": "module AtomicDynamicPropertyAccess\non Start {\n  let listValue be [10, 20, 30]\n  let mapValue be [name: 'Ada', hp: 10]\n  let vectorValue be :vector(1m, 2m, 3m)\n  let pointValue be :point(4m, 5m, 6m)\n  let textValue be 'ab'\n  let indexKey be 2\n  let textKey be 'name'\n  let tagKey be :hp\n  let vectorKey be 'y'\n  let pointKey be :z\n  let invalidKey be true\n  emit Done(listDynamic: listValue[indexKey], mapText: mapValue[textKey], mapTag: mapValue[tagKey], vectorDynamic: vectorValue[vectorKey], pointDynamic: pointValue[pointKey], textDynamic: textValue[indexKey], invalidProperty: mapValue[invalidKey])\n}",
      "steps": [
        {
          "input": { "name": "Start", "args": {} },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "invalidProperty": { "type": ":nothing" },
                "listDynamic": { "type": ":integer", "value": "20" },
                "mapTag": { "type": ":integer", "value": "10" },
                "mapText": { "type": ":text", "value": "Ada" },
                "pointDynamic": { "type": ":integer", "unit": ":meter", "value": "6" },
                "textDynamic": { "type": ":text", "value": "b" },
                "vectorDynamic": { "type": ":integer", "unit": ":meter", "value": "2" }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "message member and index access",
      "script": "module AtomicMessageAccess\non Start {\n  emit Ping(amount: 7) with :radio\n}\n\non Ping as message {\n  emit Done(memberName: message.name, memberTag: message.tags[1], memberMissing: message.missing, indexName: message[:name], indexTag: message['tags'][1], indexMissing: message[:missing], indexOut: message[1])\n}",
      "steps": [
        {
          "input": { "name": "Start", "args": {} },
          "expectedPublished": [
            {
              "name": "Ping",
              "tags": [ "radio" ],
              "args": {
                "amount": { "type": ":integer", "value": "7" }
              }
            },
            {
              "name": "Done",
              "args": {
                "memberName": { "type": ":text", "value": "Ping" },
                "memberTag": { "type": ":tag", "value": "radio" },
                "memberMissing": { "type": ":nothing" },
                "indexName": { "type": ":text", "value": "Ping" },
                "indexTag": { "type": ":tag", "value": "radio" },
                "indexMissing": { "type": ":nothing" },
                "indexOut": { "type": ":nothing" }
              }
            }
          ]
        }
      ]
    }
  ]
}
