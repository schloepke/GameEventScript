{
  "version": 1,
  "name": "RuntimeHostDispatch",
  "tests": [
    {
      "kind": "scriptApi",
      "name": "published messages route to external subscribers",
      "script": "on Start(playerId) {\n  emit Notify(playerId: playerId, count: 3)\n}",
      "externalSubscribers": [
        {
          "message": "Notify",
          "parameters": [
            "playerId",
            "count"
          ],
          "emit": [
            {
              "name": "ExternalSeen",
              "forwardArguments": true
            }
          ]
        }
      ],
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": [
              {
                "name": "playerId",
                "value": {
                  "type": ":text",
                  "value": "p_1"
                }
              }
            ]
          },
          "expectedPublished": [
            {
              "name": "Notify",
              "args": [
                {
                  "name": "playerId",
                  "value": {
                    "type": ":text",
                    "value": "p_1"
                  }
                },
                {
                  "name": "count",
                  "value": {
                    "type": ":integer",
                    "value": "3"
                  }
                }
              ]
            },
            {
              "name": "ExternalSeen",
              "args": [
                {
                  "name": "playerId",
                  "value": {
                    "type": ":text",
                    "value": "p_1"
                  }
                },
                {
                  "name": "count",
                  "value": {
                    "type": ":integer",
                    "value": "3"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "equal priority preserves script then external registration order",
      "script": "on Start(value) {\n  emit Notify(value: value)\n}\n\non Notify(value) {\n  emit SeenByScript(value: value + 1)\n}",
      "externalSubscribers": [
        {
          "message": "Notify",
          "parameters": [
            "value"
          ],
          "emit": [
            {
              "name": "SeenByExternal",
              "args": [
                {
                  "name": "marker",
                  "value": {
                    "type": ":text",
                    "value": "external"
                  }
                }
              ]
            }
          ]
        }
      ],
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": [
              {
                "name": "value",
                "value": {
                  "type": ":float",
                  "value": "4"
                }
              }
            ]
          },
          "expectedPublished": [
            {
              "name": "Notify",
              "args": [
                {
                  "name": "value",
                  "value": {
                    "type": ":float",
                    "value": "4"
                  }
                }
              ]
            },
            {
              "name": "SeenByScript",
              "args": [
                {
                  "name": "value",
                  "value": {
                    "type": ":integer",
                    "value": "5"
                  }
                }
              ]
            },
            {
              "name": "SeenByExternal",
              "args": [
                {
                  "name": "marker",
                  "value": {
                    "type": ":text",
                    "value": "external"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "external subscribers keep registration order",
      "script": "on Start(value) {\n  emit Notify(value: value)\n}",
      "externalSubscribers": [
        {
          "message": "Notify",
          "parameters": [
            "value"
          ],
          "emit": [
            {
              "name": "ExternalFirst",
              "args": [
                {
                  "name": "order",
                  "value": {
                    "type": ":integer",
                    "value": "1"
                  }
                }
              ]
            }
          ]
        },
        {
          "message": "Notify",
          "parameters": [
            "value"
          ],
          "emit": [
            {
              "name": "ExternalSecond",
              "args": [
                {
                  "name": "order",
                  "value": {
                    "type": ":integer",
                    "value": "2"
                  }
                }
              ]
            }
          ]
        }
      ],
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": [
              {
                "name": "value",
                "value": {
                  "type": ":float",
                  "value": "4"
                }
              }
            ]
          },
          "expectedPublished": [
            {
              "name": "Notify",
              "args": [
                {
                  "name": "value",
                  "value": {
                    "type": ":float",
                    "value": "4"
                  }
                }
              ]
            },
            {
              "name": "ExternalFirst",
              "args": [
                {
                  "name": "order",
                  "value": {
                    "type": ":integer",
                    "value": "1"
                  }
                }
              ]
            },
            {
              "name": "ExternalSecond",
              "args": [
                {
                  "name": "order",
                  "value": {
                    "type": ":integer",
                    "value": "2"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "higher priority subscribers run first",
      "script": "on Start(value) {\n  emit Notify(value: value)\n}\n\non Notify(value) {\n  emit SeenByScript(value: value + 1)\n}",
      "externalSubscribers": [
        {
          "message": "Notify",
          "parameters": [
            "value"
          ],
          "priority": 10,
          "emit": [
            {
              "name": "SeenByExternal",
              "args": [
                {
                  "name": "marker",
                  "value": {
                    "type": ":text",
                    "value": "external"
                  }
                }
              ]
            }
          ]
        }
      ],
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": [
              {
                "name": "value",
                "value": {
                  "type": ":float",
                  "value": "4"
                }
              }
            ]
          },
          "expectedPublished": [
            {
              "name": "Notify",
              "args": [
                {
                  "name": "value",
                  "value": {
                    "type": ":float",
                    "value": "4"
                  }
                }
              ]
            },
            {
              "name": "SeenByExternal",
              "args": [
                {
                  "name": "marker",
                  "value": {
                    "type": ":text",
                    "value": "external"
                  }
                }
              ]
            },
            {
              "name": "SeenByScript",
              "args": [
                {
                  "name": "value",
                  "value": {
                    "type": ":integer",
                    "value": "5"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "failing external subscribers are ignored and later subscribers continue",
      "script": "on Start(value) {\n  emit Notify(value: value)\n}",
      "externalSubscribers": [
        {
          "message": "Notify",
          "parameters": [
            "value"
          ],
          "throw": true
        },
        {
          "message": "Notify",
          "parameters": [
            "value"
          ],
          "emit": [
            {
              "name": "ExternalOk",
              "forwardArguments": true
            }
          ]
        }
      ],
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": [
              {
                "name": "value",
                "value": {
                  "type": ":float",
                  "value": "4"
                }
              }
            ]
          },
          "expectedPublished": [
            {
              "name": "Notify",
              "args": [
                {
                  "name": "value",
                  "value": {
                    "type": ":float",
                    "value": "4"
                  }
                }
              ]
            },
            {
              "name": "ExternalOk",
              "args": [
                {
                  "name": "value",
                  "value": {
                    "type": ":float",
                    "value": "4"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "external subscribers emit follow up messages through same run",
      "script": "on Start(value) {\n  emit Notify(value: value)\n}\n\non Done(value) {\n  emit Final(value: value)\n}",
      "externalSubscribers": [
        {
          "message": "Notify",
          "parameters": [
            "value"
          ],
          "emit": [
            {
              "name": "Done",
              "forwardArguments": true
            }
          ]
        }
      ],
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": [
              {
                "name": "value",
                "value": {
                  "type": ":float",
                  "value": "2"
                }
              }
            ]
          },
          "expectedPublished": [
            {
              "name": "Notify",
              "args": [
                {
                  "name": "value",
                  "value": {
                    "type": ":float",
                    "value": "2"
                  }
                }
              ]
            },
            {
              "name": "Done",
              "args": [
                {
                  "name": "value",
                  "value": {
                    "type": ":float",
                    "value": "2"
                  }
                }
              ]
            },
            {
              "name": "Final",
              "args": [
                {
                  "name": "value",
                  "value": {
                    "type": ":float",
                    "value": "2"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "multiple loaded programs dispatch in load order",
      "programs": [
        {
          "sourceName": "first.ges",
          "text": "module FirstProgram\non Start { emit First }"
        },
        {
          "sourceName": "second.ges",
          "text": "module SecondProgram\non Start { emit Second }"
        }
      ],
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": []
          },
          "expectedPublished": [
            {
              "name": "First",
              "args": []
            },
            {
              "name": "Second",
              "args": []
            }
          ],
          "expectedOutboundPublished": []
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "initialization runs once for every loaded program instance",
      "programs": [
        {
          "sourceName": "first-init.ges",
          "text": "on initialization { emit FirstReady }"
        },
        {
          "sourceName": "second-init.ges",
          "text": "on initialization { emit SecondReady }"
        }
      ],
      "expectedInitializationPublished": [
        {
          "name": "FirstReady",
          "args": []
        },
        {
          "name": "SecondReady",
          "args": []
        }
      ],
      "expectedInitializationOutboundPublished": []
    },
    {
      "kind": "scriptApi",
      "name": "frame budget pauses and resumes one script handler",
      "script": "on Start { for item from 1 to 3 emit Tick(value: item) }",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": []
          },
          "opcodeBudget": 1,
          "expectedPaused": true,
          "expectedPublished": [
            {
              "name": "Tick",
              "args": [
                {
                  "name": "value",
                  "value": {
                    "type": ":integer",
                    "value": "1"
                  }
                }
              ]
            },
            {
              "name": "Tick",
              "args": [
                {
                  "name": "value",
                  "value": {
                    "type": ":integer",
                    "value": "2"
                  }
                }
              ]
            },
            {
              "name": "Tick",
              "args": [
                {
                  "name": "value",
                  "value": {
                    "type": ":integer",
                    "value": "3"
                  }
                }
              ]
            }
          ],
          "expectedOutboundPublished": []
        }
      ]
    }
  ]
}
