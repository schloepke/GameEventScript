function operation(items) be asm {
    .register iterator, item
    LoadInteger operation, 0
    IteratorCreate iterator, items
    next:
    IteratorNext item, iterator, done
    Add operation, operation, 1
    Jump next
    done:
    IteratorClose iterator
}
