{
  "version": 1,
  "name": "RuntimeRandomDiceRanges",
  "tests": [
    {
      "kind": "scriptApi",
      "name": "random and dice outcomes are deterministic with sequence",
      "script": "on Roll {\n  let a be :random 1 to 6\n  let b be :dice 4d6[:take highest 2]\n  emit Result(randomValue: a, diceValue: b)\n}",
      "randomSequence": [
        "4",
        "1",
        "6",
        "3",
        "5"
      ],
      "steps": [
        {
          "input": {
            "name": "Roll",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Result",
              "args": {
                "randomValue": {
                  "type": ":integer",
                  "value": "4"
                },
                "diceValue": {
                  "type": ":dice",
                  "rolls": [
                    6,
                    5
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "sequential steps share random sequence",
      "script": "on Roll {\n  let value be :dice 2d6\n  emit Rolled(value: value)\n}",
      "randomSequence": [
        "1",
        "6",
        "3",
        "2"
      ],
      "steps": [
        {
          "input": {
            "name": "Roll",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Rolled",
              "args": {
                "value": {
                  "type": ":dice",
                  "rolls": [
                    6,
                    1
                  ]
                }
              }
            }
          ]
        },
        {
          "input": {
            "name": "Roll",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Rolled",
              "args": {
                "value": {
                  "type": ":dice",
                  "rolls": [
                    3,
                    2
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "chance and weighted choices are deterministic",
      "script": "on Start(units) {\n  let alwaysHit be :chance 100%\n  let neverHit be :chance 0%\n  let quarterHit be :chance 25%\n  let weightedTarget be units[:choose 1 weighted by unit -> unit.weight]\n  let weightedPair be units[:choose 2 weighted by unit -> unit.weight]\n  emit Done(alwaysHit: alwaysHit, neverHit: neverHit, quarterHit: quarterHit, weightedTarget: weightedTarget.name, weighted_1: weightedPair[1].name, weighted_2: weightedPair[2].name)\n}",
      "randomSequence": [
        "0.249999",
        "9",
        "0",
        "8.99999"
      ],
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {
              "units": {
                "type": ":list",
                "items": [
                  {
                    "type": ":dictionary",
                    "entries": {
                      "name": {
                        "type": ":text",
                        "value": "A"
                      },
                      "weight": {
                        "type": ":integer",
                        "value": "1"
                      }
                    }
                  },
                  {
                    "type": ":dictionary",
                    "entries": {
                      "name": {
                        "type": ":text",
                        "value": "B"
                      },
                      "weight": {
                        "type": ":integer",
                        "value": "3"
                      }
                    }
                  },
                  {
                    "type": ":dictionary",
                    "entries": {
                      "name": {
                        "type": ":text",
                        "value": "C"
                      },
                      "weight": {
                        "type": ":integer",
                        "value": "6"
                      }
                    }
                  }
                ]
              }
            }
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "alwaysHit": {
                  "type": ":boolean",
                  "value": true
                },
                "neverHit": {
                  "type": ":boolean",
                  "value": false
                },
                "quarterHit": {
                  "type": ":boolean",
                  "value": true
                },
                "weightedTarget": {
                  "type": ":text",
                  "value": "C"
                },
                "weighted_1": {
                  "type": ":text",
                  "value": "A"
                },
                "weighted_2": {
                  "type": ":text",
                  "value": "C"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "shuffle draw choose and seeded random scopes are deterministic",
      "script": "on Start(enemies, seed) {\n  let cards be [1, 2, 3, 4, 5][:shuffle]\n  let hand be cards[:draw 3]\n  let restCards be cards[:drop first 3]\n  let target be enemies[:choose 1 enemy where enemy.alive]\n  let randomTargets be enemies[:choose 2 at random enemy where enemy.alive]\n  let seededFirst be :random with seed :list[:select item from 1 to 4 -> :random from 1 to 20]\n  let seededSecond be :random with seed :list[:select item from 1 to 4 -> :random from 1 to 20]\n  emit Done(hand_1: hand[1], hand_2: hand[2], hand_3: hand[3], rest_1: restCards[1], rest_2: restCards[2], target: target.name, random_1: randomTargets[1].name, random_2: randomTargets[2].name, seededSame: seededFirst = seededSecond)\n}",
      "randomSequence": [
        "1",
        "0",
        "1",
        "1",
        "0",
        "1"
      ],
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {
              "enemies": {
                "type": ":list",
                "items": [
                  {
                    "type": ":dictionary",
