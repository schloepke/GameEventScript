{
  "version": 1,
  "name": "RuntimeAtomicRandom",
  "level": "atomic",
  "tests": [
    {
      "kind": "scriptApi",
      "name": "random take integer and float opcode paths",
      "script": "module AtomicRandomTakeOpcodes\non Start {\n  let integerValue be random from 1 to 6\n  let floatValue be random from 0.0 to 1.0\n  let mixedValue be random from 1 to 2.0\n  let nothingValue be random from nothing to 6\n  emit Done(integerValue: integerValue, floatValue: floatValue, mixedValue: mixedValue, nothingValue: nothingValue)\n}",
      "randomSequence": [
        "4",
        "0.25",
        "1.5"
      ],
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": []
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": [
                {
                  "name": "integerValue",
                  "value": {
                    "type": ":integer",
                    "value": "4"
                  }
                },
                {
                  "name": "floatValue",
                  "value": {
                    "type": ":float",
                    "value": "0.25"
                  }
                },
                {
                  "name": "mixedValue",
                  "value": {
                    "type": ":float",
                    "value": "1.5"
                  }
                },
                {
                  "name": "nothingValue",
                  "value": {
                    "type": ":nothing"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "seeded random uses full int64 seed",
      "script": "module AtomicSeededRandomLong\non Start {\n  let value be random with 4294967297 (random from 1 to 1000000000000)\n  emit Done(value: value)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": []
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": [
                {
                  "name": "value",
                  "value": {
                    "type": ":integer",
                    "value": "820299227869"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "seeded random matches portable known answer vectors",
      "maxFloatUlps": 0,
      "script": "module AtomicSeededRandomKnownAnswers\non Start {\n  random with 0 {\n    emit Integers(a: random from -100 to 100, b: random from -100 to 100, c: random from -100 to 100, d: random from -100 to 100, e: random from -100 to 100, f: random from -100 to 100, g: random from -100 to 100, h: random from -100 to 100)\n  }\n  random with 0 {\n    emit Floats(a: random from 0.0 to 1.0, b: random from 0.0 to 1.0, c: random from 0.0 to 1.0, d: random from 0.0 to 1.0, e: random from 0.0 to 1.0)\n  }\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": []
          },
          "expectedPublished": [
            {
              "name": "Integers",
              "args": [
                {
                  "name": "a",
                  "value": {
                    "type": ":integer",
                    "value": "16"
                  }
                },
                {
                  "name": "b",
                  "value": {
                    "type": ":integer",
                    "value": "-95"
                  }
                },
                {
                  "name": "c",
                  "value": {
                    "type": ":integer",
                    "value": "-9"
                  }
                },
                {
                  "name": "d",
                  "value": {
                    "type": ":integer",
                    "value": "-45"
                  }
                },
                {
                  "name": "e",
                  "value": {
                    "type": ":integer",
                    "value": "-76"
                  }
                },
                {
                  "name": "f",
                  "value": {
                    "type": ":integer",
                    "value": "43"
                  }
                },
                {
                  "name": "g",
                  "value": {
                    "type": ":integer",
                    "value": "-62"
                  }
                },
                {
                  "name": "h",
                  "value": {
                    "type": ":integer",
                    "value": "-21"
                  }
                }
              ]
            },
            {
              "name": "Floats",
              "args": [
                {
                  "name": "a",
                  "value": {
                    "type": ":float",
                    "value": "0.6012629994179048"
                  }
                },
                {
                  "name": "b",
                  "value": {
                    "type": ":float",
                    "value": "0.7477740925472398"
                  }
                },
                {
                  "name": "c",
                  "value": {
                    "type": ":float",
                    "value": "0.10301998939503632"
                  }
                },
                {
                  "name": "d",
                  "value": {
                    "type": ":float",
                    "value": "0.4165890778296456"
                  }
                },
                {
                  "name": "e",
                  "value": {
                    "type": ":float",
                    "value": "0.7329967790569901"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "nested seeded random scopes restore each outer stream",
      "script": "module AtomicNestedSeededRandom\non Start {\n  random with 1 {\n    let outerFirst be random from 1 to 100\n    random with -1 {\n      let innerFirst be random from 1 to 100\n      random with 0 {\n        emit Deep(value: random from 1 to 100)\n      }\n      let innerSecond be random from 1 to 100\n      emit Inner(first: innerFirst, second: innerSecond)\n    }\n    let outerSecond be random from 1 to 100\n    emit Outer(first: outerFirst, second: outerSecond)\n  }\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": []
          },
          "expectedPublished": [
            {
              "name": "Deep",
              "args": [
                {
                  "name": "value",
                  "value": {
                    "type": ":integer",
                    "value": "21"
                  }
                }
              ]
            },
            {
              "name": "Inner",
              "args": [
                {
                  "name": "first",
                  "value": {
                    "type": ":integer",
                    "value": "93"
                  }
                },
                {
                  "name": "second",
                  "value": {
                    "type": ":integer",
                    "value": "70"
                  }
                }
              ]
            },
            {
              "name": "Outer",
              "args": [
                {
                  "name": "first",
                  "value": {
                    "type": ":integer",
                    "value": "58"
                  }
                },
                {
                  "name": "second",
                  "value": {
                    "type": ":integer",
                    "value": "23"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "random bounds swap collapse and round portably",
      "maxFloatUlps": 0,
      "script": "module AtomicRandomBounds\non Start {\n  let orderedInteger be random with 0 (random from -100 to 100)\n  let reversedInteger be random with 0 (random from 100 to -100)\n  let orderedFloat be random with 0 (random from -10.0 to 20.0)\n  let reversedFloat be random with 0 (random from 20.0 to -10.0)\n  let roundedUpperBound be random with 0 (random from 1.0 to 1.0000000000000002)\n  emit Done(equalInteger: random from 7 to 7, equalFloat: random from 3.5 to 3.5, orderedInteger: orderedInteger, reversedInteger: reversedInteger, orderedFloat: orderedFloat, reversedFloat: reversedFloat, roundedUpperBound: roundedUpperBound)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": []
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": [
                {
                  "name": "equalInteger",
                  "value": {
                    "type": ":integer",
                    "value": "7"
                  }
                },
                {
                  "name": "equalFloat",
                  "value": {
                    "type": ":float",
                    "value": "3.5"
                  }
                },
                {
                  "name": "orderedInteger",
                  "value": {
                    "type": ":integer",
                    "value": "16"
                  }
                },
                {
                  "name": "reversedInteger",
                  "value": {
                    "type": ":integer",
                    "value": "16"
                  }
                },
                {
                  "name": "orderedFloat",
                  "value": {
                    "type": ":float",
                    "value": "8.037889982537144"
                  }
                },
                {
                  "name": "reversedFloat",
                  "value": {
                    "type": ":float",
                    "value": "8.037889982537144"
                  }
                },
                {
                  "name": "roundedUpperBound",
                  "value": {
                    "type": ":float",
                    "value": "1.0000000000000002"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
