{
  "version": 1,
  "name": "RuntimeExtensionsSequences",
  "tests": [
    {
      "kind": "scriptApi",
      "name": "extensions support unary variadic labeled and predicate calls",
      "script": "on Start(value, heading, target) {\n  let floored be :math.floor value\n  let flooredCall be :math.floor(value)\n  let floorPredicate be value is :math.floor\n  let maxed be :math.max of 2 and 8 and 5\n  let turnA be :nav.shortestTurn from: heading to: target\n  let turnB be :nav.shortestTurn(from: heading, to: target)\n  let northA be heading is :nav.isNorth\n  let northB be :nav.isNorth heading\n  let vectorTotal be :test.vectorSum :vector(1m, 2m, 3m)\n  let seq be of 10 and 20 and 30\n  let asList as :list be of 10 and 20 and 30\n  emit Done(floored: floored, flooredCall: flooredCall, floorPredicate: floorPredicate, maxed: maxed, turnA: turnA, turnB: turnB, northA: northA, northB: northB, vectorTotal: vectorTotal, seqIsSequence: seq is :sequence, seqLen: :len seq, list_2: asList[2])\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {
              "value": {
                "type": ":float",
                "value": "10.75"
              },
              "heading": {
                "type": ":float",
                "value": "350",
                "unit": ":degree"
              },
              "target": {
                "type": ":float",
                "value": "10",
                "unit": ":degree"
              }
            }
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "floored": {
                  "type": ":float",
                  "value": "10"
                },
                "flooredCall": {
                  "type": ":float",
                  "value": "10"
                },
                "floorPredicate": {
                  "type": ":nothing"
                },
                "maxed": {
                  "type": ":float",
                  "value": "8"
                },
                "turnA": {
                  "type": ":float",
                  "value": "20",
                  "unit": ":degree"
                },
                "turnB": {
                  "type": ":float",
                  "value": "20",
                  "unit": ":degree"
                },
                "northA": {
                  "type": ":boolean",
                  "value": true
                },
                "northB": {
                  "type": ":boolean",
                  "value": true
                },
                "vectorTotal": {
                  "type": ":float",
                  "value": "6",
                  "unit": ":meter"
                },
                "seqIsSequence": {
                  "type": ":boolean",
                  "value": true
                },
                "seqLen": {
                  "type": ":integer",
                  "value": "3"
                },
                "list_2": {
                  "type": ":integer",
                  "value": "20"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "standard series support term take drop and first term coercion",
      "script": "on Start() {\n  let fib be :series.fibonacci()\n  let fact be :series.factorial()\n  let naturals be :series.natural()\n  let odd be :series.natural(start: 1, step: 2)\n  let dropped be fib[:drop first 5]\n  emit Done(fibIsSeries: fib is :series, droppedIsSeries: dropped is :series, noLookup: fib[1], seriesLen: :len fib, bareFirst: fib as :integer, naturalZero: naturals[:term 0], naturalThree: naturals[:term 3], oddFourth: odd[:term 4], fibZero: fib[:term 0], fibOne: fib[:term 1], fibSeven: fib[:term 7], droppedZero: dropped[:term 0], factZero: fact[:term 0], factFive: fact[:term 5], firstNaturals: naturals[:take first 4], firstOdd: odd[:take first 3])\n}",
      "steps": [
        {
          "input": {
            "name": "Start"
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "fibIsSeries": {
                  "type": ":boolean",
                  "value": true
                },
                "droppedIsSeries": {
                  "type": ":boolean",
                  "value": true
                },
                "noLookup": {
                  "type": ":nothing"
                },
                "seriesLen": {
                  "type": ":nothing"
                },
                "bareFirst": {
                  "type": ":integer",
                  "value": "0"
                },
                "naturalZero": {
                  "type": ":integer",
                  "value": "0"
                },
                "naturalThree": {
                  "type": ":integer",
                  "value": "3"
                },
                "oddFourth": {
                  "type": ":integer",
                  "value": "9"
                },
                "fibZero": {
                  "type": ":integer",
                  "value": "0"
                },
                "fibOne": {
                  "type": ":integer",
                  "value": "1"
                },
                "fibSeven": {
                  "type": ":integer",
                  "value": "13"
                },
                "droppedZero": {
                  "type": ":integer",
                  "value": "5"
                },
                "factZero": {
                  "type": ":integer",
                  "value": "1"
                },
                "factFive": {
                  "type": ":integer",
                  "value": "120"
                },
                "firstNaturals": {
                  "type": ":list",
                  "items": [
                    {
                      "type": ":integer",
                      "value": "0"
                    },
                    {
                      "type": ":integer",
                      "value": "1"
                    },
                    {
                      "type": ":integer",
                      "value": "2"
                    },
                    {
                      "type": ":integer",
                      "value": "3"
                    }
                  ]
                },
                "firstOdd": {
                  "type": ":list",
                  "items": [
                    {
                      "type": ":integer",
                      "value": "1"
                    },
                    {
                      "type": ":integer",
                      "value": "3"
                    },
                    {
                      "type": ":integer",
                      "value": "5"
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
