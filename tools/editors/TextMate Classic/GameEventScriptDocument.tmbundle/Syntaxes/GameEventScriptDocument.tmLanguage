<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>$schema</key>
	<string>https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json</string>
	<key>name</key>
	<string>GameEventScript Document</string>
	<key>scopeName</key>
	<string>source.gameeventscript.document</string>
	<key>fileTypes</key>
	<array>
		<string>gesd</string>
	</array>
	<key>patterns</key>
	<array>
		<dict>
			<key>include</key>
			<string>#comments</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#strings</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#forms</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#keys</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#constants</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#numbers</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#punctuation</string>
		</dict>
	</array>
	<key>repository</key>
	<dict>
		<key>comments</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>//.*$</string>
					<key>name</key>
					<string>comment.line.double-slash.gameeventscript.document</string>
				</dict>
			</array>
		</dict>
		<key>strings</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>begin</key>
					<string>'</string>
					<key>end</key>
					<string>'</string>
					<key>name</key>
					<string>string.quoted.single.gameeventscript.document</string>
					<key>applyEndPatternLast</key>
					<true/>
					<key>patterns</key>
					<array>
						<dict>
							<key>match</key>
							<string>''</string>
							<key>name</key>
							<string>constant.character.escape.quote.gameeventscript.document</string>
						</dict>
					</array>
				</dict>
				<dict>
					<key>begin</key>
					<string>"</string>
					<key>end</key>
					<string>"</string>
					<key>name</key>
					<string>string.quoted.double.gameeventscript.document</string>
					<key>applyEndPatternLast</key>
					<true/>
					<key>patterns</key>
					<array>
						<dict>
							<key>match</key>
							<string>""</string>
							<key>name</key>
							<string>constant.character.escape.quote.gameeventscript.document</string>
						</dict>
					</array>
				</dict>
			</array>
		</dict>
		<key>forms</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>:Schema\b</string>
					<key>name</key>
					<string>keyword.other.declaration.schema.gameeventscript.document</string>
				</dict>
				<dict>
					<key>match</key>
					<string>(:(?:Message|Handler))\s*(\()\s*([A-Z][A-Za-z0-9]*(?:_[A-Z][A-Za-z0-9]*)*|initialization|undeliverable)\b</string>
					<key>captures</key>
					<dict>
						<key>1</key>
						<dict>
							<key>name</key>
							<string>support.type.primitive.gameeventscript.document</string>
						</dict>
						<key>2</key>
						<dict>
							<key>name</key>
							<string>punctuation.bracket.gameeventscript.document</string>
						</dict>
						<key>3</key>
						<dict>
							<key>name</key>
							<string>entity.name.type.class.message.gameeventscript.document</string>
						</dict>
					</dict>
				</dict>
				<dict>
					<key>match</key>
					<string>(:Series)\s*(\()\s*(fibonacci|factorial)\b</string>
					<key>captures</key>
					<dict>
						<key>1</key>
						<dict>
							<key>name</key>
							<string>support.type.primitive.gameeventscript.document</string>
						</dict>
						<key>2</key>
						<dict>
							<key>name</key>
							<string>punctuation.bracket.gameeventscript.document</string>
						</dict>
						<key>3</key>
						<dict>
							<key>name</key>
							<string>support.function.series.gameeventscript.document</string>
						</dict>
					</dict>
				</dict>
				<dict>
					<key>match</key>
					<string>:(?:Nothing|Number|Percentage|Boolean|Text|Tag|List|Map|Dice|Bytes|Vector|Point|Range|Series|Message|Handler|Record)\b</string>
					<key>name</key>
					<string>support.type.primitive.gameeventscript.document</string>
				</dict>
				<dict>
					<key>match</key>
					<string>:[A-Z][A-Za-z0-9]*(?:_[A-Z][A-Za-z0-9]*)*</string>
					<key>name</key>
					<string>entity.name.type.record.gameeventscript.document</string>
				</dict>
			</array>
		</dict>
		<key>keys</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>\b([a-z][A-Za-z0-9]*|_)[ \t]*(?=:(?![A-Za-z]))</string>
					<key>captures</key>
					<dict>
						<key>1</key>
						<dict>
							<key>name</key>
							<string>support.type.property-name.gameeventscript.document</string>
						</dict>
					</dict>
				</dict>
			</array>
		</dict>
		<key>constants</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>\b(?:true|false)\b</string>
					<key>name</key>
					<string>constant.language.boolean.gameeventscript.document</string>
				</dict>
				<dict>
					<key>match</key>
					<string>\bnothing\b</string>
					<key>name</key>
					<string>constant.language.nothing.gameeventscript.document</string>
				</dict>
				<dict>
					<key>match</key>
					<string>\bwith\b</string>
					<key>name</key>
					<string>keyword.operator.word.gameeventscript.document</string>
				</dict>
				<dict>
					<key>match</key>
					<string>#[A-Za-z0-9_]+</string>
					<key>name</key>
					<string>entity.name.tag.gameeventscript.document</string>
				</dict>
			</array>
		</dict>
		<key>numbers</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>[+-]?(?:Infinity|NaN)\b</string>
					<key>name</key>
					<string>constant.numeric.gameeventscript.document</string>
				</dict>
				<dict>
					<key>match</key>
					<string>[+-]?(?:\d[\d_]*(?:\.\d[\d_]*)?|\.\d[\d_]*)(?:[eE][+-]?\d+)?(?:%|[^\s,\[\]()/]*(?:/[^\s,\[\]()/]+)*)?</string>
					<key>name</key>
					<string>constant.numeric.gameeventscript.document</string>
				</dict>
			</array>
		</dict>
		<key>punctuation</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>[\[\]()]</string>
					<key>name</key>
					<string>punctuation.bracket.gameeventscript.document</string>
				</dict>
				<dict>
					<key>match</key>
					<string>[,:]</string>
					<key>name</key>
					<string>punctuation.separator.gameeventscript.document</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
