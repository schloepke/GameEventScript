{
  "version": 1,
  "name": "RuntimeMessagesHandlers",
  "tests": [
    {
      "kind": "scriptApi",
      "name": "handler binding creates message values and publishable calls",
      "script": "module MessageBinding\non Start(unit, target) {\n  let shoot as :handler be Shoot(unit, target)\n  let msg as :message be shoot(unit: unit, target: target)\n  let isHandler be shoot is :handler\n  let isMessage be msg is :message\n  emit msg\n  emit shoot(unit: unit, target: target)\n  emit Shoot(unit: unit, target: target)\n  emit Done(isHandler: isHandler, isMessage: isMessage)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {
              "unit": {
                "type": ":text",
                "value": "u_1"
              },
              "target": {
                "type": ":text",
                "value": "t_1"
              }
            }
          },
          "expectedPublished": [
            {
              "name": "Shoot",
              "args": {
                "target": {
                  "type": ":text",
                  "value": "t_1"
                },
                "unit": {
                  "type": ":text",
                  "value": "u_1"
                }
              }
            },
            {
              "name": "Shoot",
              "args": {
                "target": {
                  "type": ":text",
                  "value": "t_1"
                },
                "unit": {
                  "type": ":text",
                  "value": "u_1"
                }
              }
            },
            {
              "name": "Shoot",
              "args": {
                "target": {
                  "type": ":text",
                  "value": "t_1"
                },
                "unit": {
                  "type": ":text",
                  "value": "u_1"
                }
              }
            },
            {
              "name": "Done",
              "args": {
                "isHandler": {
                  "type": ":boolean",
                  "value": true
                },
                "isMessage": {
                  "type": ":boolean",
                  "value": true
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "direct message literal creates first class message value",
      "script": "module DirectMessageLiteral\non Start(value) {\n  let scaled be value * 2\n  let myMessageDirect be Success(message: 'world', value: scaled)\n  emit Done(isMessage: myMessageDirect is :message, name: myMessageDirect.name, signature: myMessageDirect.signatureid, text: myMessageDirect.arguments.message, value: myMessageDirect.arguments.value)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {
              "value": {
                "type": ":integer",
                "value": "21"
              }
            }
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "isMessage": {
                  "type": ":boolean",
                  "value": true
                },
                "name": {
                  "type": ":text",
                  "value": "Success"
                },
                "signature": {
                  "type": ":text",
                  "value": "Success(message,value)"
                },
                "text": {
                  "type": ":text",
                  "value": "world"
                },
                "value": {
                  "type": ":integer",
                  "value": "42"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "empty uppercase invocation creates handler value",
      "script": "on Start {\n  let handler as :handler be Shoot()\n  emit Done(name: handler.name, parameterCount: :len handler[:parameters])\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "name": {
                  "type": ":text",
                  "value": "Shoot"
                },
                "parameterCount": {
                  "type": ":integer",
                  "value": "0"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "untyped handler literal and bind create first class values",
      "script": "module UntypedHandlerBinding\non Start(success) {\n  let myHandler be Success(message, value)\n  let myMessage be myHandler(message: 'hello', value: success)\n  let invalidMessage be myHandler(message: 'hello', other: success)\n  emit Done(handlerIsHandler: myHandler is :handler, handlerName: myHandler.name, handlerSignature: myHandler.signatureid, secondParameter: myHandler.parameters[2], messageIsMessage: myMessage is :message, messageName: myMessage.name, messageSignature: myMessage.signatureid, text: myMessage.arguments.message, value: myMessage.arguments.value, invalidIsNothing: invalidMessage is :nothing)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {
              "success": {
                "type": ":boolean",
                "value": true
              }
            }
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "handlerIsHandler": {
                  "type": ":boolean",
                  "value": true
                },
                "handlerName": {
                  "type": ":text",
                  "value": "Success"
                },
                "handlerSignature": {
                  "type": ":text",
                  "value": "Success(message,value)"
                },
                "secondParameter": {
                  "type": ":text",
                  "value": "value"
                },
                "messageIsMessage": {
                  "type": ":boolean",
                  "value": true
                },
                "messageName": {
                  "type": ":text",
                  "value": "Success"
                },
                "messageSignature": {
                  "type": ":text",
                  "value": "Success(message,value)"
                },
                "text": {
                  "type": ":text",
                  "value": "hello"
                },
                "value": {
                  "type": ":boolean",
                  "value": true
                },
                "invalidIsNothing": {
                  "type": ":boolean",
                  "value": true
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "invalid handler binding and non message emit are lenient no ops",
      "script": "module MessageBindingNoOp\non Start(unit, hp) {\n  let shoot as :handler be Shoot(unit, target)\n  let invalid as :message be shoot(unit: unit, hp: hp)\n  emit invalid\n  emit unit\n  emit Done(isMessage: invalid is :message, isNothing: invalid is :nothing)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {
              "unit": {
                "type": ":text",
                "value": "u_1"
              },
              "hp": {
                "type": ":integer",
                "value": "10"
              }
            }
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "isMessage": {
                  "type": ":boolean",
                  "value": false
                },
                "isNothing": {
                  "type": ":boolean",
                  "value": true
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "message and handler values expose members without becoming dictionaries",
      "script": "module MessageFirstClass\non Start(unit, target) {\n  let shoot as :handler be Shoot(unit, target)\n  let msg as :message be shoot(unit: unit, target: target)\n  emit Done(msgIsMessage: msg is :message, msgIsMap: msg is :map, handlerIsHandler: shoot is :handler, handlerIsMap: shoot is :map, msgName: msg.name, msgSignature: msg[:signatureid], handlerName: shoot.name, handlerParameterCount: :len shoot[:parameters], messageArgumentCount: :len msg.arguments)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {
              "unit": {
                "type": ":text",
                "value": "u_1"
              },
              "target": {
                "type": ":text",
                "value": "t_1"
              }
            }
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "msgIsMessage": {
                  "type": ":boolean",
                  "value": true
                },
                "msgIsMap": {
                  "type": ":boolean",
                  "value": false
                },
                "handlerIsHandler": {
                  "type": ":boolean",
                  "value": true
                },
                "handlerIsMap": {
                  "type": ":boolean",
                  "value": false
                },
                "msgName": {
                  "type": ":text",
                  "value": "Shoot"
                },
                "msgSignature": {
                  "type": ":text",
                  "value": "Shoot(unit,target)"
                },
                "handlerName": {
                  "type": ":text",
                  "value": "Shoot"
                },
                "handlerParameterCount": {
                  "type": ":integer",
                  "value": "2"
                },
                "messageArgumentCount": {
                  "type": ":integer",
                  "value": "2"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "message values can be transported as published arguments",
      "script": "on Start(unit, target) {\n  let shoot as :handler be Shoot(unit, target)\n  let msg as :message be shoot(unit: unit, target: target)\n  emit Done(messageValue: msg)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {
              "unit": {
                "type": ":text",
                "value": "u_1"
              },
              "target": {
                "type": ":text",
                "value": "t_1"
              }
            }
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "messageValue": {
                  "type": ":message",
                  "message": {
                    "name": "Shoot",
                    "args": {
                      "target": {
                        "type": ":text",
                        "value": "t_1"
                      },
                      "unit": {
                        "type": ":text",
                        "value": "u_1"
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
