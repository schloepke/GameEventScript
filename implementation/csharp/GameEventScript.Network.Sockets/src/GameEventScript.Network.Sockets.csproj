<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <AssemblyName>GameEventScript.Network.Sockets</AssemblyName>
        <RootNamespace>GameEventScript.Network.Sockets</RootNamespace>
        <PackageId>GameEventScript.Network.Sockets</PackageId>
        <Version>0.1.0</Version>
        <Authors>Stephan Schlöpke</Authors>
        <Copyright>Copyright 2026 Stephan Schlöpke</Copyright>
        <Description>TCP, WebSocket and UDP transports for Game Event Script network sessions. Background tasks move bytes only; the host drives the connection on its own thread.</Description>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <RepositoryUrl>https://github.com/schloepke/GameEventScript</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <LangVersion>12</LangVersion>
        <IsAotCompatible>true</IsAotCompatible>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <WarningsAsErrors>$(WarningsAsErrors);CS0419;CS1570;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1587;CS1591;CS1658;CS1711;CS1712</WarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../../../LICENSE" Link="LICENSE" Pack="true" PackagePath="/" />
        <None Include="../../../../website/brand/pixel-duo/nuget-icon.png" Link="icon.png" Pack="true" PackagePath="/icon.png" />
        <None Include="../../../../README.md" Link="README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../GameEventScript.Network/src/GameEventScript.Network.csproj" />
        <!-- Referenced directly because the public API uses Runtime types, so the package declares it. -->
        <ProjectReference Include="../../GameEventScript.Runtime/src/GameEventScript.Runtime.csproj" />
    </ItemGroup>
</Project>
