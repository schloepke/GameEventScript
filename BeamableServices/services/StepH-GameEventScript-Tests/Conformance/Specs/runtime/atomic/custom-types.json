  "tests": [
    {
      "kind": "scriptApi",
      "name": "create custom record with computed field and casts",
      "script": "module AtomicCreateCustomRecord\nrecord :gauge as {\n  current: :number clamped between 0 and maximum,\n  maximum: :number clamped between 0 and :infinity,\n  percentage: :percentage computed by\n    0% when maximum <= 0,\n    otherwise (current / maximum) as :percentage\n}\n\non Start {\n  let gauge be :gauge(current: 125, maximum: 100)\n  let gaugeList as :list be gauge\n  let gaugeMap as :map be gauge\n  emit Done(gauge: gauge, current: gauge.current, percentage: gauge.percentage, gaugeList: gaugeList, gaugeListLength: :len gaugeList, gaugeMap: gaugeMap, mapCurrent: gaugeMap.current, mapPercentage: gaugeMap.percentage, recordKeys: :keys gauge, recordValues: :values gauge, recordEntries: :entries gauge, isGauge: gauge is :gauge, isAim: gauge is :aim)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "current": {
                  "type": ":integer",
                  "value": "100"
                },
                "gauge": {
                  "type": ":gauge",
                  "entries": {
                    "current": {
                      "type": ":integer",
                      "value": "100"
                    },
                    "maximum": {
                      "type": ":integer",
                      "value": "100"
                    },
                    "percentage": {
                      "type": ":percentage",
                      "value": "0.01"
                    }
                  }
                },
                "gaugeList": {
                  "type": ":list",
                  "items": []
                },
                "gaugeListLength": {
                  "type": ":integer",
                  "value": "0"
                },
                "gaugeMap": {
                  "type": ":map",
                  "entries": {
                    "current": {
                      "type": ":integer",
                      "value": "100"
                    },
                    "maximum": {
                      "type": ":integer",
                      "value": "100"
                    },
                    "percentage": {
                      "type": ":percentage",
                      "value": "0.01"
                    }
                  }
                },
                "isAim": {
                  "type": ":boolean",
                  "value": false
                },
                "isGauge": {
                  "type": ":boolean",
                  "value": true
                },
                "mapCurrent": {
                  "type": ":integer",
                  "value": "100"
                },
                "mapPercentage": {
                  "type": ":percentage",
                  "value": "0.01"
                },
                "percentage": {
                  "type": ":percentage",
                  "value": "0.01"
                },
                "recordEntries": {
                  "type": ":list",
                  "items": [
                    {
                      "type": ":map",
                      "entries": {
                        "key": {
                          "type": ":tag",
                          "value": "current"
                        },
                        "value": {
                          "type": ":integer",
                          "value": "100"
                        }
                      }
                    },
                    {
                      "type": ":map",
                      "entries": {
                        "key": {
                          "type": ":tag",
                          "value": "maximum"
                        },
                        "value": {
                          "type": ":integer",
                          "value": "100"
                        }
                      }
                    },
                    {
                      "type": ":map",
                      "entries": {
                        "key": {
                          "type": ":tag",
                          "value": "percentage"
                        },
                        "value": {
                          "type": ":percentage",
                          "value": "0.01"
                        }
                      }
                    }
                  ]
                },
                "recordKeys": {
                  "type": ":list",
                  "items": [
                    {
                      "type": ":tag",
                      "value": "current"
