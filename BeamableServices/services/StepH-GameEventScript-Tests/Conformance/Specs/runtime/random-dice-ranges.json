{
  "version": 1,
  "name": "RuntimeRandomDiceRanges",
  "tests": [
    {
      "kind": "scriptApi",
      "name": "random and dice outcomes are deterministic with sequence",
      "script": "on Roll {\n  let a be random 1 to 6\n  let b be roll dice 4d6[:take highest 2]\n  emit Result(randomValue: a, diceValue: b)\n}",
      "randomSequence": [
        "4",
        "1",
        "6",
        "3",
        "5"
      ],
      "steps": [
        {
          "input": {
            "name": "Roll",
            "args": []
          },
          "expectedPublished": [
            {
              "name": "Result",
              "args": [
                {
                  "name": "randomValue",
                  "value": {
                    "type": ":integer",
                    "value": "4"
                  }
                },
                {
                  "name": "diceValue",
                  "value": {
                    "type": ":dice",
                    "rolls": [
                      6,
                      5
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "sequential steps share random sequence",
      "script": "on Roll {\n  let value be roll dice 2d6\n  emit Rolled(value: value)\n}",
      "randomSequence": [
        "1",
        "6",
        "3",
        "2"
      ],
      "steps": [
        {
          "input": {
            "name": "Roll",
            "args": []
          },
          "expectedPublished": [
            {
              "name": "Rolled",
              "args": [
                {
                  "name": "value",
                  "value": {
                    "type": ":dice",
                    "rolls": [
                      6,
                      1
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "input": {
            "name": "Roll",
            "args": []
          },
          "expectedPublished": [
            {
              "name": "Rolled",
              "args": [
                {
                  "name": "value",
                  "value": {
                    "type": ":dice",
                    "rolls": [
                      3,
                      2
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "chance and weighted choices are deterministic",
      "script": "on Start(units) {\n  let alwaysHit be chance 100%\n  let neverHit be chance 0%\n  let quarterHit be chance 25%\n  let weightedTarget be units[:choose 1 weighted by unit => unit.weight]\n  let weightedPair be units[:choose 2 weighted by unit => unit.weight]\n  emit Done(alwaysHit: alwaysHit, neverHit: neverHit, quarterHit: quarterHit, weightedTarget: weightedTarget.name, weighted_1: weightedPair[1].name, weighted_2: weightedPair[2].name)\n}",
      "randomSequence": [
        "0.249999",
        "9",
        "0",
        "8.99999"
      ],
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": [
              {
                "name": "units",
                "value": {
                  "type": ":list",
                  "items": [
                    {
                      "type": ":map",
                      "entries": {
                        "name": {
                          "type": ":text",
                          "value": "A"
                        },
                        "weight": {
                          "type": ":integer",
                          "value": "1"
                        }
                      }
                    },
                    {
                      "type": ":map",
                      "entries": {
                        "name": {
                          "type": ":text",
                          "value": "B"
                        },
                        "weight": {
                          "type": ":integer",
                          "value": "3"
                        }
                      }
                    },
                    {
                      "type": ":map",
                      "entries": {
                        "name": {
                          "type": ":text",
                          "value": "C"
                        },
                        "weight": {
                          "type": ":integer",
                          "value": "6"
                        }
                      }
                    }
                  ]
                }
              }
            ]
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": [
                {
                  "name": "alwaysHit",
                  "value": {
                    "type": ":boolean",
                    "value": true
                  }
                },
                {
                  "name": "neverHit",
                  "value": {
                    "type": ":boolean",
                    "value": false
                  }
                },
                {
                  "name": "quarterHit",
                  "value": {
                    "type": ":boolean",
                    "value": true
                  }
                },
                {
                  "name": "weightedTarget",
                  "value": {
                    "type": ":text",
                    "value": "C"
                  }
                },
                {
                  "name": "weighted_1",
                  "value": {
                    "type": ":text",
                    "value": "A"
                  }
                },
                {
                  "name": "weighted_2",
                  "value": {
                    "type": ":text",
                    "value": "C"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "shuffle draw choose and seeded random scopes are deterministic",
      "script": "on Start(enemies, seed as :number) {\n  let cards be [1, 2, 3, 4, 5][:shuffle]\n  let hand be cards[:draw 3]\n  let restCards be cards[:drop first 3]\n  let target be enemies[:choose 1 enemy where enemy.alive]\n  let randomTargets be enemies[:choose 2 at random enemy where enemy.alive]\n  let seededFirst be random with seed :list[:select item from 1 to 4 => random from 1 to 20]\n  let seededSecond be random with seed :list[:select item from 1 to 4 => random from 1 to 20]\n  emit Done(hand_1: hand[1], hand_2: hand[2], hand_3: hand[3], rest_1: restCards[1], rest_2: restCards[2], target: target.name, random_1: randomTargets[1].name, random_2: randomTargets[2].name, seededSame: seededFirst = seededSecond)\n}",
      "randomSequence": [
        "1",
        "0",
        "1",
        "1",
        "0",
        "1"
      ],
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": [
              {
                "name": "enemies",
                "value": {
                  "type": ":list",
                  "items": [
                    {
                      "type": ":map",
                      "entries": {
                        "name": {
                          "type": ":text",
                          "value": "Rook"
                        },
                        "alive": {
                          "type": ":boolean",
                          "value": false
                        }
                      }
                    },
                    {
                      "type": ":map",
                      "entries": {
                        "name": {
                          "type": ":text",
                          "value": "Orc"
                        },
                        "alive": {
                          "type": ":boolean",
                          "value": true
                        }
                      }
                    },
                    {
                      "type": ":map",
                      "entries": {
                        "name": {
                          "type": ":text",
                          "value": "Mage"
                        },
                        "alive": {
                          "type": ":boolean",
                          "value": true
                        }
                      }
                    },
                    {
                      "type": ":map",
                      "entries": {
                        "name": {
                          "type": ":text",
                          "value": "Knight"
                        },
                        "alive": {
                          "type": ":boolean",
                          "value": true
                        }
                      }
                    }
                  ]
                }
              },
              {
                "name": "seed",
                "value": {
                  "type": ":integer",
                  "value": "42"
                }
              }
            ]
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": [
                {
                  "name": "hand_1",
                  "value": {
                    "type": ":integer",
                    "value": "4"
                  }
                },
                {
                  "name": "hand_2",
                  "value": {
                    "type": ":integer",
                    "value": "3"
                  }
                },
                {
                  "name": "hand_3",
                  "value": {
                    "type": ":integer",
                    "value": "5"
                  }
                },
                {
                  "name": "rest_1",
                  "value": {
                    "type": ":integer",
                    "value": "1"
                  }
                },
                {
                  "name": "rest_2",
                  "value": {
                    "type": ":integer",
                    "value": "2"
                  }
                },
                {
                  "name": "target",
                  "value": {
                    "type": ":text",
                    "value": "Orc"
                  }
                },
                {
                  "name": "random_1",
                  "value": {
                    "type": ":text",
                    "value": "Orc"
                  }
                },
                {
                  "name": "random_2",
                  "value": {
                    "type": ":text",
                    "value": "Knight"
                  }
                },
                {
                  "name": "seededSame",
                  "value": {
                    "type": ":boolean",
                    "value": true
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "dynamic invalid seeded random seed still restores outer random scope",
      "script": "on Start {\n  let bad as :number be nothing\n  random with bad {\n    let inner be random from 1 to 6\n  }\n  emit Done(valuePresent: (random from 1 to 6) has value)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": []
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": [
                {
                  "name": "valuePresent",
                  "value": {
                    "type": ":boolean",
                    "value": true
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "reversed random bounds and invalid collection draws stay lenient",
      "script": "on Roll(low, high) {\n  let value be random from low to high\n  let none as :number be nothing\n  let nothingValue be random from none to high\n  let invalidValue be random from 'hello' to high\n  let tags be 123\n  let shuffledTags be tags[:shuffle]\n  let drawnTag be tags[:draw 1]\n  emit Done(valuePresent: value has value, nothingValue: nothingValue, invalidValue: invalidValue, shuffledTags: shuffledTags, drawnTag: drawnTag)\n}",
      "steps": [
        {
          "input": {
            "name": "Roll",
            "args": [
              {
                "name": "low",
                "value": {
                  "type": ":integer",
                  "value": "9"
                }
              },
              {
                "name": "high",
                "value": {
                  "type": ":integer",
                  "value": "2"
                }
              }
            ]
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": [
                {
                  "name": "valuePresent",
                  "value": {
                    "type": ":boolean",
                    "value": true
                  }
                },
                {
                  "name": "nothingValue",
                  "value": {
                    "type": ":nothing"
                  }
                },
                {
                  "name": "invalidValue",
                  "value": {
                    "type": ":float",
                    "value": "NaN"
                  }
                },
                {
                  "name": "shuffledTags",
                  "value": {
                    "type": ":nothing"
                  }
                },
                {
                  "name": "drawnTag",
                  "value": {
                    "type": ":nothing"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
