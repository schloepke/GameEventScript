    {
      "kind": "scriptApi",
      "name": "range direct lookup is not capped by materialization limit",
      "script": "on Start {\n  let values as :range be from 1 to 1000000\n  emit Done(value: values[1000000], contains: 999999 in values, fractional: 1.5 in values)\n}",
      "runtimeLimits": {
        "maxRangeItems": 5
      },
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "value": {
                  "type": ":integer",
                  "value": "1000000"
                },
                "contains": {
                  "type": ":boolean",
                  "value": true
                },
                "fractional": {
                  "type": ":boolean",
                  "value": false
                }
              }
            }
          ],
          "unexpectedDiagnostics": [
            {
              "kind": "RuntimeLimitReached"
            }
          ]
        }
      ]
    },
