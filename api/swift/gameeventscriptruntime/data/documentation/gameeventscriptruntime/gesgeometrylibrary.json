ype":"text","text":" of discs; "},{"type":"codeVoice","code":"contains"},{"type":"text","text":" and "},{"type":"codeVoice","code":"intersects"},{"type":"text","text":" of all, a box"},{"type":"text","text":" "},{"type":"text","text":"with a polygon counting as its outline in the plane and a disc meeting a 2D box. Anything else, such as another unit,"},{"type":"text","text":" "},{"type":"text","text":"gives "},{"type":"codeVoice","code":"nothing"},{"type":"text","text":"."}],"type":"paragraph"}]}],"metadata":{"externalID":"s:22GameEventScriptRuntime18GesGeometryLibraryO","symbolKind":"enum","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"GesGeometryLibrary"}],"modules":[{"name":"GameEventScriptRuntime"}],"roleHeading":"Enumeration","title":"GesGeometryLibrary","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"GesGeometryLibrary"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gameeventscriptruntime\/gesgeometrylibrary"]}],"hierarchy":{"paths":[["doc:\/\/org.gameeventscript.GameEventScriptRuntime\/documentation\/GameEventScriptRuntime"]]},"abstract":[{"type":"text","text":"The standard geometry library: the external types "},{"code":":Box","type":"codeVoice"},{"type":"text","text":", "},{"code":":Poly","type":"codeVoice"},{"type":"text","text":" and "},{"code":":Disc","type":"codeVoice"},{"type":"text","text":" over "},{"identifier":"doc:\/\/org.gameeventscript.GameEventScriptRuntime\/documentation\/GameEventScriptRuntime\/GesBox","isActive":true,"type":"reference"},{"type":"text","text":", "},{"identifier":"doc:\/\/org.gameeventscript.GameEventScriptRuntime\/documentation\/GameEventScriptRuntime\/GesPoly","isActive":true,"type":"reference"},{"type":"text","text":" and "},{"identifier":"doc:\/\/org.gameeventscript.GameEventScriptRuntime\/documentation\/GameEventScriptRuntime\/GesDisc","isActive":true,"type":"reference"},{"type":"text","text":","},{"type":"text","tex