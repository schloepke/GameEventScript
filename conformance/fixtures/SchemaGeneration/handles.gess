// The fixture of the checked-in handle code: handle types without, with a revision, a content hash and a SHA-1 version,
// a composite, handle fields with and without the version, as list elements, union alternatives and Map keys, in wire
// records with deltas and in models.
schema :DroneState as { x: :Quantity(m) between -200m and 200m step 0.05m, y: :Quantity(m) between -200m and 200m step 0.05m }
schema :Contact as { label: :Text max 16, strength: :Number integer between 0 and 100 }
schema :Composition as { name: :Text max 64, slots: :Number integer between 0 and 16 }
schema :Source as { text: :Text }

handle @Drone of :DroneState as { id: :Number integer between 0 and 255, version: :Number integer between 0 and 1000 }
handle @Target of :Contact as { id: :Number integer between 0 and 65535, version: :Nothing }
handle @Unit of :Composition as { id: :Text max 64, version: :ContentHash }
handle @Repository of :Source as { id: :Text max 64, version: :Hash(#sha1) }
handle @UnitFile of :Composition composite @Repository as { part: :Text max 256 }

wire(handles) model(handles) schema :Sighting as {
  target: @Target
  seen: :List(@Target) max 16
  unit: @Unit~ optional
  file: @UnitFile~
  subject: @Drone | @Target
  pilot: @Drone~ | :Nothing
}

wire(handles) model(handles) schema :Memory as {
  lastSeen: :Map(@Target → :Contact) max 4
  pinned: :Map(@Drone → @Unit~ | :Nothing) max 2
}
