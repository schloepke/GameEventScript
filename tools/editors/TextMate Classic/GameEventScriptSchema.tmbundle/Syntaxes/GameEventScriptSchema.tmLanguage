<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>name</key>
	<string>GameEventScript Schema</string>
	<key>scopeName</key>
	<string>source.gameeventscript.schema</string>
	<key>fileTypes</key>
	<array>
		<string>gess</string>
	</array>
	<key>patterns</key>
	<array>
		<dict>
			<key>include</key>
			<string>#comments</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#types</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#tags</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#constants</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#numbers</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#keywords</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#messages</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#punctuation</string>
		</dict>
	</array>
	<key>repository</key>
	<dict>
		<key>comments</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>//.*$</string>
					<key>name</key>
					<string>comment.line.double-slash.gameeventscript.schema</string>
				</dict>
			</array>
		</dict>
		<key>types</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>:[A-Z][A-Za-z0-9]*(?:_[A-Z][A-Za-z0-9]*)*</string>
					<key>name</key>
					<string>support.type.gameeventscript.schema</string>
				</dict>
			</array>
		</dict>
		<key>tags</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>#[A-Za-z][A-Za-z0-9]*</string>
					<key>name</key>
					<string>constant.other.symbol.tag.gameeventscript.schema</string>
				</dict>
			</array>
		</dict>
		<key>constants</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>\$[A-Za-z][A-Za-z0-9]*</string>
					<key>name</key>
					<string>variable.other.constant.gameeventscript.schema</string>
				</dict>
			</array>
		</dict>
		<key>numbers</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>-?\b\d[\d_]*(?:\.\d[\d_]*)?(?:[eE][+-]?\d+)?[^\s,(){}|#]*</string>
					<key>name</key>
					<string>constant.numeric.gameeventscript.schema</string>
				</dict>
			</array>
		</dict>
		<key>keywords</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>\b(?:schema|messages|message|constant|parameter|as|be|between|and|wrapping|step|delta|within|integer|optional|key|max|tags|wire|model|let|default|true|false|abstract|with|all|without)\b</string>
					<key>name</key>
					<string>keyword.other.gameeventscript.schema</string>
				</dict>
			</array>
		</dict>
		<key>messages</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>\b[A-Z][A-Za-z0-9]*(?:_[A-Z][A-Za-z0-9]*)*\b</string>
					<key>name</key>
					<string>entity.name.type.message.gameeventscript.schema</string>
				</dict>
			</array>
		</dict>
		<key>punctuation</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>[|]</string>
					<key>name</key>
					<string>keyword.operator.union.gameeventscript.schema</string>
				</dict>
				<dict>
					<key>match</key>
					<string>[,:{}()]</string>
					<key>name</key>
					<string>punctuation.separator.gameeventscript.schema</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
