{
  "version": 1,
  "name": "RuntimeAtomicMemberIndexAccess",
  "level": "atomic",
  "tests": [
    {
      "kind": "scriptApi",
      "name": "nothing member and index access",
      "script": "module AtomicNothingAccess\non Start {\n  let value be missing\n  emit Done(member: value.missing, index: value[1], indexOut: value[0])\n}",
      "steps": [
        {
          "input": { "name": "Start", "args": {} },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "member": { "type": ":nothing" },
                "index": { "type": ":nothing" },
                "indexOut": { "type": ":nothing" }
              }
            }
          ]
        }
      ]
    },
    {
