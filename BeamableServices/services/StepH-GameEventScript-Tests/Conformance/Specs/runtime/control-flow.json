{
  "version": 1,
  "name": "RuntimeControlFlow",
  "tests": [
    {
      "kind": "scriptApi",
      "name": "simple emit",
      "script": "on Start {\n  emit Done\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {}
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "standalone and trailing comments are ignored during execution",
      "script": "module CommentRuntime\n// initialize flow\non Start { // handler begins\n  let hp be 10 // base value\n  emit Done(value: hp) // finished\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "value": {
                  "type": ":integer",
                  "value": "10"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "semicolons and continued expressions preserve behavior",
      "script": "on Start {\n  let lines be 10; let values be 20\n  let result be 1 +\n    2\n  emit Done(lines: lines, values: values, result: result)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "lines": {
                  "type": ":integer",
                  "value": "10"
                },
                "values": {
                  "type": ":integer",
                  "value": "20"
                },
                "result": {
                  "type": ":integer",
                  "value": "3"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "published messages are dispatched through the same host queue",
      "script": "on Start(value) {\n  emit Next(value: value + 1)\n}\n\non Next(value) {\n  emit Done(value: value)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {
              "value": {
                "type": ":float",
                "value": "2"
              }
            }
          },
          "expectedPublished": [
            {
              "name": "Next",
              "args": {
                "value": {
                  "type": ":integer",
                  "value": "3"
                }
              }
            },
            {
              "name": "Done",
              "args": {
                "value": {
                  "type": ":integer",
                  "value": "3"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "processing limit stops event loops",
      "script": "on Start {\n  emit Loop\n}\n\non Loop {\n  emit Start\n}",
      "runtimeLimits": {
        "maxProcessedEventsPerRun": 4
      },
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Loop",
              "args": {}
            },
            {
              "name": "Start",
              "args": {}
            },
            {
              "name": "Loop",
              "args": {}
            },
            {
              "name": "Start",
              "args": {}
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "queue limit drops newest published messages",
      "script": "on Start {\n  emit A\n  emit B\n  emit C\n}\n\non A {}\non B {}\non C {}",
      "runtimeLimits": {
        "maxQueuedMessagesPerRun": 2
      },
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "A",
              "args": {}
            },
            {
              "name": "B",
              "args": {}
            },
            {
              "name": "C",
              "args": {}
            }
          ],
          "expectedRuntimeLimits": [
            {
              "name": "MaxQueuedMessagesPerRun",
              "detailContains": "Dropped 'C'"
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "if and for single statements run without blocks",
      "script": "on Start(first, second, items) {\n  if first emit One\n  else if second emit Two\n  else emit Three\n\n  for item in items emit Item(value: item)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {
              "first": {
                "type": ":boolean",
                "value": false
              },
              "second": {
                "type": ":boolean",
                "value": true
              },
              "items": {
                "type": ":list",
                "items": [
                  {
                    "type": ":integer",
                    "value": "1"
                  },
                  {
                    "type": ":integer",
                    "value": "2"
                  }
                ]
              }
            }
          },
          "expectedPublished": [
            {
              "name": "Two",
              "args": {}
            },
            {
              "name": "Item",
              "args": {
                "value": {
                  "type": ":integer",
                  "value": "1"
                }
              }
            },
            {
              "name": "Item",
              "args": {
                "value": {
                  "type": ":integer",
                  "value": "2"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "threshold check publishes matching branch",
      "script": "on Start(values, threshold) {\n  let passed be values[:any value where value > threshold]\n  if passed {\n    emit Passed(count: :len values)\n  } else {\n    emit Failed\n  }\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {
              "values": {
                "type": ":list",
                "items": [
                  {
                    "type": ":integer",
                    "value": "1"
                  },
                  {
                    "type": ":integer",
                    "value": "5"
                  },
                  {
                    "type": ":integer",
                    "value": "9"
                  }
                ]
              },
              "threshold": {
                "type": ":integer",
                "value": "7"
              }
            }
          },
          "expectedPublished": [
            {
              "name": "Passed",
              "args": {
                "count": {
                  "type": ":integer",
                  "value": "3"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "else runs when condition is not true",
      "script": "on Start {\n  let unknown be nothing > 0\n  if unknown {\n    emit TrueBranch\n  } else {\n    emit FalseBranch\n  }\n\n  let explicitFalse be unknown as :boolean\n  if explicitFalse {\n    emit ExplicitTrue\n  } else {\n    emit ExplicitFalse\n  }\n\n  emit Done(unknown: unknown)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "FalseBranch",
              "args": {}
            },
            {
              "name": "ExplicitFalse",
              "args": {}
            },
            {
              "name": "Done",
              "args": {
                "unknown": {
                  "type": ":nothing"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "logical operators use tri state truth tables",
      "script": "on Start {\n  emit Done(notUnknown: not nothing, falseAndUnknown: false and nothing, unknownAndFalse: nothing and false, trueAndUnknown: true and nothing, unknownAndTrue: nothing and true, unknownAndUnknown: nothing and nothing, trueOrUnknown: true or nothing, unknownOrTrue: nothing or true, falseOrUnknown: false or nothing, unknownOrFalse: nothing or false, unknownOrUnknown: nothing or nothing, trueXorFalse: true xor false, trueXorTrue: true xor true, unknownXorTrue: nothing xor true, unknownXorUnknown: nothing xor nothing)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "notUnknown": {
                  "type": ":nothing"
                },
                "falseAndUnknown": {
                  "type": ":boolean",
                  "value": false
                },
                "unknownAndFalse": {
                  "type": ":boolean",
                  "value": false
                },
                "trueAndUnknown": {
                  "type": ":nothing"
                },
                "unknownAndTrue": {
                  "type": ":nothing"
                },
                "unknownAndUnknown": {
                  "type": ":nothing"
                },
                "trueOrUnknown": {
                  "type": ":boolean",
                  "value": true
                },
                "unknownOrTrue": {
                  "type": ":boolean",
                  "value": true
                },
                "falseOrUnknown": {
                  "type": ":nothing"
                },
                "unknownOrFalse": {
                  "type": ":nothing"
                },
                "unknownOrUnknown": {
                  "type": ":nothing"
                },
                "trueXorFalse": {
                  "type": ":boolean",
                  "value": true
                },
                "trueXorTrue": {
                  "type": ":boolean",
                  "value": false
                },
                "unknownXorTrue": {
                  "type": ":nothing"
                },
                "unknownXorUnknown": {
                  "type": ":nothing"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "and and or short circuit right hand expressions",
      "script": "on Start {\n  let skippedAnd be false and :test.fail()\n  let skippedOr be true or :test.fail()\n  let evaluatedAnd be true and :test.truth()\n  let evaluatedOr be false or :test.truth()\n  emit Done(skippedAnd: skippedAnd, skippedOr: skippedOr, evaluatedAnd: evaluatedAnd, evaluatedOr: evaluatedOr)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "skippedAnd": {
                  "type": ":boolean",
                  "value": false
                },
                "skippedOr": {
                  "type": ":boolean",
                  "value": true
                },
                "evaluatedAnd": {
                  "type": ":boolean",
                  "value": true
                },
                "evaluatedOr": {
                  "type": ":boolean",
                  "value": true
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "implication is right associative tri state and short circuiting",
      "script": "function handleDamage(_ wasHit, _ absorbed, _ applied) be wasHit -> !absorbed -> applied\n\non Start {\n  let skipped be false -> :test.fail()\n  let unicodeSkipped be false⇒:test.fail()\n  let unicodeEvaluated be true⇒true\n  let unicodeSingleSkipped be false→:test.fail()\n  let unicodeSingleEvaluated be true→true\n  let rightAssoc be false -> false -> :test.fail()\n  let absorbedChain be true -> !true -> :test.fail()\n  let notHit be handleDamage(false, false, false)\n  let absorbed be handleDamage(true, true, false)\n  let applied be handleDamage(true, false, true)\n  let failed be handleDamage(true, false, false)\n  let unknownResolved be nothing -> true\n  let unknownBlocked be nothing -> false\n  emit Done(skipped: skipped, unicodeSkipped: unicodeSkipped, unicodeEvaluated: unicodeEvaluated, unicodeSingleSkipped: unicodeSingleSkipped, unicodeSingleEvaluated: unicodeSingleEvaluated, rightAssoc: rightAssoc, absorbedChain: absorbedChain, notHit: notHit, absorbed: absorbed, applied: applied, failed: failed, unknownResolved: unknownResolved, unknownBlocked: unknownBlocked)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "skipped": {
                  "type": ":boolean",
                  "value": true
                },
                "unicodeSkipped": {
                  "type": ":boolean",
                  "value": true
                },
                "unicodeEvaluated": {
                  "type": ":boolean",
                  "value": true
                },
                "unicodeSingleSkipped": {
                  "type": ":boolean",
                  "value": true
                },
                "unicodeSingleEvaluated": {
                  "type": ":boolean",
                  "value": true
                },
                "rightAssoc": {
                  "type": ":boolean",
                  "value": true
                },
                "absorbedChain": {
                  "type": ":boolean",
                  "value": true
                },
                "notHit": {
                  "type": ":boolean",
                  "value": true
                },
                "absorbed": {
                  "type": ":boolean",
                  "value": true
                },
                "applied": {
                  "type": ":boolean",
                  "value": true
                },
                "failed": {
                  "type": ":boolean",
                  "value": false
                },
                "unknownResolved": {
                  "type": ":boolean",
                  "value": true
                },
                "unknownBlocked": {
                  "type": ":nothing"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "nested block scopes may shadow outer variables",
      "script": "module NestedShadowing\non Start {\n  let x be 10\n  if true {\n    let x be 20\n    emit Done(value: x)\n  }\n  emit Done(value: x)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "value": {
                  "type": ":integer",
                  "value": "20"
                }
              }
            },
            {
              "name": "Done",
              "args": {
                "value": {
                  "type": ":integer",
                  "value": "10"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "incompatible conditions and loops are lenient",
      "script": "on Start {\n  if 'abc' {\n    emit IfTrue\n  } else {\n    emit IfFalse\n  }\n\n  for item in 123 {\n    emit Loop(item: item)\n  }\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "IfFalse",
              "args": {}
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "sql style inequality changes branching",
      "script": "on Start {\n  if 1 <> 2 {\n    emit Different\n  }\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Different",
              "args": {}
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "text iteration yields single character items",
      "script": "on Start(text) {\n  for item in text {\n    if item = 'a' {\n      emit Found(value: item)\n    }\n  }\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {
              "text": {
                "type": ":text",
                "value": "ab"
              }
            }
          },
          "expectedPublished": [
            {
              "name": "Found",
              "args": {
                "value": {
                  "type": ":text",
                  "value": "a"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
