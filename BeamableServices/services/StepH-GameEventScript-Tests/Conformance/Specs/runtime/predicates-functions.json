{
  "version": 1,
  "name": "RuntimePredicatesFunctions",
  "tests": [
    {
      "kind": "scriptApi",
      "name": "predicates and functions are reusable in expressions and collections",
      "script": "predicate wounded(_ unit) means unit.hp < unit.maxHp\nfunction woundedUnits(_ units) means units[:filter unit where unit is wounded]\n\non Start(unit, units) {\n  let byCall be wounded(unit)\n  let byPredicate be unit is wounded\n  let woundedList be woundedUnits(units)\n  emit Done(byCall: byCall, byPredicate: byPredicate, woundedCount: :len woundedList, first: woundedList[1].name, second: woundedList[2].name)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {
              "unit": {
                "type": ":dictionary",
                "entries": {
                  "name": { "type": ":text", "value": "Ada" },
                  "hp": { "type": ":integer", "value": "2" },
                  "maxHp": { "type": ":integer", "value": "5" }
                }
              },
              "units": {
                "type": ":list",
                "items": [
                  {
                    "type": ":dictionary",
                    "entries": {
                      "name": { "type": ":text", "value": "Ada" },
                      "hp": { "type": ":integer", "value": "2" },
                      "maxHp": { "type": ":integer", "value": "5" }
                    }
                  },
                  {
                    "type": ":dictionary",
                    "entries": {
                      "name": { "type": ":text", "value": "Bert" },
                      "hp": { "type": ":integer", "value": "4" },
                      "maxHp": { "type": ":integer", "value": "4" }
                    }
                  },
                  {
                    "type": ":dictionary",
                    "entries": {
                      "name": { "type": ":text", "value": "Cara" },
                      "hp": { "type": ":integer", "value": "1" },
                      "maxHp": { "type": ":integer", "value": "3" }
                    }
                  }
                ]
              }
            }
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "byCall": { "type": ":boolean", "value": true },
                "byPredicate": { "type": ":boolean", "value": true },
                "woundedCount": { "type": ":integer", "value": "2" },
                "first": { "type": ":text", "value": "Ada" },
                "second": { "type": ":text", "value": "Cara" }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "predicates and functions are lenient when expected keys are missing",
      "script": "predicate wounded(_ unit) means unit.hp < unit.maxHp\nfunction woundedUnits(_ units) means units[:filter unit where unit is wounded]\n\non Start(unit, units) {\n  let byCall be wounded(unit)\n  let byPredicate be unit is wounded\n  let woundedList be woundedUnits(units)\n  emit Done(byCall: byCall, byPredicate: byPredicate, woundedCount: :len woundedList)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {
              "unit": {
                "type": ":dictionary",
                "entries": {
                  "name": { "type": ":text", "value": "NoHp" }
                }
              },
              "units": {
                "type": ":list",
                "items": [
                  {
                    "type": ":dictionary",
                    "entries": {
                      "name": { "type": ":text", "value": "NoHp" }
                    }
                  },
                  {
                    "type": ":dictionary",
                    "entries": {
                      "name": { "type": ":text", "value": "Healthy" },
                      "hp": { "type": ":integer", "value": "5" },
                      "maxHp": { "type": ":integer", "value": "5" }
                    }
                  }
                ]
              }
            }
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "byCall": { "type": ":boolean", "value": false },
                "byPredicate": { "type": ":boolean", "value": false },
                "woundedCount": { "type": ":integer", "value": "0" }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "predicates coerce to boolean while functions keep original value",
      "script": "predicate numeric(_ value) means value * 2\nfunction numericSelect(_ value) means value * 2\n\non Start {\n  let byRuleTwo be numeric(2)\n  let byRuleZero be numeric(0)\n  let bySelect be numericSelect(2)\n  let byPredicate be 2 is numeric\n  emit Done(byRuleTwo: byRuleTwo, byRuleZero: byRuleZero, bySelect: bySelect, byPredicate: byPredicate)\n}",
      "steps": [
        {
          "input": { "name": "Start", "args": {} },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "byRuleTwo": { "type": ":boolean", "value": true },
                "byRuleZero": { "type": ":boolean", "value": false },
                "bySelect": { "type": ":integer", "value": "4" },
                "byPredicate": { "type": ":boolean", "value": true }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "multiple modules share predicate function and type definitions",
      "scripts": [
        {
          "sourceName": "shared.es",
          "text": "module Shared\nrecord :gauge as {\n  current: :float,\n  maximum: :float\n}\n\npredicate wounded(_ unit) means unit.hp < unit.maxHp\nfunction woundedUnits(_ units) means units[:filter unit where unit is wounded]"
        },
        {
          "sourceName": "runtime.es",
          "text": "module Runtime\non Start(unit, units) {\n  let hp as :gauge be [current: unit.hp, maximum: unit.maxHp]\n  let anyWounded be wounded(unit)\n  let candidates be woundedUnits(units)\n  emit Done(anyWounded: anyWounded, candidateCount: :len candidates, maximum: hp.maximum)\n}"
        }
      ],
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {
              "unit": {
                "type": ":dictionary",
                "entries": {
                  "hp": { "type": ":integer", "value": "2" },
                  "maxHp": { "type": ":integer", "value": "5" }
                }
              },
              "units": {
                "type": ":list",
                "items": [
                  {
                    "type": ":dictionary",
                    "entries": {
                      "hp": { "type": ":integer", "value": "2" },
                      "maxHp": { "type": ":integer", "value": "5" }
                    }
                  },
                  {
                    "type": ":dictionary",
                    "entries": {
                      "hp": { "type": ":integer", "value": "5" },
                      "maxHp": { "type": ":integer", "value": "5" }
                    }
                  }
                ]
              }
            }
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "anyWounded": { "type": ":boolean", "value": true },
                "candidateCount": { "type": ":integer", "value": "1" },
                "maximum": { "type": ":float", "value": "5" }
              }
            }
          ]
        }
      ]
    }
  ]
}
