<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <AssemblyName>GameEventScript.Tool</AssemblyName>
        <RootNamespace>GameEventScript.Tool</RootNamespace>
        <PackageId>GameEventScript.Tool</PackageId>
        <Version>0.1.0</Version>
        <Authors>Stephan Schlöpke</Authors>
        <Copyright>Copyright 2026 Stephan Schlöpke</Copyright>
        <Description>Command-line entry point for Game Event Script.</Description>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <RepositoryUrl>https://github.com/schloepke/GameEventScript</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>dotnet-ges</ToolCommandName>
        <PackageOutputPath>$(MSBuildProjectDirectory)/../../../../artifacts/csharp/tool/packages</PackageOutputPath>
        <LangVersion>12</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="GameEventScript.Tool.Tests" />
        <PackageReference Include="PrettyPrompt" Version="4.1.1" />
        <ProjectReference Include="../../GameEventScript.SyntaxHighlighter/src/GameEventScript.SyntaxHighlighter.csproj" />
        <ProjectReference Include="../../GameEventScript.Runtime/src/GameEventScript.Runtime.csproj" />
        <ProjectReference Include="../../GameEventScript.Compiler/src/GameEventScript.Compiler.csproj" />
        <ProjectReference Include="../../GameEventScript.CSharpBridge/src/GameEventScript.CSharpBridge.csproj" />
        <None Include="../../../../LICENSE" Link="LICENSE" Pack="true" PackagePath="/" />
        <None Include="../../../../website/brand/pixel-duo/nuget-icon.png" Link="icon.png" Pack="true" PackagePath="/icon.png" />
        <None Include="../README.md" Pack="true" PackagePath="/" />
        <None Include="../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    </ItemGroup>
</Project>
