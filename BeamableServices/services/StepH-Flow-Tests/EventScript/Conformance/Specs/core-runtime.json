{
  "version": 1,
  "name": "CoreRuntime",
  "tests": [
    {
      "kind": "scriptApi",
      "name": "simple publish",
      "script": "on Start {\n  publish Done\n}",
      "steps": [
        {
          "input": { "name": "Start", "args": {} },
          "expectedPublished": [
            { "name": "Done", "args": {} }
          ],
          "expectedDiagnostics": []
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "all published messages include chained dispatch",
      "script": "on Start {\n  publish Next\n}\n\non Next {\n  publish Done\n}",
      "steps": [
        {
          "input": { "name": "Start", "args": {} },
          "expectedPublished": [
            { "name": "Next", "args": {} },
            { "name": "Done", "args": {} }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "sequential steps share random sequence",
      "script": "on Roll {\n  let value be :dice 2d6\n  publish Rolled(value: value)\n}",
      "randomSequence": ["1", "6", "3", "2"],
      "steps": [
        {
          "input": { "name": "Roll", "args": {} },
          "expectedPublished": [
            {
              "name": "Rolled",
              "args": {
                "value": { "type": ":dice", "rolls": [6, 1] }
              }
            }
          ]
        },
        {
          "input": { "name": "Roll", "args": {} },
          "expectedPublished": [
            {
              "name": "Rolled",
              "args": {
                "value": { "type": ":dice", "rolls": [3, 2] }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "typed message values roundtrip",
      "script": "on Echo(name, tags, stats, maybe, flag, percent, category, points, span) {\n  publish Echoed(name: name, tags: tags, stats: stats, maybe: maybe, flag: flag, percent: percent, category: category, points: points, span: span)\n}",
      "steps": [
        {
          "input": {
            "name": "Echo",
            "args": {
              "name": { "type": ":text", "value": "unit-1" },
              "tags": {
                "type": ":list",
                "items": [
                  { "type": ":tag", "value": "Ready" },
                  { "type": ":text", "value": "frontline" }
                ]
              },
              "stats": {
                "type": ":Unit",
                "entries": {
                  "hp": { "type": ":integer", "value": "7" },
                  "name": { "type": ":text", "value": "Knight" }
                }
              },
              "maybe": { "type": ":optional", "hasValue": false },
              "flag": { "type": ":boolean", "value": true },
              "percent": { "type": ":percentage", "value": "0.25" },
              "category": { "type": ":tag", "value": "Infantry" },
              "points": {
                "type": ":set",
                "items": [
                  { "type": ":integer", "value": "2" },
                  { "type": ":integer", "value": "1" }
                ]
              },
              "span": { "type": ":range", "from": "1", "to": "3", "step": "1" }
            }
          },
          "expectedPublished": [
            {
              "name": "Echoed",
              "args": {
                "name": { "type": ":text", "value": "unit-1" },
                "tags": {
                  "type": ":list",
                  "items": [
                    { "type": ":tag", "value": "Ready" },
                    { "type": ":text", "value": "frontline" }
                  ]
                },
                "stats": {
                  "type": ":Unit",
                  "entries": {
                    "hp": { "type": ":integer", "value": "7" },
                    "name": { "type": ":text", "value": "Knight" }
                  }
                },
                "maybe": { "type": ":optional", "hasValue": false },
                "flag": { "type": ":boolean", "value": true },
                "percent": { "type": ":percentage", "value": "0.25" },
                "category": { "type": ":tag", "value": "Infantry" },
                "points": {
                  "type": ":set",
                  "items": [
                    { "type": ":integer", "value": "1" },
                    { "type": ":integer", "value": "2" }
                  ]
                },
                "span": { "type": ":range", "from": "1", "to": "3", "step": "1" }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "computed custom type fields are materialized",
      "script": "record :meter as {\n  current: :decimal clamped between 0 and maximum,\n  maximum: :decimal clamped between 0 and :infinity,\n  percentage: :percentage computed by\n    0% when maximum <= 0,\n    otherwise (current / maximum) as :percentage\n}\n\non Start {\n  let hp as :meter be [current: 125, maximum: 100]\n  publish Done(meter: hp, isMeter: hp is :meter)\n}",
      "steps": [
        {
          "input": { "name": "Start", "args": {} },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "meter": {
                  "type": ":meter",
                  "entries": {
                    "current": { "type": ":decimal", "value": "100" },
                    "maximum": { "type": ":decimal", "value": "100" },
                    "percentage": { "type": ":percentage", "value": "1" }
                  }
                },
                "isMeter": { "type": ":boolean", "value": true }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "range limit diagnostics",
      "script": "on Start {\n  for item from 1 to 10 publish Tick(value: item)\n  let values as :list be from 1 to 10\n  publish Done(count: :len values)\n}",
      "runtimeLimits": { "maxRangeItems": 5 },
      "steps": [
        {
          "input": { "name": "Start", "args": {} },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "count": { "type": ":integer", "value": "0" }
              }
            }
          ],
          "expectedDiagnostics": [
            { "kind": "RuntimeLimitReached", "name": "MaxRangeItems" }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "dice limit diagnostics",
      "script": "on Start {\n  let roll be :dice 6d6\n  publish Done(count: :len roll)\n}",
      "runtimeLimits": { "maxDiceCount": 4 },
      "steps": [
        {
          "input": { "name": "Start", "args": {} },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "count": { "type": ":integer", "value": "0" }
              }
            }
          ],
          "expectedDiagnostics": [
            { "kind": "RuntimeLimitReached", "name": "MaxDiceCount" }
          ]
        }
      ]
    }
  ]
}
