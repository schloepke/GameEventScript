{
  "version": 1,
  "name": "RuntimePublishAndTags",
  "tests": [
    {
      "kind": "scriptApi",
      "name": "emit stays local while publish is local and outbound",
      "script": "on Start {\n  emit Local\n  publish Remote with #radio\n}\n\non Local {\n  emit Seen(value: 1)\n}\n\non Remote {\n  emit ShouldNotRun\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": []
          },
          "expectedPublished": [
            {
              "name": "Local",
              "args": []
            },
            {
              "name": "Remote",
              "tags": [
                "radio"
              ],
              "args": []
            },
            {
              "name": "Seen",
              "args": [
                {
                  "name": "value",
                  "value": {
                    "type": ":integer",
                    "value": "1"
                  }
                }
              ]
            },
            {
              "name": "ShouldNotRun",
              "args": []
            }
          ],
          "expectedOutboundPublished": [
            {
              "name": "Remote",
              "tags": [
                "radio"
              ],
              "args": []
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "branch can publish outbound and continue with local emit",
      "script": "module BinaryRunnerBranch\n\non Start(value) {\n  if value > 10 {\n    publish High(value: value)\n  }\n  emit Done(value: value)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": [
              {
                "name": "value",
                "value": {
                  "type": ":integer",
                  "value": "12"
                }
              }
            ]
          },
          "expectedPublished": [
            {
              "name": "High",
              "args": [
                {
                  "name": "value",
                  "value": {
                    "type": ":integer",
                    "value": "12"
                  }
                }
              ]
            },
            {
              "name": "Done",
              "args": [
                {
                  "name": "value",
                  "value": {
                    "type": ":integer",
                    "value": "12"
                  }
                }
              ]
            }
          ],
          "expectedOutboundPublished": [
            {
              "name": "High",
              "args": [
                {
                  "name": "value",
                  "value": {
                    "type": ":integer",
                    "value": "12"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "emit tags match handler filters",
      "script": "on Start {\n  let group be [#radio, #command, #radio]\n  emit Signal(value: 1) with group\n  emit Signal(value: 2) with #radio, #blocked\n  emit Signal(value: 3)\n}\n\non Signal(value) matching #radio, #command {\n  emit Seen(value: value)\n}\n\non Signal(value) matching #radio without #blocked {\n  emit Seen(value: value + 10)\n}\n\non Signal(value) without #radio {\n  emit Seen(value: value + 100)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": []
          },
          "expectedPublished": [
            {
              "name": "Signal",
              "tags": [
                "radio",
                "command"
              ],
              "args": [
                {
                  "name": "value",
                  "value": {
                    "type": ":integer",
                    "value": "1"
                  }
                }
              ]
            },
            {
              "name": "Signal",
              "tags": [
                "radio",
                "blocked"
              ],
              "args": [
                {
                  "name": "value",
                  "value": {
                    "type": ":integer",
                    "value": "2"
                  }
                }
              ]
            },
            {
              "name": "Signal",
              "args": [
                {
                  "name": "value",
                  "value": {
                    "type": ":integer",
                    "value": "3"
                  }
                }
              ]
            },
            {
              "name": "Seen",
              "args": [
                {
                  "name": "value",
                  "value": {
                    "type": ":integer",
                    "value": "1"
                  }
                }
              ]
            },
            {
              "name": "Seen",
              "args": [
                {
                  "name": "value",
                  "value": {
                    "type": ":integer",
                    "value": "11"
                  }
                }
              ]
            },
            {
              "name": "Seen",
              "args": [
                {
                  "name": "value",
                  "value": {
                    "type": ":integer",
                    "value": "103"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "undeliverable endpoint receives unknown tagged messages",
      "script": "on Start {\n  emit Unknown(value: 7) with #radio, #encrypted\n  emit Silent(value: 1) with #silent\n}\n\non undeliverable as message matching #radio {\n  emit Heard(name: message.name, signature: message.signature, value: message.arguments.value, tagCount: message.tags[:count], firstTag: message.tags[1], secondTag: message.tags[2], isMessage: message is :message)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": []
          },
          "expectedPublished": [
            {
              "name": "Unknown",
              "tags": [
                "radio",
                "encrypted"
              ],
              "args": [
                {
                  "name": "value",
                  "value": {
                    "type": ":integer",
                    "value": "7"
                  }
                }
              ]
            },
            {
              "name": "Silent",
              "tags": [
                "silent"
              ],
              "args": [
                {
                  "name": "value",
                  "value": {
                    "type": ":integer",
                    "value": "1"
                  }
                }
              ]
            },
            {
              "name": "Heard",
              "args": [
                {
                  "name": "name",
                  "value": {
                    "type": ":text",
                    "value": "Unknown"
                  }
                },
                {
                  "name": "signature",
                  "value": {
                    "type": ":text",
                    "value": "Unknown(value)"
                  }
                },
                {
                  "name": "value",
                  "value": {
                    "type": ":integer",
                    "value": "7"
                  }
                },
                {
                  "name": "tagCount",
                  "value": {
                    "type": ":integer",
                    "value": "2"
                  }
                },
                {
                  "name": "firstTag",
                  "value": {
                    "type": ":tag",
                    "value": "radio"
                  }
                },
                {
                  "name": "secondTag",
                  "value": {
                    "type": ":tag",
                    "value": "encrypted"
                  }
                },
                {
                  "name": "isMessage",
                  "value": {
                    "type": ":boolean",
                    "value": true
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "normal delivery suppresses undeliverable endpoint",
      "script": "on Start {\n  emit Known(value: 3) with #radio\n}\n\non Known(value) matching #radio {\n  emit Normal(value: value)\n}\n\non undeliverable as message matching #radio {\n  emit Unexpected(name: message.name)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": []
          },
          "expectedPublished": [
            {
              "name": "Known",
              "tags": [
                "radio"
              ],
              "args": [
                {
                  "name": "value",
                  "value": {
                    "type": ":integer",
                    "value": "3"
                  }
                }
              ]
            },
            {
              "name": "Normal",
              "args": [
                {
                  "name": "value",
                  "value": {
                    "type": ":integer",
                    "value": "3"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "message-name handler receives matching names with original message",
      "script": "on Start {\n  emit Damage(amount: 3) with #radio, #enemy\n  emit Damage(amount: 5, kind: 'fire') with #radio\n  emit Damage(amount: 7) with #silent\n}\n\non Damage as message matching #radio {\n  emit Heard(signature: message.signature, amount: message.arguments.amount, tagCount: message.tags[:count], firstTag: message.tags[1], isMessage: message is :message)\n}\n\non undeliverable as message matching #silent {\n  emit Missed(signature: message.signature, amount: message.arguments.amount, tag: message.tags[1])\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": []
          },
          "expectedPublished": [
            {
              "name": "Damage",
              "tags": [
                "radio",
                "enemy"
              ],
              "args": [
                {
                  "name": "amount",
                  "value": {
                    "type": ":integer",
                    "value": "3"
                  }
                }
              ]
            },
            {
              "name": "Damage",
              "tags": [
                "radio"
              ],
              "args": [
                {
                  "name": "amount",
                  "value": {
                    "type": ":integer",
                    "value": "5"
                  }
                },
                {
                  "name": "kind",
                  "value": {
                    "type": ":text",
                    "value": "fire"
                  }
                }
              ]
            },
            {
              "name": "Damage",
              "tags": [
                "silent"
              ],
              "args": [
                {
                  "name": "amount",
                  "value": {
                    "type": ":integer",
                    "value": "7"
                  }
                }
              ]
            },
            {
              "name": "Heard",
              "args": [
                {
                  "name": "signature",
                  "value": {
                    "type": ":text",
                    "value": "Damage(amount)"
                  }
                },
                {
                  "name": "amount",
                  "value": {
                    "type": ":integer",
                    "value": "3"
                  }
                },
                {
                  "name": "tagCount",
                  "value": {
                    "type": ":integer",
                    "value": "2"
                  }
                },
                {
                  "name": "firstTag",
                  "value": {
                    "type": ":tag",
                    "value": "radio"
                  }
                },
                {
                  "name": "isMessage",
                  "value": {
                    "type": ":boolean",
                    "value": true
                  }
                }
              ]
            },
            {
              "name": "Heard",
              "args": [
                {
                  "name": "signature",
                  "value": {
                    "type": ":text",
                    "value": "Damage(amount,kind)"
                  }
                },
                {
                  "name": "amount",
                  "value": {
                    "type": ":integer",
                    "value": "5"
                  }
                },
                {
                  "name": "tagCount",
                  "value": {
                    "type": ":integer",
                    "value": "1"
                  }
                },
                {
                  "name": "firstTag",
                  "value": {
                    "type": ":tag",
                    "value": "radio"
                  }
                },
                {
                  "name": "isMessage",
                  "value": {
                    "type": ":boolean",
                    "value": true
                  }
                }
              ]
            },
            {
              "name": "Missed",
              "args": [
                {
                  "name": "signature",
                  "value": {
                    "type": ":text",
                    "value": "Damage(amount)"
                  }
                },
                {
                  "name": "amount",
                  "value": {
                    "type": ":integer",
                    "value": "7"
                  }
                },
                {
                  "name": "tag",
                  "value": {
                    "type": ":tag",
                    "value": "silent"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "exact and message-name handlers share dispatch order",
      "script": "on Start {\n  emit Damage(amount: 9) with #radio\n}\n\non Damage(amount) matching #radio {\n  emit Exact(amount: amount)\n}\n\non Damage as message matching #radio {\n  emit Any(signature: message.signature)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": []
          },
          "expectedPublished": [
            {
              "name": "Damage",
              "tags": [
                "radio"
              ],
              "args": [
                {
                  "name": "amount",
                  "value": {
                    "type": ":integer",
                    "value": "9"
                  }
                }
              ]
            },
            {
              "name": "Exact",
              "args": [
                {
                  "name": "amount",
                  "value": {
                    "type": ":integer",
                    "value": "9"
                  }
                }
              ]
            },
            {
              "name": "Any",
              "args": [
                {
                  "name": "signature",
                  "value": {
                    "type": ":text",
                    "value": "Damage(amount)"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
