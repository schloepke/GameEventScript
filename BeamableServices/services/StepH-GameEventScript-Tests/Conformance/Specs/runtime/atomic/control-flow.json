{
  "version": 1,
  "name": "RuntimeAtomicControlFlow",
  "level": "atomic",
  "tests": [
    {
      "kind": "scriptApi",
      "name": "if branches use true only conditions",
      "script": "module AtomicControlIfBranches\non Start {\n  if true {\n    emit Branch(name: 'true-then')\n  } else {\n    emit Branch(name: 'true-else')\n  }\n\n  if false {\n    emit Branch(name: 'false-then')\n  } else {\n    emit Branch(name: 'false-else')\n  }\n\n  if nothing {\n    emit Branch(name: 'missing-then')\n  } else {\n    emit Branch(name: 'missing-else')\n  }\n\n  emit Done\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": []
          },
          "expectedPublished": [
            {
              "name": "Branch",
              "args": [
                {
                  "name": "name",
                  "value": {
                    "type": ":text",
                    "value": "true-then"
                  }
                }
              ]
            },
            {
              "name": "Branch",
              "args": [
                {
                  "name": "name",
                  "value": {
                    "type": ":text",
                    "value": "false-else"
                  }
                }
              ]
            },
            {
              "name": "Branch",
              "args": [
                {
                  "name": "name",
                  "value": {
                    "type": ":text",
                    "value": "missing-else"
                  }
                }
              ]
            },
            {
              "name": "Done",
              "args": []
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "or short circuits only on true",
      "script": "module AtomicControlOrShortCircuit\non Start {\n  let trueSkips be true or :test.fail()\n  let falseEvaluates be false or :test.truth()\n  let missingResolves be nothing or true\n  let missingStaysUnknown be nothing or false\n  emit Done(trueSkips: trueSkips, falseEvaluates: falseEvaluates, missingResolves: missingResolves, missingStaysUnknown: missingStaysUnknown)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": []
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": [
                {
                  "name": "trueSkips",
                  "value": {
                    "type": ":boolean",
                    "value": true
                  }
                },
                {
                  "name": "falseEvaluates",
                  "value": {
                    "type": ":boolean",
                    "value": true
                  }
                },
                {
                  "name": "missingResolves",
                  "value": {
                    "type": ":boolean",
                    "value": true
                  }
                },
                {
                  "name": "missingStaysUnknown",
                  "value": {
                    "type": ":nothing"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "and short circuits only on false",
      "script": "module AtomicControlAndShortCircuit\non Start {\n  let falseSkips be false and :test.fail()\n  let trueEvaluates be true and :test.truth()\n  let missingResolvesFalse be nothing and false\n  let missingStaysUnknown be nothing and true\n  emit Done(falseSkips: falseSkips, trueEvaluates: trueEvaluates, missingResolvesFalse: missingResolvesFalse, missingStaysUnknown: missingStaysUnknown)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": []
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": [
                {
                  "name": "falseSkips",
                  "value": {
                    "type": ":boolean",
                    "value": false
                  }
                },
                {
                  "name": "trueEvaluates",
                  "value": {
                    "type": ":boolean",
                    "value": true
                  }
                },
                {
                  "name": "missingResolvesFalse",
                  "value": {
                    "type": ":boolean",
                    "value": false
                  }
                },
                {
                  "name": "missingStaysUnknown",
                  "value": {
                    "type": ":nothing"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "implication short circuits false antecedent",
      "script": "module AtomicControlImplication\non Start {\n  let falseSkips be false -> :test.fail()\n  let trueEvaluates be true -> true\n  let trueFails be true -> false\n  let missingResolvesTrue be nothing -> true\n  let missingStaysUnknown be nothing -> false\n  emit Done(falseSkips: falseSkips, trueEvaluates: trueEvaluates, trueFails: trueFails, missingResolvesTrue: missingResolvesTrue, missingStaysUnknown: missingStaysUnknown)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": []
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": [
                {
                  "name": "falseSkips",
                  "value": {
                    "type": ":boolean",
                    "value": true
                  }
                },
                {
                  "name": "trueEvaluates",
                  "value": {
                    "type": ":boolean",
                    "value": true
                  }
                },
                {
                  "name": "trueFails",
                  "value": {
                    "type": ":boolean",
                    "value": false
                  }
                },
                {
                  "name": "missingResolvesTrue",
                  "value": {
                    "type": ":boolean",
                    "value": true
                  }
                },
                {
                  "name": "missingStaysUnknown",
                  "value": {
                    "type": ":nothing"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "guarded choice selects first true branch",
      "script": "module AtomicControlGuardedChoice\non Start {\n  let firstTrue as :number be 10 when false, or 20 when true, or 30 when true, otherwise 40\n  let otherwiseValue as :number be 10 when false, or 20 when nothing, otherwise 40\n  emit Done(firstTrue: firstTrue, otherwiseValue: otherwiseValue)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": []
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": [
                {
                  "name": "firstTrue",
                  "value": {
                    "type": ":integer",
                    "value": "20"
                  }
                },
                {
                  "name": "otherwiseValue",
                  "value": {
                    "type": ":integer",
                    "value": "40"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "for loops iterate lists ranges and text",
      "script": "module AtomicControlForIteration\non Start {\n  for item in [1, 2] {\n    emit Item(kind: 'list', value: item)\n  }\n\n  for item from 1 to 3 step 2 {\n    emit Item(kind: 'range', value: item)\n  }\n\n  for item in 'ab' {\n    emit Item(kind: 'text', value: item)\n  }\n\n  emit Done\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": []
          },
          "expectedPublished": [
            {
              "name": "Item",
              "args": [
                {
                  "name": "kind",
                  "value": {
                    "type": ":text",
                    "value": "list"
                  }
                },
                {
                  "name": "value",
                  "value": {
                    "type": ":integer",
                    "value": "1"
                  }
                }
              ]
            },
            {
              "name": "Item",
              "args": [
                {
                  "name": "kind",
                  "value": {
                    "type": ":text",
                    "value": "list"
                  }
                },
                {
                  "name": "value",
                  "value": {
                    "type": ":integer",
                    "value": "2"
                  }
                }
              ]
            },
            {
              "name": "Item",
              "args": [
                {
                  "name": "kind",
                  "value": {
                    "type": ":text",
                    "value": "range"
                  }
                },
                {
                  "name": "value",
                  "value": {
                    "type": ":integer",
                    "value": "1"
                  }
                }
              ]
            },
            {
              "name": "Item",
              "args": [
                {
                  "name": "kind",
                  "value": {
                    "type": ":text",
                    "value": "range"
                  }
                },
                {
                  "name": "value",
                  "value": {
                    "type": ":integer",
                    "value": "3"
                  }
                }
              ]
            },
            {
              "name": "Item",
              "args": [
                {
                  "name": "kind",
                  "value": {
                    "type": ":text",
                    "value": "text"
                  }
                },
                {
                  "name": "value",
                  "value": {
                    "type": ":text",
                    "value": "a"
                  }
                }
              ]
            },
            {
              "name": "Item",
              "args": [
                {
                  "name": "kind",
                  "value": {
                    "type": ":text",
                    "value": "text"
                  }
                },
                {
                  "name": "value",
                  "value": {
                    "type": ":text",
                    "value": "b"
                  }
                }
              ]
            },
            {
              "name": "Done",
              "args": []
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "for loops skip empty and non iterable sources",
      "script": "module AtomicControlForEmptySources\non Start {\n  for item in [] {\n    emit Item(kind: 'empty-list', value: item)\n  }\n\n  for item in '' {\n    emit Item(kind: 'empty-text', value: item)\n  }\n\n  for item in nothing {\n    emit Item(kind: 'missing', value: item)\n  }\n\n  for item in 123 {\n    emit Item(kind: 'number', value: item)\n  }\n\n  emit Done\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": []
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": []
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "function and predicate calls return values",
      "script": "module AtomicControlReturns\nfunction addOne(_ value) be value + 1\npredicate isLarge(_ value) be value > 2\n\non Start {\n  let a be addOne(2)\n  if isLarge(a) {\n    emit Done(value: a, matched: true)\n  } else {\n    emit Done(value: a, matched: false)\n  }\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": []
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": [
                {
                  "name": "value",
                  "value": {
                    "type": ":integer",
                    "value": "3"
                  }
                },
                {
                  "name": "matched",
                  "value": {
                    "type": ":boolean",
                    "value": true
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "seeded random statement restores outer flow",
      "script": "module AtomicControlSeededRandom\non Start(seed as :number) {\n  random with seed {\n    let inner be random from 1 to 6\n    emit Roll(scope: 'inner', value: inner)\n  }\n\n  emit Done(after: true)\n}",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": [
              {
                "name": "seed",
                "value": {
                  "type": ":integer",
                  "value": "7"
                }
              }
            ]
          },
          "expectedPublished": [
            {
              "name": "Roll",
              "args": [
                {
                  "name": "scope",
                  "value": {
                    "type": ":text",
                    "value": "inner"
                  }
                },
                {
                  "name": "value",
                  "value": {
                    "type": ":integer",
                    "value": "1"
                  }
                }
              ]
            },
            {
              "name": "Done",
              "args": [
                {
                  "name": "after",
                  "value": {
                    "type": ":boolean",
                    "value": true
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
