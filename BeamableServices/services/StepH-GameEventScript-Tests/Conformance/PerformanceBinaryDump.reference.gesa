// -------------------------------------------------------------------------------
//  Performance Case: PerformanceCore/math integer hot path
// -------------------------------------------------------------------------------

// -------------------------------------------------------------------------------
//  Module: PerformanceMath
//  Type: Game Event Script Assembler
//  Format version: 1.0
//
//  Disassembled at <stable>
// -------------------------------------------------------------------------------
// Script:
//
//		module PerformanceMath
//		
//		on Start(value) {
//		  let a be value + 5
//		  let b be a * 3
//		  let c be b - 7
//		  let d be c div 2
//		  let e be d * d
//		  let f be e mod 97
//		  let g be f + 10
//		  let h be g * 2
//		  let i be h - 15
//		  let j be i div 5
//		  emit Done(result: j)
//		}
//		
//
// -------------------------------------------------------------------------------

