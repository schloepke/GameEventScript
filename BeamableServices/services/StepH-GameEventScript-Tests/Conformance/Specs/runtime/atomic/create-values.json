      "steps": [
        {
          "input": {
            "name": "Start",
            "args": {}
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": {
                "descendingRange": {
                  "type": ":list",
                  "items": [
                    {
                      "type": ":integer",
                      "value": "5"
                    },
                    {
