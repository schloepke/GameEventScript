on Awake() {
    emit ButtonCount(20);
}

on Enable(x) {
    if x == 10 emit PlayerHealth(20);
    if x == 20 emit PlayerHealth(10);
}

on Disable() {
    select {
        x: 20 | emit PlayerHealth(20)
        x: 10 | emit PlayerHealth(22)
        x: | emit PlayerHealth(22)
    }
}

on Message(x) select x == 10 {
    emit PlayerHealth(20);
}

on Message(x) select x < 100 and x > 10 {
    error 'No way out here';
}

on Message(x in range[10..200]) select x < 100 and x > 10 {
    error 'No way out here';
}

on PlayerPressedButton(x, y) {
    let score = 20 * x;

    if(currentButten == pressedButton) {
        emit AddScore(1);
        emit NextStep();
    } else {
        emit ShowErrorPadWithTimePenalty(100ms);
        emit AddError(1);
        emit NextStep();
    }
}