{
  "version": 1,
  "name": "CompileBinaryCompiler",
  "tests": [
    {
      "kind": "compileMetadata",
      "name": "handler and program resource requirements include nested calls",
      "script": "module BinaryCompilerResources\n\nfunction leaf(value) be value + 1\n\nfunction middle(value) be leaf(value: value)\n\non Start(value) {\n  let result be middle(value: value)\n  emit Done(result: result)\n}\n\non Ping(value) {\n  emit Pong(value: value)\n}\n",
      "expectedProgramResources": {
        "requiredRegisterCount": 7,
        "requiredCallStackDepth": 2
      },
      "expectedHandlerResources": [
        {
          "name": "Start",
          "requiredRegisterCount": 7,
          "requiredCallStackDepth": 2
        },
        {
          "name": "Ping",
          "requiredRegisterCount": 1,
          "requiredCallStackDepth": 0
        }
      ]
    },
    {
      "kind": "loadError",
      "name": "host rejects program whose call depth exceeds its limit",
      "script": "module BinaryCompilerCallDepthLimit\n\nfunction leaf(value) be value + 1\n\nfunction middle(value) be leaf(value: value)\n\non Start(value) {\n  let result be middle(value: value)\n  emit Done(result: result)\n}\n",
      "runtimeLimits": {
        "maxCallDepth": 1
      },
      "expectedError": {
        "messageContains": "requires call-stack depth 2 but the host limit is 1"
      }
    },
    {
      "kind": "loadError",
      "name": "host rejects program whose register requirement exceeds its limit",
      "script": "module BinaryCompilerRegisterLimit\n\nfunction leaf(value) be value + 1\n\nfunction middle(value) be leaf(value: value)\n\non Start(value) {\n  let result be middle(value: value)\n  emit Done(result: result)\n}\n",
      "runtimeLimits": {
        "maxRegisterValues": 6
      },
      "expectedError": {
        "messageContains": "requires 7 registers but the host limit is 6"
      }
    },
    {
      "kind": "scriptApi",
      "name": "simple handler compiles to runnable binary",
      "script": "module BinaryCompilerSmoke\n\non Start(value) {\n  let doubled be value * 2\n  emit Done(result: doubled, text: 'ok')\n}\n",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": [
              {
                "name": "value",
                "value": {
                  "type": ":integer",
                  "value": "6"
                }
              }
            ]
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": [
                {
                  "name": "result",
                  "value": {
                    "type": ":integer",
                    "value": "12"
                  }
                },
                {
                  "name": "text",
                  "value": {
                    "type": ":text",
                    "value": "ok"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "function call and branch compile to runnable binary",
      "script": "module BinaryCompilerFunction\n\nfunction double(value) be value * 2\n\non Start(value) {\n  let result be double(value: value)\n  if result > 10 {\n    emit Done(result: result, status: #high)\n  } else {\n    emit Done(result: result, status: #low)\n  }\n}\n",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": [
              {
                "name": "value",
                "value": {
                  "type": ":integer",
                  "value": "7"
                }
              }
            ]
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": [
                {
                  "name": "result",
                  "value": {
                    "type": ":integer",
                    "value": "14"
                  }
                },
                {
                  "name": "status",
                  "value": {
                    "type": ":tag",
                    "value": "high"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "scriptApi",
      "name": "record constructor compiles to runnable binary",
      "script": "module BinaryCompilerRecord\n\nrecord :gauge as {\n  current: :number clamped between 0 and maximum,\n  maximum: :number clamped between 0 and infinity,\n  percentage: :percentage computed by\n    0% when maximum <= 0,\n    otherwise (current / maximum) as :percentage\n}\n\non Start {\n  let hp be :gauge(current: 125, maximum: 100)\n  emit Done(current: hp.current, maximum: hp.maximum, percentage: hp.percentage, isGauge: hp is :gauge)\n}\n",
      "steps": [
        {
          "input": {
            "name": "Start",
            "args": []
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": [
                {
                  "name": "current",
                  "value": {
                    "type": ":integer",
                    "value": "100"
                  }
                },
                {
                  "name": "maximum",
                  "value": {
                    "type": ":integer",
                    "value": "100"
                  }
                },
                {
                  "name": "percentage",
                  "value": {
                    "type": ":percentage",
                    "value": "0.01"
                  }
                },
                {
                  "name": "isGauge",
                  "value": {
                    "type": ":boolean",
                    "value": true
                  }
                }
              ]
            }
          ]
        }
      ]
    },
