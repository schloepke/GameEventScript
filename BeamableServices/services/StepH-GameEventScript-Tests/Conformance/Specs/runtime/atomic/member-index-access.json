    {
      "kind": "scriptApi",
      "name": "map member and index access",
      "script": "module AtomicMapAccess\non Start {\n  let value be [name: 'Ada', hp: 10]\n  let key be 'name'\n  emit Done(memberName: value.name, memberMissing: value.missing, indexText: value['name'], indexTag: value[:hp], dynamicText: value[key], indexMissing: value[:missing], indexOut: value[1])\n}",
      "steps": [
        {
          "input": { "name": "Start", "args": {} },
          "expectedPublished": [
            {
              "name": "Done",
