{
  "version": 1,
  "name": "RuntimeCollections",
  "tests": [
    {
      "kind": "scriptApi",
      "name": "collections project filter aggregate and choose edges",
      "script": "on Compute(items) {\n  let names be items[:select item => item.name]\n  let positive be items[:filter item where item.points > 0]\n  let total be items[:sum item => item.points]\n  let positiveCount be items[:count item where item.points > 0]\n  let averagePoints be items[:average item => item.points]\n  let highestItem be items[:highest item => item.points]\n  let lowestItem be items[:lowest item => item.points]\n  emit Done(nameCount: names[:count], positiveCount: positive[:count], total: total, counted: positiveCount, average: averagePoints, highest: highestItem.name, lowest: lowestItem.name)\n}",
      "steps": [
        {
          "input": {
            "name": "Compute",
            "args": [
              {
                "name": "items",
                "value": {
                  "type": ":list",
                  "items": [
                    {
                      "type": ":map",
                      "entries": {
                        "name": {
                          "type": ":text",
                          "value": "a"
                        },
                        "points": {
                          "type": ":integer",
                          "value": "3"
                        }
                      }
                    },
                    {
                      "type": ":map",
                      "entries": {
                        "name": {
                          "type": ":text",
                          "value": "b"
                        },
                        "points": {
                          "type": ":integer",
                          "value": "-1"
                        }
                      }
                    },
                    {
                      "type": ":map",
                      "entries": {
                        "name": {
                          "type": ":text",
                          "value": "c"
                        },
                        "points": {
                          "type": ":integer",
                          "value": "4"
                        }
                      }
                    }
                  ]
                }
              }
            ]
          },
          "expectedPublished": [
            {
              "name": "Done",
              "args": [
                {
                  "name": "nameCount",
                  "value": {
                    "type": ":integer",
                    "value": "3"
                  }
                },
                {
                  "name": "positiveCount",
                  "value": {
                    "type": ":integer",
                    "value": "2"
                  }
                },
                {
                  "name": "total",
                  "value": {
                    "type": ":integer",
                    "value": "6"
                  }
                },
                {
                  "name": "counted",
                  "value": {
                    "type": ":integer",
                    "value": "2"
                  }
                },
                {
                  "name": "average",
                  "value": {
                    "type": ":integer",
                    "value": "2"
                  }
                },
                {
                  "name": "highest",
                  "value": {
                    "type": ":text",
                    "value": "c"
                  }
                },
                {
                  "name": "lowest",
                  "value": {
                    "type": ":text",
                    "value": "b"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
